---
/**
 * ResourcesTeaser — home preview of the open resources directory (/resources).
 *
 * Design: her `.section-resources-preview` (fcacfc4 index.html L345–358,
 * css/style.css L1587–1624 + responsive rules): a left-aligned heading row
 * with a quiet "full directory →" link (her `.section-head` + `.section-link`,
 * through SectionHeading `linkLabel`), the description, four figures between
 * hairlines (4 / 2 / 1 columns at ≥1025 / 481–1024 / ≤480px) and two pill
 * actions: the directory (primary) and AISafety.com (outline, external).
 *
 * Data: the figures come from `totales` (src/lib/recursos.ts) at build time —
 * the same four counts her js/recursos-preview.js computed in the browser — so
 * they never drift from the catalogue and the section ships no client JS.
 *
 * Copy: UI strings live in the ES/EN table below (same pattern as
 * ResourceDirectory), not in src/lib/i18n.ts.
 *
 * Props:
 *  - lang?: 'es' | 'en' (default 'es').
 */
import SectionHeading from './SectionHeading.astro';
import { totales } from '../lib/recursos';
import { localizedPath } from '../lib/i18n';
import type { Locale } from '../lib/i18n';

export interface Props {
  lang?: Locale;
}

const { lang = 'es' } = Astro.props;

const copy = {
  es: {
    eyebrow: 'Directorio abierto',
    title: 'Recursos abiertos',
    description:
      'Mantenemos un directorio curado de cursos, programas de investigación, fellowships de política, financiamiento y comunidades, con los enlaces verificados uno por uno. Está pensado para quien quiera empezar o dar el siguiente paso desde México y América Latina.',
    fullDirectory: 'Ver el directorio completo →',
    stats: [
      'recursos verificados',
      'cursos y currículos',
      'programas y fellowships',
      'relevantes para América Latina',
    ],
    explore: 'Explorar recursos',
  },
  en: {
    eyebrow: 'Open directory',
    title: 'Open resources',
    description:
      'We maintain a curated directory of courses, research programs, policy fellowships, funding, and communities, with every link verified one by one. It is meant for anyone who wants to get started — or take the next step — from Mexico and Latin America.',
    fullDirectory: 'See the full directory →',
    stats: [
      'verified resources',
      'courses and curricula',
      'programs and fellowships',
      'relevant to Latin America',
    ],
    explore: 'Explore resources',
  },
}[lang];

const directoryHref = localizedPath(lang, '/resources');
const figures = [totales.recursos, totales.cursos, totales.programas, totales.latam];
---

<section class="section section--base" aria-labelledby="home-recursos">
  <div class="container">
    <SectionHeading
      eyebrow={copy.eyebrow}
      title={copy.title}
      description={copy.description}
      linkLabel={copy.fullDirectory}
      linkHref={directoryHref}
      id="home-recursos"
    />

    <ul class="resources-teaser__grid" role="list">
      {figures.map((n, i) => (
        <li class="resources-teaser__item">
          <span class="resources-teaser__count">{n}</span> <span class="resources-teaser__label">{copy.stats[i]}</span>
        </li>
      ))}
    </ul>

    <div class="resources-teaser__actions">
      <a class="btn btn-primary" href={directoryHref}>{copy.explore}</a>
      <a class="btn btn-outline" href="https://aisafety.com" target="_blank" rel="noopener noreferrer">
        AISafety.com <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  /* Her .resource-preview-grid: figures framed by hairlines, no card boxes.
     Mobile-first: 1 column (≤480), 2 (481–1024), 4 (≥1025). */
  .resources-teaser__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0 0 26px;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .resources-teaser__item {
    padding: 20px 22px;
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 481px) {
    .resources-teaser__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .resources-teaser__item:nth-child(odd) {
      border-right: 1px solid var(--color-border);
    }
  }

  @media (min-width: 1025px) {
    .resources-teaser__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .resources-teaser__item:not(:nth-child(4n)) {
      border-right: 1px solid var(--color-border);
    }
  }

  /* Her .resource-preview-count: Inter 500, 1.5rem, tight tracking, ink. */
  .resources-teaser__count {
    display: block;
    font-size: 1.5rem;
    font-weight: var(--fw-display);
    line-height: 1.1;
    letter-spacing: var(--ls-display);
    color: var(--color-text-primary);
  }

  /* Her .resource-preview-label, in the AA-safe muted grey. */
  .resources-teaser__label {
    display: block;
    margin-top: 4px;
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  /* Her .resource-preview-actions: primary + outline pills, 26px under the
     figures (the grid's bottom margin). */
  .resources-teaser__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-actions);
  }
</style>
