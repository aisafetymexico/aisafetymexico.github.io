---
/**
 * Tabs — accessible tab interface (WAI-ARIA Authoring Practices, "Tabs").
 *
 * Spec:
 *  - docs/DESIGN-SYSTEM.md §6.5 (interactive components, vanilla JS only).
 *  - Design: her bracketed-nav idiom — `[ Tab ]` brackets
 *    fade in on hover/focus (.45) and on the active tab (.5, weight 550),
 *    over a 1px hairline. No route renders it today.
 *
 * A11y guarantees:
 *  - role="tablist" / role="tab" / role="tabpanel".
 *  - aria-selected on the active tab; tabindex -1 on inactive tabs (roving).
 *  - aria-controls / aria-labelledby pair tabs to panels.
 *  - Keyboard: ArrowLeft/ArrowRight cycle, Home/End jump, automatic activation.
 *  - Inactive panels are `hidden`.
 *  - Focus ring respects `:focus-visible`.
 *
 * Usage:
 *   <Tabs tabs={[{ id: 'a', label: 'Tab A' }, { id: 'b', label: 'Tab B' }]}>
 *     <Fragment slot="a">Content A</Fragment>
 *     <Fragment slot="b">Content B</Fragment>
 *   </Tabs>
 *
 * Props:
 *  - tabs: Array<{ id: string, label: string }>
 *  - label?: string (aria-label for the tablist)
 *  - id?: string
 */
export interface Props {
  tabs: Array<{ id: string; label: string }>;
  label?: string;
  id?: string;
}

const { tabs, label = 'Pestañas', id } = Astro.props;
const rootId = id || `tabs-${Math.random().toString(36).slice(2, 9)}`;
---

{tabs.length > 0 && (
  <div class="tabs" id={rootId} data-tabs>
    <div class="tabs__list" role="tablist" aria-label={label}>
      {tabs.map((tab, idx) => (
        <button
          type="button"
          role="tab"
          id={`${rootId}-tab-${tab.id}`}
          class:list={['tabs__tab', { 'is-active': idx === 0 }]}
          aria-selected={idx === 0 ? 'true' : 'false'}
          aria-controls={`${rootId}-panel-${tab.id}`}
          tabindex={idx === 0 ? 0 : -1}
          data-tab-id={tab.id}
        >
          {tab.label}
        </button>
      ))}
    </div>

    <div class="tabs__panels">
      {tabs.map((tab, idx) => (
        <div
          role="tabpanel"
          id={`${rootId}-panel-${tab.id}`}
          class="tabs__panel"
          aria-labelledby={`${rootId}-tab-${tab.id}`}
          tabindex="0"
          data-panel-id={tab.id}
          hidden={idx !== 0}
        >
          <slot name={tab.id} />
        </div>
      ))}
    </div>
  </div>
)}

<script>
  (() => {
    const ATTR = 'data-tabs-bound';

    const init = (root: HTMLElement) => {
      if (root.getAttribute(ATTR) === '1') return;
      root.setAttribute(ATTR, '1');

      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
      if (tabs.length === 0 || panels.length === 0) return;

      const activate = (idx: number, focus = true) => {
        const n = ((idx % tabs.length) + tabs.length) % tabs.length;
        tabs.forEach((tab, i) => {
          const active = i === n;
          tab.classList.toggle('is-active', active);
          tab.setAttribute('aria-selected', active ? 'true' : 'false');
          tab.setAttribute('tabindex', active ? '0' : '-1');
          if (active && focus) tab.focus();
        });
        const activeId = tabs[n].getAttribute('data-tab-id');
        panels.forEach((panel) => {
          const match = panel.getAttribute('data-panel-id') === activeId;
          panel.hidden = !match;
        });
      };

      tabs.forEach((tab, idx) => {
        tab.addEventListener('click', () => activate(idx, false));
        tab.addEventListener('keydown', (e: KeyboardEvent) => {
          switch (e.key) {
            case 'ArrowRight':
              e.preventDefault();
              activate(idx + 1);
              break;
            case 'ArrowLeft':
              e.preventDefault();
              activate(idx - 1);
              break;
            case 'Home':
              e.preventDefault();
              activate(0);
              break;
            case 'End':
              e.preventDefault();
              activate(tabs.length - 1);
              break;
          }
        });
      });
    };

    const bootstrap = () => {
      document.querySelectorAll<HTMLElement>('[data-tabs]').forEach(init);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bootstrap);
    } else {
      bootstrap();
    }
  })();
</script>

<style>
  /* Her bracketed-nav idiom applied to tabs: plain ink-2
     labels; hover/focus and the active tab turn ink and show faint square
     brackets. The list sits on a 1px hairline, with no coloured underline
     and no fills. */
  .tabs {
    width: 100%;
  }

  .tabs__list {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-6);
  }

  .tabs__tab {
    appearance: none;
    background: transparent;
    border: none;
    border-radius: var(--radius);
    padding: 8px 12px;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: var(--fw-book);
    line-height: var(--lh-normal);
    color: var(--color-text-secondary);
    white-space: nowrap;
    cursor: pointer;
    transition: color var(--transition);
  }

  /* The brackets always reserve their width (opacity 0), so nothing shifts
     on hover. `content: '[' / ''` gives them empty alt text. */
  .tabs__tab::before {
    content: '[';
    content: '[' / '';
    margin-right: 1px;
    opacity: 0;
    transition: opacity var(--transition);
  }
  .tabs__tab::after {
    content: ']';
    content: ']' / '';
    margin-left: 1px;
    opacity: 0;
    transition: opacity var(--transition);
  }

  .tabs__tab:hover,
  .tabs__tab:focus-visible {
    color: var(--color-text-primary);
  }
  .tabs__tab:hover::before,
  .tabs__tab:hover::after,
  .tabs__tab:focus-visible::before,
  .tabs__tab:focus-visible::after {
    opacity: 0.45;
  }
  .tabs__tab:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  .tabs__tab.is-active {
    color: var(--color-text-primary);
    font-weight: var(--fw-heading);
  }
  .tabs__tab.is-active::before,
  .tabs__tab.is-active::after {
    opacity: 0.5;
  }

  .tabs__panel {
    color: var(--color-text-primary);
    line-height: var(--lh-relaxed);
  }
  .tabs__panel:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 4px;
    border-radius: var(--radius);
  }
  .tabs__panel[hidden] { display: none; }
</style>
