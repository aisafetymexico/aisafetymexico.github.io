---
/**
 * Hero — Home variant: her "Editorial mínimo" hero (fcacfc4 css/style.css
 * L296–424, markup fcacfc4:index.html L42–58).
 *
 * Layout: white, a centered text column (max 720px) — h1 (Inter 500,
 * -0.03em, balanced) with an optional muted trailing phrase, subtitle, up to
 * three pill CTAs and an optional scroll hint — then the full-bleed El Caracol
 * halftone band as the last child of the section.
 *
 * Banner technique (her L401–424):
 *  - The <img> is width 100% with max-width 2659px (its native width, so the
 *    dither is never upscaled), centered on a #070707 band that matches the
 *    PNG's side bars exactly; on wider screens the band simply continues.
 *  - ≤768px: aspect-ratio 1749/984 + object-fit: cover crops only the black
 *    side bars, not the photo.
 *  - The section has no bottom padding or hairline: the band closes it.
 *  - Never lossy-recompress the PNG (it is a dither).
 *
 * Props:
 *  - title:        main headline (required).
 *  - titleAccent?: a phrase of `title` (normally the trailing one) shown in
 *                  muted grey, like her `.accent` span. Must be a literal
 *                  substring of `title` (its last occurrence is used);
 *                  otherwise the title renders plain.
 *  - subtitle?:    supporting paragraph.
 *  - ctas?:        up to three pills: { label, href, variant?: 'primary' |
 *                  'outline', external? }. Without `variant`, the first is
 *                  primary (ink) and the rest outline.
 *  - scrollHint?:  small line under the CTAs, e.g. "Desplázate para explorar ↓".
 *  - banner?:      { src, alt, width?, height? } | false. Defaults to the El
 *                  Caracol band (2659×984) with a localized alt; `false`
 *                  drops it (the hero then gets her bottom padding + rule).
 *  - lang?:        'es' | 'en' (default: Astro.currentLocale, else 'es');
 *                  only used for the default banner alt.
 *  - overline?:    optional eyebrow above the title (her hero has none).
 *  - primaryCta? / secondaryCta?: DEPRECATED, still honoured when `ctas` is
 *                  not passed (mapped to a primary and an outline pill).
 *  - image?:       DEPRECATED and ignored: the colour photo above the title
 *                  was replaced by the banner.
 *
 * Example:
 *   <Hero
 *     title="Seguridad y gobernanza de la IA, desde México."
 *     titleAccent="desde México"
 *     subtitle="…"
 *     ctas={[
 *       { label: 'Cómo participar', href: '/get-involved#participa' },
 *       { label: 'Ver recursos', href: '/resources', variant: 'outline' },
 *       { label: 'Nuestros programas', href: '/programs', variant: 'outline' },
 *     ]}
 *     scrollHint="Desplázate para explorar ↓"
 *   />
 *
 * Tokens only — no literal hex values.
 */
import type { ImgRef, CtaRef } from '../lib/types';
import type { Locale } from '../lib/i18n';

export interface HeroCta {
  label: string;
  href: string;
  variant?: 'primary' | 'outline';
  external?: boolean;
}

export interface HeroBanner {
  src: string;
  alt: string;
  width?: number;
  height?: number;
}

export interface Props {
  title: string;
  titleAccent?: string;
  subtitle?: string;
  ctas?: HeroCta[];
  scrollHint?: string;
  banner?: HeroBanner | false;
  lang?: Locale;
  overline?: string;
  /** @deprecated Use `ctas`. */
  primaryCta?: Pick<CtaRef, 'label' | 'href'> & { external?: boolean };
  /** @deprecated Use `ctas`. */
  secondaryCta?: Pick<CtaRef, 'label' | 'href'> & { external?: boolean };
  /** @deprecated Ignored: the banner replaced the photo above the title. */
  image?: ImgRef;
}

const {
  title,
  titleAccent,
  subtitle,
  ctas,
  scrollHint,
  banner,
  lang = (Astro.currentLocale as Locale | undefined) ?? 'es',
  overline,
  primaryCta,
  secondaryCta,
} = Astro.props;

if (!title) throw new Error('Hero: `title` is required.');

// Title with an optional muted phrase (her `.hero-title .accent`).
let titleLead = title;
let titleAccentText = '';
let titleTail = '';
if (titleAccent) {
  const at = title.lastIndexOf(titleAccent);
  if (at >= 0) {
    titleLead = title.slice(0, at);
    titleAccentText = titleAccent;
    titleTail = title.slice(at + titleAccent.length);
  }
}

// CTAs: `ctas` wins; otherwise the legacy primary/secondary pair.
const legacyCtas: HeroCta[] = [
  ...(primaryCta ? [{ ...primaryCta, variant: 'primary' as const }] : []),
  ...(secondaryCta ? [{ ...secondaryCta, variant: 'outline' as const }] : []),
];
const resolvedCtas: HeroCta[] = (ctas ?? legacyCtas).map((cta, i) => ({
  ...cta,
  variant: cta.variant ?? (i === 0 ? 'primary' : 'outline'),
}));
for (const cta of resolvedCtas) {
  if (!cta?.href || !cta?.label) {
    throw new Error('Hero: every CTA requires `label` and `href`.');
  }
}

// The El Caracol band (default) with a localized alt.
const BANNER_ALT: Record<Locale, string> = {
  es: 'El Caracol, observatorio astronómico maya de Chichén Itzá',
  en: 'El Caracol, the Maya astronomical observatory at Chichén Itzá',
};
const resolvedBanner: HeroBanner | null =
  banner === false
    ? null
    : banner ?? {
        src: '/images/banner-caracol.png',
        alt: BANNER_ALT[lang] ?? BANNER_ALT.es,
        width: 2659,
        height: 984,
      };

const ctaRel = (cta: HeroCta) => (cta.external ? 'noopener noreferrer' : undefined);
const ctaTarget = (cta: HeroCta) => (cta.external ? '_blank' : undefined);
---

<section
  class:list={['hero', { 'hero--banner': resolvedBanner }]}
  aria-labelledby="hero-title"
>
  <div class="hero__inner">
    <div class="hero__content">
      {overline && (
        <p class="hero__overline role-eyebrow">{overline}</p>
      )}

      <h1 id="hero-title" class="hero__title">{titleLead}{titleAccentText && (
        <span class="hero__accent">{titleAccentText}</span>
      )}{titleTail}</h1>

      {subtitle && <p class="hero__subtitle">{subtitle}</p>}

      {resolvedCtas.length > 0 && (
        <div class="hero__actions">
          {resolvedCtas.map((cta) => (
            <a
              class:list={['btn', cta.variant === 'primary' ? 'btn-primary' : 'btn-outline']}
              href={cta.href}
              target={ctaTarget(cta)}
              rel={ctaRel(cta)}
            >{cta.label}</a>
          ))}
        </div>
      )}
    </div>

    {scrollHint && <p class="hero__scroll-hint">{scrollHint}</p>}
  </div>

  {resolvedBanner && (
    <div class="hero__banner">
      <img
        src={resolvedBanner.src}
        alt={resolvedBanner.alt}
        width={resolvedBanner.width}
        height={resolvedBanner.height}
        loading="eager"
        decoding="async"
      />
    </div>
  )}
</section>

<style>
  /* Padding tiers, mobile-first: her 42/40 (≤480), 52/46 (≤768),
     68/56 (≤1024), 88/72 (desktop). */
  .hero {
    background: var(--color-bg-base);
    color: var(--color-text-primary);
    padding: 42px 0 40px;
    border-bottom: 1px solid var(--color-border-soft);
  }

  @media (min-width: 481px) {
    .hero { padding: 52px 0 46px; }
  }

  @media (min-width: 769px) {
    .hero { padding: 68px 0 56px; }
  }

  @media (min-width: 1025px) {
    .hero { padding: 88px 0 72px; }
  }

  /* The banner closes the hero: no bottom padding, no rule (double class on
     purpose, so the tiers above can't put the padding back). */
  .hero.hero--banner {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: var(--container-hero);
    margin-inline: auto;
    padding-inline: var(--container-padding);
  }

  @media (min-width: 481px) {
    .hero__inner {
      padding-inline: var(--container-padding-md);
    }
  }

  .hero__content {
    width: 100%;
    max-width: var(--measure-hero);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__overline {
    margin: 0 0 16px;
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: var(--fs-display);
    font-weight: var(--fw-display);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-display);
    color: var(--color-text-heading);
    margin: 0 0 20px;
    text-wrap: balance;
  }

  /* Her second tone: grey, not a colour. #8E8E98 is large text here
     (≥24px at every width), where it passes AA-large (3.24:1). */
  .hero__accent {
    color: var(--ink-3);
    font-style: normal;
  }

  .hero__subtitle {
    font-size: 0.96rem;
    line-height: var(--lh-loose);
    color: var(--color-text-secondary);
    max-width: var(--measure-sub);
    margin: 0 0 30px;
    /* Centred copy: balance, so the last line is never a two-word runt. */
    text-wrap: balance;
  }

  @media (min-width: 769px) {
    .hero__subtitle { font-size: 1.02rem; }
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap-actions);
  }

  .hero__scroll-hint {
    margin: 30px 0 0;
    font-size: 0.76rem;
    line-height: var(--lh-relaxed);
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
  }

  @media (min-width: 769px) {
    .hero__scroll-hint { margin-top: 44px; }
  }

  /* Full-bleed band: last child of the section, outside the centered
     column, so it spans the viewport without a 100vw hack. */
  .hero__banner {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: 34px;
    background: var(--color-banner-band);
  }

  @media (min-width: 769px) {
    .hero__banner { margin-top: 44px; }
  }

  @media (min-width: 1025px) {
    .hero__banner { margin-top: 56px; }
  }

  .hero__banner img {
    display: block;
    width: 100%;
    max-width: 2659px;
    height: auto;
  }

  /* Narrow screens: 1749/984 is exactly the photo area inside the PNG, so
     `cover` crops only the black side bars. */
  @media (max-width: 768px) {
    .hero__banner img {
      aspect-ratio: 1749 / 984;
      object-fit: cover;
    }
  }
</style>
