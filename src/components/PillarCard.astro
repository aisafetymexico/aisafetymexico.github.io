---
/**
 * PillarCard — used to render the four "pilares" on the About / Home pages.
 *
 * Spec: docs/DESIGN-SYSTEM.md §6.3 (PillarCard) + docs/RAND-AESTHETIC.md §8
 * (numeral-as-anchor pattern adapted from RAND.org).
 *
 * Design: her card language (`.program-card`, fcacfc4 css/style.css
 * L1006–1050): white, 1px hairline, 8px radius, her card padding, no shadow,
 * no hover (pillars describe the organisation's work, not destinations, so
 * there is no CTA). A quiet typographic numeral (e.g. `01`, Inter 500 in
 * the decorative ink-3 grey) sits above the title.
 *
 * Props:
 *  - number:      optional 2-digit string (e.g. "01") shown as the typographic
 *                 anchor above the title. Falls back to no anchor.
 *  - title:       short pillar name (h3).
 *  - description: optional 1–2 sentence body.
 *
 * Backwards-compat: legacy callers passing `icon` (emoji) are silently
 * ignored — emoji decoration is no longer rendered (Task #26 / RAND-ify).
 */
export interface Props {
  number?: string;
  title: string;
  description?: string;
  /** @deprecated kept for backwards compatibility; not rendered. */
  icon?: string;
}

const { number, title, description } = Astro.props;
---

<article class="pillar-card">
  {number && (
    <span class="pillar-card__number" aria-hidden="true">{number}</span>
  )}
  <h3 class="pillar-card__title">{title}</h3>
  {description && <p class="pillar-card__text">{description}</p>}
</article>

<style>
  /* Her card: white, 1px hairline, 8px radius, no shadow, no lift. */
  .pillar-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--pad-card);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  /* Decorative numeral: Inter 500 in ink-3 (#8E8E98). Large (24px) and
     aria-hidden, so the non-text grey is fine. */
  .pillar-card__number {
    margin-bottom: 14px;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: var(--fw-display);
    line-height: 1;
    letter-spacing: var(--ls-display);
    color: var(--ink-3);
    font-variant-numeric: lining-nums tabular-nums;
  }

  /* Her .program-card-title */
  .pillar-card__title {
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-size: var(--fs-h5);
    font-weight: var(--fw-heading);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-heading);
    color: var(--color-text-heading);
  }

  .pillar-card__title:last-child {
    margin-bottom: 0;
  }

  .pillar-card__text {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.92rem;
    line-height: var(--lh-loose);
    color: var(--color-text-secondary);
  }
</style>
