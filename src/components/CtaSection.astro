---
/**
 * CtaSection — closing band of a page: a centered title, optional
 * supporting paragraph and one primary CTA. Used as the closing module of
 * pages (Home, About, Get-Involved, etc.).
 *
 * Spec:
 *  - Task #10 props: `{ title, description?, ctaLabel, ctaHref }`.
 *  - Design: her light closing band (`.section-contact`, fcacfc4
 *    css/style.css L1173–1190: "claro, no bloque oscuro"): white, centered,
 *    80px padding (48px on phones), section-sized Inter 550 heading, ink-2
 *    copy capped at 560px, and the ink pill CTA (`.btn .btn-primary`). It
 *    stays white on purpose: the footer under it is bg-2, so a tinted band
 *    here would stack two tinted surfaces.
 *  - The global section hairline (base.css) closes it, as in her design.
 */

export interface Props {
  title: string;
  description?: string;
  ctaLabel: string;
  ctaHref: string;
  ctaExternal?: boolean;
}

const { title, description, ctaLabel, ctaHref, ctaExternal = false } =
  Astro.props;

const externalAttrs = ctaExternal
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<section class="cta-section" role="region" aria-label={title}>
  <div class="cta-section__inner">
    <h2 class="cta-section__title">{title}</h2>
    {description && <p class="cta-section__description">{description}</p>}
    <a class="cta-section__cta btn btn-primary" href={ctaHref} {...externalAttrs}>
      {ctaLabel}
    </a>
  </div>
</section>

<style>
  .cta-section {
    position: relative;
    background: var(--color-bg-base);
    color: var(--color-text-primary);
    padding-block: var(--section-pad-contact);
    text-align: center;
  }

  .cta-section__inner {
    width: 100%;
    max-width: var(--container-narrow);
    margin-inline: auto;
    padding-inline: var(--container-padding);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media (min-width: 481px) {
    .cta-section__inner {
      padding-inline: var(--container-padding-md);
    }
  }

  .cta-section__title {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: var(--fw-heading);
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-heading);
    color: var(--color-text-heading);
    margin: 0 0 14px;
    text-wrap: balance;
  }

  .cta-section__description {
    font-family: var(--font-body);
    font-size: var(--fs-lead);
    line-height: var(--lh-relaxed);
    color: var(--color-text-secondary);
    max-width: 560px;
    margin: 0 auto;
    /* Centred copy: balance, so the last line is never a two-word runt. */
    text-wrap: balance;
  }

  .cta-section__cta {
    margin-top: 22px;
  }
</style>
