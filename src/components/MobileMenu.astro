---
/**
 * MobileMenu — accessible right-side drawer for primary navigation.
 *
 * Spec: docs/ARCHITECTURE.md §3 (mobile behaviour). Design: her mobile menu
 * (fcacfc4 css/style.css L271–291, L1657–1689): thin 22px hamburger lines
 * that morph into an X; a 268px white drawer with a 1px left rule and no
 * shadow; plain links that fill bg-2 on hover (no brackets); the CTA as a
 * content-width ink pill right after the links.
 *
 * Renders (all visible below 1080px only, or when Header falls back to
 * `.site-header--compact` because the nav row does not fit):
 *   1. A hamburger toggle button.
 *   2. A light backdrop layer that closes the drawer on click.
 *   3. A right-side slide-in drawer with all primary nav items + the
 *      Get-involved CTA, ending in a copy of the ES | EN switcher: the open
 *      drawer covers the bar's switcher and the focus trap keeps keyboard
 *      users inside, so the language can be changed from here too. It gets
 *      the real `Astro.url.pathname` (not `currentPath`, which Nav may set
 *      to a parent section for the active highlight).
 *
 * The drawer's close button is drawn as the same thin X and is placed exactly
 * over the hamburger (its position is measured when the drawer opens), so
 * opening the menu reads as the hamburger morphing into an X, as in her
 * design, while the button stays inside the dialog for keyboard and screen
 * reader users.
 *
 * A11y guarantees:
 *   - Toggle: role=button (native), aria-controls, aria-expanded, aria-label.
 *   - Drawer: a <div> with role=dialog, aria-modal=true, aria-label (a
 *     dialog role is not allowed on <aside>).
 *   - Links (and the CTA): aria-current="page" on the current page's link,
 *     "true" on its section (a child page, or Header's navActivePath), as in
 *     Nav's row.
 *   - ESC closes; backdrop click closes; clicking any link closes.
 *   - Reopening during the 350ms close transition cancels the pending hide,
 *     so a quick close → reopen never leaves a hidden, scroll-locked drawer.
 *   - Focus moves to first focusable inside drawer on open and returns to
 *     toggle on close.
 *   - Tab cycles within drawer while open (basic focus trap).
 *   - <body> scroll is locked while open.
 *   - prefers-reduced-motion disables the slide transition.
 *   - Forced colours: the span-drawn lines are repainted in ButtonText.
 *
 * Renders nothing visible from 1080px up (the desktop row takes over; keep
 * the breakpoint in sync with Nav.astro), unless the header is compact.
 */
import type { NavItem } from '../lib/types';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { t, type Locale } from '../lib/i18n';

export interface Props {
  items: NavItem[];
  currentPath: string;
  /** id used to wire aria-controls between toggle and drawer. */
  drawerId?: string;
  lang?: Locale;
}

const { items, currentPath, drawerId = 'mobile-nav-drawer', lang = 'es' } = Astro.props;

const labelOpen = t(lang, 'mobile.toggle.open');
const labelClose = t(lang, 'mobile.toggle.close');
const drawerLabel = t(lang, 'mobile.drawer.label');
const closeBtnLabel = t(lang, 'mobile.drawer.closeBtn');
const mobileNavLabel = t(lang, 'mobile.nav.label');

/** Mark a link active when its href matches `currentPath` exactly, OR when
 *  `currentPath` is a child of href (e.g. `/projects/vigia` highlights
 *  Projects). Skip the root match-everything trap. */
const isActive = (href: string): boolean => {
  if (!currentPath) return false;
  if (href === '/' || href === '/en') return currentPath === href;
  return currentPath === href || currentPath.startsWith(href + '/');
};

// The real page path; `currentPath` may be a section set through navActivePath.
const realPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const ariaCurrent = (href: string): 'page' | 'true' | undefined =>
  isActive(href) ? (realPath === href ? 'page' : 'true') : undefined;
---

<button
  type="button"
  class="mobile-toggle"
  aria-controls={drawerId}
  aria-expanded="false"
  aria-label={labelOpen}
  data-mobile-toggle
  data-label-open={labelOpen}
  data-label-close={labelClose}
>
  <span aria-hidden="true"></span>
  <span aria-hidden="true"></span>
  <span aria-hidden="true"></span>
</button>

<div class="mobile-backdrop" data-mobile-backdrop hidden></div>

<div
  id={drawerId}
  class="mobile-drawer"
  role="dialog"
  aria-modal="true"
  aria-label={drawerLabel}
  data-mobile-drawer
  hidden
>
  <button
    type="button"
    class="mobile-drawer__close"
    aria-label={closeBtnLabel}
    data-mobile-close
  >
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>

  <nav class="mobile-drawer__nav" aria-label={mobileNavLabel}>
    <ul class="mobile-drawer__list">
      {items.filter((i: NavItem) => !i.cta).map((item: NavItem) => (
        <li>
          <a
            class:list={['mobile-drawer__link', { 'is-active': isActive(item.href) }]}
            href={item.href}
            aria-current={ariaCurrent(item.href)}
          >{item.label}</a>
        </li>
      ))}
    </ul>

    {items.filter((i: NavItem) => i.cta).map((item: NavItem) => (
      <a
        class="mobile-drawer__cta"
        href={item.href}
        aria-current={ariaCurrent(item.href)}
      >{item.label}</a>
    ))}
  </nav>

  <div class="mobile-drawer__lang">
    <LanguageSwitcher currentPath={Astro.url.pathname} />
  </div>
</div>

<script>
  /**
   * Inline controller — runs once per page load. Idempotent (guarded with
   * a global flag to survive Astro view transitions).
   */
  (() => {
    if ((window as any).__aismxMobileMenuBound) return;
    (window as any).__aismxMobileMenuBound = true;

    const init = () => {
      const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
      const drawer = document.querySelector<HTMLElement>('[data-mobile-drawer]');
      const backdrop = document.querySelector<HTMLElement>('[data-mobile-backdrop]');
      const closeBtn = document.querySelector<HTMLButtonElement>('[data-mobile-close]');

      if (!toggle || !drawer || !backdrop) return;

      // Localized aria-labels are emitted as data-attrs by the .astro template
      // so this controller stays locale-agnostic.
      const openLabel = toggle.dataset.labelOpen ?? 'Open main menu';
      const closeLabel = toggle.dataset.labelClose ?? 'Close main menu';

      let lastFocus: HTMLElement | null = null;
      // Pending "hide after the close transition"; open() cancels it.
      let hideTimer = 0;

      const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

      const focusables = (root: HTMLElement) =>
        Array.from(
          root.querySelectorAll<HTMLElement>(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
          )
        ).filter(el => !el.hasAttribute('hidden'));

      // Place the drawer's close button exactly over the hamburger, so the
      // menu opens as "the hamburger turns into an X". Measured after the
      // scroll lock, which can remove the scrollbar and shift the header.
      const alignCloseButton = () => {
        const r = toggle.getBoundingClientRect();
        const vw = document.documentElement.clientWidth;
        drawer.style.setProperty('--close-top', `${Math.round(r.top)}px`);
        drawer.style.setProperty('--close-right', `${Math.max(0, Math.round(vw - r.right))}px`);
      };

      const open = () => {
        window.clearTimeout(hideTimer);
        lastFocus = document.activeElement as HTMLElement;
        document.body.style.overflow = 'hidden';
        alignCloseButton();
        drawer.hidden = false;
        backdrop.hidden = false;
        // Allow CSS transition to pick up the class on the next frame.
        requestAnimationFrame(() => {
          drawer.classList.add('is-open');
          backdrop.classList.add('is-open');
        });
        toggle.classList.add('is-open');
        toggle.setAttribute('aria-expanded', 'true');
        toggle.setAttribute('aria-label', closeLabel);
        const first = focusables(drawer)[0];
        first?.focus();
      };

      const close = () => {
        drawer.classList.remove('is-open');
        backdrop.classList.remove('is-open');
        toggle.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', openLabel);
        document.body.style.overflow = '';
        // Hide after transition to keep tab order clean. Skipped if the
        // drawer was reopened in the meantime (open() also clears the timer).
        const finalize = () => {
          if (isOpen()) return;
          drawer.hidden = true;
          backdrop.hidden = true;
        };
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduced) finalize();
        else hideTimer = window.setTimeout(finalize, 350);
        lastFocus?.focus();
      };

      toggle.addEventListener('click', () => (isOpen() ? close() : open()));
      backdrop.addEventListener('click', close);
      closeBtn?.addEventListener('click', close);

      // ESC closes; tab traps focus inside drawer.
      document.addEventListener('keydown', (e: KeyboardEvent) => {
        if (!isOpen()) return;
        if (e.key === 'Escape') {
          e.preventDefault();
          close();
          return;
        }
        if (e.key === 'Tab') {
          const list = focusables(drawer);
          if (list.length === 0) return;
          const first = list[0];
          const last = list[list.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      });

      // Close drawer when any link inside is activated (smooth nav UX).
      drawer.addEventListener('click', (e: MouseEvent) => {
        const target = e.target as HTMLElement;
        if (target.closest('a')) close();
      });

      // Auto-close when the one-row nav takes over again (viewport ≥1080px
      // and the header not compact): the toggle is then hidden by CSS. Two
      // frames later, so Header's own resize check (compact or not) has run.
      window.addEventListener('resize', () => {
        requestAnimationFrame(() => requestAnimationFrame(() => {
          if (isOpen() && getComputedStyle(toggle).display === 'none') close();
        }));
      }, { passive: true });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

<style>
  /* Hamburger toggle — hidden from 1080px up. A 40px hit area around her
     22px × 1.5px lines; the negative block margin keeps the header as short
     as hers (the logo sets its height). */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    margin: -4px -3px -4px 0;
    padding: 0;
    background: transparent;
    border: none;
    border-radius: var(--radius);
    cursor: pointer;
    color: var(--color-text-primary);
    transition: background var(--transition);
  }
  .mobile-toggle:hover {
    background: var(--color-bg-warm);
  }
  .mobile-toggle span {
    display: block;
    width: 22px;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .mobile-toggle.is-open span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .mobile-toggle.is-open span:nth-child(2) { opacity: 0; }
  .mobile-toggle.is-open span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  /* Backdrop — a light ink veil (she has none; it signals the modal state). */
  .mobile-backdrop {
    position: fixed;
    inset: 0;
    background: var(--color-backdrop);
    opacity: 0;
    z-index: 998;
    transition: opacity 0.3s ease;
  }
  .mobile-backdrop.is-open { opacity: 1; }
  .mobile-backdrop[hidden] { display: none; }

  /* Drawer — white, 1px left rule, no shadow (her ≤768 .main-nav). */
  .mobile-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 268px;
    max-width: 86vw;
    height: 100vh;
    height: 100dvh;
    padding: 76px 24px 40px;
    background: var(--color-bg-base);
    color: var(--color-text-primary);
    border-left: 1px solid var(--color-border);
    box-shadow: none;
    transform: translateX(100%);
    transition: transform 0.35s ease;
    z-index: 999;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }
  .mobile-drawer.is-open { transform: translateX(0); }
  .mobile-drawer[hidden] { display: none; }

  /* Close button: her morphed X (two 22px × 1.5px lines), placed over the
     hamburger via --close-top / --close-right (set when the drawer opens). */
  .mobile-drawer__close {
    position: absolute;
    top: var(--close-top, 15px);
    right: var(--close-right, 15px);
    width: 40px;
    height: 40px;
    padding: 0;
    background: transparent;
    border: none;
    border-radius: var(--radius);
    cursor: pointer;
    color: var(--color-text-primary);
    transition: background var(--transition);
  }
  .mobile-drawer__close:hover {
    background: var(--color-bg-warm);
  }
  .mobile-drawer__close span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 22px;
    height: 1.5px;
    margin: -0.75px 0 0 -11px;
    background: currentColor;
    border-radius: 2px;
  }
  .mobile-drawer__close span:nth-child(1) { transform: rotate(45deg); }
  .mobile-drawer__close span:nth-child(2) { transform: rotate(-45deg); }

  .mobile-drawer__nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .mobile-drawer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .mobile-drawer__link {
    display: block;
    padding: 11px 12px;
    border-radius: var(--radius);
    color: var(--color-text-secondary);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: var(--fw-book);
    line-height: var(--lh-relaxed);
    transition: background var(--transition), color var(--transition);
  }
  .mobile-drawer__link:hover {
    background: var(--color-bg-warm);
    color: var(--color-text-primary);
  }
  .mobile-drawer__link.is-active {
    color: var(--color-text-primary);
    font-weight: var(--fw-heading);
  }

  /* Get-involved CTA — her drawer pill: content width, right after the
     links, same metrics as the desktop pill at .95rem. */
  .mobile-drawer__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 8px;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    background: var(--color-cta-bg);
    color: var(--color-cta-text);
    font-family: var(--font-body);
    font-weight: var(--fw-medium);
    font-size: 0.95rem;
    line-height: var(--lh-relaxed);
    text-decoration: none;
    transition: background var(--transition);
  }
  .mobile-drawer__cta:hover {
    background: var(--color-cta-bg-hover);
    color: var(--color-cta-text);
  }

  /* ES | EN at the end of the drawer, under a soft rule. 7px + the option's
     own 5px padding puts «ES» on the links' 12px text inset. */
  .mobile-drawer__lang {
    margin-top: 16px;
    padding: 16px 7px 0;
    border-top: 1px solid var(--color-border-soft);
  }

  /* Visibility by breakpoint — the drawer covers everything below the
     one-row nav (1080px, see Nav.astro), and any width when the header is
     compact (the row does not fit). */
  @media (max-width: 1079.98px) {
    .mobile-toggle { display: inline-flex; }
  }
  :global(.site-header--compact) .mobile-toggle {
    display: inline-flex;
  }
  @media (min-width: 1080px) {
    /* Force-hide drawer & backdrop on desktop even if state was left dirty. */
    :global(.site-header:not(.site-header--compact)) .mobile-toggle,
    :global(.site-header:not(.site-header--compact)) .mobile-backdrop,
    :global(.site-header:not(.site-header--compact)) .mobile-drawer {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-drawer,
    .mobile-backdrop,
    .mobile-toggle span {
      transition: none;
    }
  }

  /* Forced colours (Windows High Contrast): the UA repaints backgrounds as
     Canvas, which erases the span-drawn hamburger and close lines. Paint
     them in the system button-text colour so both controls stay visible. */
  @media (forced-colors: active) {
    .mobile-toggle span,
    .mobile-drawer__close span {
      background: ButtonText;
    }
  }
</style>
