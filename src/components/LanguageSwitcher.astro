---
/**
 * LanguageSwitcher — two-segment "ES | EN" toggle in the site header.
 *
 * Spec: docs/I18N-ARCHITECTURE.md §4.
 *
 * Behaviour:
 *  - Renders two plain <a> tags so middle-click / right-click / no-JS all work.
 *  - The active locale gets `.is-active` + `aria-current="true"`. Active state
 *    is signalled by weight + colour only — no background fill.
 *  - On click, an inline script writes `localStorage.aismx_locale = <target>`
 *    before the browser follows the link. This pins the user's preference so
 *    the auto-detection script on `/` won't override them on the next visit.
 *  - Path preservation is handled by `switchLocalePath` in `src/lib/i18n.ts`:
 *    `/about` ↔ `/en/about`, `/projects/vigia` ↔ `/en/projects/vigia`,
 *    `/` ↔ `/en`. Spanish-only sections (certificate verification pages, see
 *    `ES_ONLY_PREFIXES`) have no twin, so there EN points to the closest
 *    English page (`englishFallback`: the GSH page for /certificados, the
 *    programs page for /programas/certificados).
 *  - Accessible names start with the visible «ES» / «EN» (WCAG 2.5.3).
 *
 * Placement: rendered by `<Header>` through `<Nav>`'s slot: right of the nav
 * row on desktop, immediately left of the hamburger below 1080px, where it
 * stays in the bar (language is a meta-control, kept visible). MobileMenu
 * also repeats it at the end of the open drawer, which covers the bar; the
 * inline script below is guarded and binds every `.lang-switcher__option`,
 * so both copies persist the choice.
 *
 * Look: small Inter 500 labels in the nav-link grey (ink-2), ink and 600
 * when active, with a decorative ink-3 separator. Not the muted grey: the
 * dark El Caracol band greys the glass behind the bar to about #E1E1E1, where
 * muted text falls to 3.9:1 (ink-2 keeps 5.2:1).
 */
import { englishFallback, hasEnglishTwin, localeFromPath, switchLocalePath, t } from '../lib/i18n';

export interface Props {
  /** Current pathname, e.g. Astro.url.pathname from the parent layout. */
  currentPath: string;
}

const { currentPath } = Astro.props;
const active = localeFromPath(currentPath);
const { href: other } = switchLocalePath(currentPath);
const esHref = active === 'es' ? currentPath : other;
const enHref = active === 'en' ? currentPath : hasEnglishTwin(currentPath) ? other : englishFallback(currentPath);
---

<div class="lang-switcher" role="group" aria-label={t(active, 'switcher.label')}>
  <a
    class:list={['lang-switcher__option', { 'is-active': active === 'es' }]}
    href={esHref}
    hreflang="es"
    lang="es"
    aria-current={active === 'es' ? 'true' : undefined}
    aria-label={t(active, 'switcher.toEs')}
  >{t(active, 'switcher.es')}</a>
  <span class="lang-switcher__sep" aria-hidden="true">|</span>
  <a
    class:list={['lang-switcher__option', { 'is-active': active === 'en' }]}
    href={enHref}
    hreflang="en"
    lang="en"
    aria-current={active === 'en' ? 'true' : undefined}
    aria-label={t(active, 'switcher.toEn')}
  >{t(active, 'switcher.en')}</a>
</div>

<script is:inline>
  /*
   * Persist the chosen locale to localStorage *before* navigation completes.
   * Uses `click` (not the `<a>`'s navigation event) so it fires synchronously
   * in the same tick the browser starts the link follow. We never call
   * preventDefault — if storage is unavailable (private mode, quota), the
   * link still navigates and the user just gets re-detected on the next visit.
   */
  (() => {
    if (window.__aismxLangSwitcherBound) return;
    window.__aismxLangSwitcherBound = true;
    const bind = () => {
      document.querySelectorAll('.lang-switcher__option').forEach((a) => {
        a.addEventListener('click', () => {
          try {
            localStorage.setItem('aismx_locale', a.getAttribute('hreflang'));
          } catch (e) { /* swallow: private mode / quota */ }
        });
      });
    };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bind);
    } else {
      bind();
    }
  })();
</script>

<style>
  /* docs/I18N-ARCHITECTURE.md §4.2 — minimal "ES | EN" toggle, no chip,
     no border. Spacing from its neighbours comes from the header cluster. */
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    flex-shrink: 0;
  }

  .lang-switcher__option {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: var(--fw-medium);
    letter-spacing: 0.04em;
    line-height: var(--lh-relaxed);
    padding: 4px 5px;
    border-radius: var(--radius-xs);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition);
  }
  .lang-switcher__option:hover {
    color: var(--color-text-primary);
  }
  .lang-switcher__option.is-active {
    color: var(--color-text-primary);
    font-weight: var(--fw-semibold);
  }

  .lang-switcher__sep {
    color: var(--color-border-strong);
    font-size: 0.8rem;
    line-height: 1;
    user-select: none;
  }
</style>
