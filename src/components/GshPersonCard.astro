---
/**
 * GshPersonCard -- speaker / judge card for /global-south-challenge (ES + EN).
 * Design: her team-card language (fcacfc4 css/style.css L1075–1126): a white
 * hairline card (1px line, 8px radius, no shadow, no hover: it is not a link)
 * with a 54px round portrait or initials placeholder, name, affiliation as an
 * in-card label, optional talk title (highlight) and location, a short body,
 * an in-text "watch talk" link and an outlined LinkedIn circle (her footer
 * social icon).
 * Affiliation labels and talk titles are balanced, so no line ends on a lone
 * word or splits AI safety.
 *
 * `highlightLang` is the language of the talk title when it differs from the
 * page (BCP 47, e.g. 'en' for an English talk title on the Spanish page); it
 * sets `lang` on the highlight so screen readers switch pronunciation.
 */
export interface Props {
  name: string;
  affiliation: string;
  body: string;
  photo?: string | null;
  initials?: string;
  linkedin?: string | null;
  highlight?: string | null;
  highlightLang?: string;
  location?: string | null;
  talkUrl?: string | null;
  talkLabel?: string;
}

const {
  name,
  affiliation,
  body,
  photo = null,
  initials = '',
  linkedin = null,
  highlight = null,
  highlightLang,
  location = null,
  talkUrl = null,
  talkLabel = 'Ver charla',
} = Astro.props;
---

<article class="gperson">
  <div class="gperson__head">
    {photo ? (
      <img
        class="gperson__photo"
        src={photo}
        alt=""
        loading="lazy"
        decoding="async"
        width="54"
        height="54"
      />
    ) : (
      <span class="gperson__photo gperson__photo--ph" aria-hidden="true">{initials}</span>
    )}
    <div class="gperson__id">
      <h3 class="gperson__name">{name}</h3>
      <p class="gperson__affil">{affiliation}</p>
      {location && <p class="gperson__loc">{location}</p>}
    </div>
  </div>

  {highlight && <p class="gperson__highlight" lang={highlightLang}>{highlight}</p>}
  <p class="gperson__body">{body}</p>

  {(talkUrl || linkedin) && (
    <div class="gperson__links">
      {talkUrl && (
        <a
          class="gperson__talk"
          href={talkUrl}
          aria-label={talkLabel + ' — ' + name}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg class="gperson__talk-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M8 5v14l11-7z" />
          </svg>
          {talkLabel}
        </a>
      )}
      {linkedin && (
        <a
          class="gperson__social"
          href={linkedin}
          aria-label={name + ' · LinkedIn'}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1 0 5.001 2.5 2.5 0 0 1 0-5.001zM3 9h4v12H3V9zm7 0h3.84v1.64h.05c.53-1 1.85-2.05 3.81-2.05 4.07 0 4.82 2.68 4.82 6.16V21h-4v-5.34c0-1.27-.02-2.91-1.77-2.91-1.77 0-2.04 1.39-2.04 2.82V21h-4V9z" />
          </svg>
        </a>
      )}
    </div>
  )}
</article>

<style>
  /* Her .team-card: white, 1px hairline, 8px radius, 26px 22px. */
  .gperson {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    padding: 26px 22px;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .gperson__head { display: flex; align-items: center; gap: 14px; }

  /* Her .team-photo-wrapper: 54px circle with a hairline, bg-3 placeholder. */
  .gperson__photo {
    flex: 0 0 auto;
    width: 54px;
    height: 54px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    object-fit: cover;
    background: var(--color-bg-muted);
  }
  .gperson__photo--ph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-size: var(--fs-h6);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-wide);
    color: var(--color-text-muted);
    background: var(--color-bg-muted);
  }
  .gperson__id { min-width: 0; }

  /* Her .team-name */
  .gperson__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: var(--fw-heading);
    line-height: var(--lh-heading);
    letter-spacing: -0.015em;
    color: var(--color-text-heading);
  }

  /* In-card label (her .theory-label) */
  .gperson__affil {
    margin: 4px 0 0;
    font-family: var(--font-body);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    line-height: var(--lh-normal);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-wrap: balance;
  }
  .gperson__loc {
    margin: 2px 0 0;
    font-family: var(--font-body);
    font-size: 0.84rem;
    line-height: var(--lh-normal);
    color: var(--color-text-muted);
  }

  /* Talk title: Inter 500, upright (no serif italic). */
  .gperson__highlight {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-style: normal;
    font-weight: var(--fw-medium);
    line-height: 1.5;
    color: var(--color-text-heading);
    text-wrap: balance;
  }
  .gperson__body {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }
  .gperson__links {
    margin-top: auto;
    padding-top: 4px;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  /* In-text link (her .inline-link): clay-dark 500 with a hairline underline
     that turns clay on hover. */
  .gperson__talk {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    color: var(--color-link-inline);
    text-decoration: none;
    border-bottom: 1px solid var(--color-link-underline);
    transition: color var(--transition), border-color var(--transition);
  }
  .gperson__talk:hover {
    color: var(--color-link-inline);
    border-bottom-color: var(--color-link-underline-hover);
  }
  .gperson__talk:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
    border-radius: var(--radius-xs);
  }
  .gperson__talk-icon { width: 12px; height: 12px; flex: 0 0 auto; }

  /* Outlined 32px circle (her .footer-social-icon). */
  .gperson__social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background: var(--color-bg-base);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    transition: color var(--transition), border-color var(--transition);
  }
  .gperson__social:hover {
    color: var(--color-text-primary);
    border-color: var(--color-border-strong);
  }
  .gperson__social:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: 2px; }
  .gperson__social svg { width: 16px; height: 16px; }
</style>
