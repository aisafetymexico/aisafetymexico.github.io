---
/**
 * Breadcrumb — orientation trail for interior pages.
 *
 * Spec: docs/ARCHITECTURE.md §5.
 *  - Show on every page EXCEPT `/`.
 *  - Format: `Inicio › <Section> › <Page>` with `›` separator.
 *  - Final item is the current page (not linked, ink 500).
 *  - Mobile: when path depth ≥ 2 AND viewport <500px, collapse to a
 *    "‹ <Parent>" back-link (handled in CSS).
 *  - Emits BreadcrumbList JSON-LD for SEO.
 *
 * Look ("Editorial mínimo"): a quiet .8rem trail — ink-2 links that turn
 * clay-dark on hover, ink current page, ink-3 separators. It has no box of
 * its own: the parent places it (PageHero centers it above the H1; the blog
 * article keeps it left-aligned).
 *
 * Props:
 *  - items: ordered list, including the current page as last entry.
 *           Set `href` on every entry except the last (current).
 *  - align: 'start' (default) | 'center' — trail alignment.
 *
 * Example:
 *   <Breadcrumb items={[
 *     { label: 'Inicio', href: '/' },
 *     { label: 'Proyectos', href: '/projects' },
 *     { label: 'VIGÍA' }
 *   ]} />
 */
import type { BreadcrumbItem } from '../lib/types';
import { t, type Locale } from '../lib/i18n';

export interface Props {
  items: BreadcrumbItem[];
  /** Optional override for the back-link label shown on small mobile. */
  backLabel?: string;
  lang?: Locale;
  align?: 'start' | 'center';
}

const { items, backLabel, lang = 'es', align = 'start' } = Astro.props;

if (!items || items.length === 0) {
  throw new Error('Breadcrumb: `items` must contain at least one entry.');
}

const lastIndex = items.length - 1;

// Parent for the mobile back-link (penultimate entry, fallback to first).
const parent =
  items.length >= 2 ? items[lastIndex - 1] : items[0];
const parentHref = parent?.href ?? '/';
const parentLabel = backLabel ?? parent?.label ?? t(lang, 'breadcrumb.back');
const navAriaLabel = t(lang, 'breadcrumb.aria');

// Resolve absolute URL for JSON-LD (BreadcrumbList requires URLs).
const site = Astro.site ?? new URL('https://aisafetymexico.github.io/');
const resolveUrl = (href?: string): string | undefined => {
  if (!href) return undefined;
  try {
    return new URL(href, site).toString();
  } catch {
    return href;
  }
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item: BreadcrumbItem, idx: number) => {
    const url = resolveUrl(item.href);
    return {
      '@type': 'ListItem',
      position: idx + 1,
      name: item.label,
      ...(url ? { item: url } : {}),
    };
  }),
};
---

<nav
  class:list={['breadcrumb', { 'breadcrumb--center': align === 'center' }]}
  aria-label={navAriaLabel}
>
  {/* Mobile back-link (only renders on small screens with depth ≥ 2). */}
  {items.length >= 2 && (
    <a class="breadcrumb__back" href={parentHref} rel="up">
      <span aria-hidden="true">‹</span>
      <span>{parentLabel}</span>
    </a>
  )}

  {/* Full ordered trail (hidden on small mobile when depth ≥ 2). */}
  <ol class="breadcrumb__trail">
    {items.map((item: BreadcrumbItem, idx: number) => {
      const isLast = idx === lastIndex;
      return (
        <li class="breadcrumb__item">
          {item.href && !isLast ? (
            <a class="breadcrumb__link" href={item.href}>{item.label}</a>
          ) : (
            <span
              class="breadcrumb__current"
              aria-current={isLast ? 'page' : undefined}
            >{item.label}</span>
          )}
          {!isLast && (
            <span class="breadcrumb__sep" aria-hidden="true">›</span>
          )}
        </li>
      );
    })}
  </ol>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />
</nav>

<style>
  .breadcrumb {
    width: 100%;
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    line-height: 1.4;
    color: var(--color-text-muted);
  }

  .breadcrumb__trail {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .breadcrumb--center {
    display: flex;
    justify-content: center;
  }
  /* min-width: 0 lets the trail (a flex item here) shrink to the row, so a
     long current page truncates with its ellipsis instead of spilling past
     the gutters. */
  .breadcrumb--center .breadcrumb__trail {
    justify-content: center;
    min-width: 0;
  }

  .breadcrumb__item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }

  .breadcrumb__link {
    color: var(--color-text-secondary);
    text-decoration: none;
    border-radius: var(--radius-xs);
    transition: color var(--transition);
  }
  .breadcrumb__link:hover {
    color: var(--color-link-hover);
  }

  .breadcrumb__current {
    color: var(--color-text-primary);
    font-weight: var(--fw-medium);
    /* Truncate gracefully on tight rows */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 60ch;
  }

  .breadcrumb__sep {
    color: var(--color-border-strong);
    line-height: 1;
    user-select: none;
  }

  /* Mobile back-link — hidden by default; shown only on tight viewports
     when path depth ≥ 2. */
  .breadcrumb__back {
    display: none;
    align-items: center;
    gap: 6px;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-weight: var(--fw-medium);
    padding: 4px 0;
  }
  .breadcrumb__back:hover {
    color: var(--color-link-hover);
  }

  /* Tight-mobile collapse: when the trail is multi-level, swap full trail
     for a single back-link to free vertical space. */
  @media (max-width: 499px) {
    .breadcrumb:has(.breadcrumb__back) .breadcrumb__trail {
      display: none;
    }
    .breadcrumb__back {
      display: inline-flex;
    }
  }
</style>
