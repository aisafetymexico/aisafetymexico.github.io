---
/**
 * /programs — Educational offerings (cursos abiertos + institucionales).
 *
 * Sources:
 *  - docs/ARCHITECTURE.md §2 (`/programs` IndexPage spec).
 *  - docs/CONTENT-MAP.md §1.8 (Programas educativos → cursos abiertos /
 *    institucionales) + §3 (Assets disponibles en
 *    /public/images/Certificados/).
 *  - Task #15 spec.
 *
 * Layout (top → bottom):
 *  1. PageHero (centered: breadcrumb · h1 · description)
 *  2. SectionHeading "Cursos para la comunidad" + ProgramCard ×2
 *     (Fundamentos + Gobernanza; Curso Técnico ARENA), equal height; the
 *     facilitators and materials ride in each card's chips
 *  3. SectionHeading "Programas para instituciones" + ProgramCard ×2
 *     (Centro Geo; UADY · Facultad de Matemáticas), then her outline pill
 *     «Pedir un curso in-house» → /get-involved#training (PROG-1)
 *  4. Galería de certificados — small grid of whole documents; Lightbox
 *     group on click.
 *  5. Trayectoria de formación (mini cards: ML4Good, EAGxCDMX).
 *  6. CtaSection → /get-involved#training.
 *
 * Design: the collaborator's light "Editorial mínimo" (fcacfc4
 * css/style.css). White and bg-2 bands alternate (institutional and
 * trayectoria are tinted; never two tinted bands in a row), card grids use
 * the 18px gap, certificate thumbnails follow her .certificate-img (the
 * whole document, 8px radius, hairline, clay border on hover, no lift),
 * actions are the global .btn pills and in-text links use the global
 * .inline-link.
 *
 * Components used: PageHero, SectionHeading, ProgramCard, Card, Lightbox,
 * CtaSection, Header, Footer.
 *
 * Certificates live in /public/images/Certificados/. Filenames contain
 * spaces — the URL-encoded form is used in `src` so HTML and the lightbox
 * trigger can resolve correctly.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProgramCard from '../components/ProgramCard.astro';
import Card from '../components/Card.astro';
import Lightbox from '../components/Lightbox.astro';
import CtaSection from '../components/CtaSection.astro';

const pathname = '/programs';

const breadcrumb = {
  items: [
    { label: 'Inicio', href: '/' },
    { label: 'Programas' },
  ],
};

// Certificate assets in /public/images/Certificados/.
// `src` values use URL-encoded spaces so the browser resolves them as files.
const certFundamentosAtlas = {
  src: '/images/Certificados/AI%20Safety%20Atlas%20Angel.jpeg',
  alt: 'Certificado AI Safety Atlas — Angel Tenorio',
};
const certFundamentosEnais = {
  src: '/images/Certificados/ENAIS%20Janeth.png',
  alt: 'Certificado ENAIS — Janeth Valdivia',
};
const certCentroGeo = {
  src: '/images/Certificados/Centro%20Geo%20Angel.jpeg',
  alt: 'Constancia Centro GEO — Angel Tenorio',
};
const certUady = {
  src: '/images/Certificados/UADY%20Angel.jpeg',
  alt: 'Constancia UADY · Facultad de Matemáticas — Angel Tenorio',
};
const certSpar = {
  src: '/images/Certificados/SPAR%20Janeth.png',
  alt: 'Certificado SPAR — Janeth Valdivia',
};
const certAiSafetyConnect = {
  src: '/images/Certificados/AI%20Safety%20Connect.png',
  alt: 'Póster del proyecto AI Safety Connect',
};

const certificates = [
  certFundamentosAtlas,
  certFundamentosEnais,
  certCentroGeo,
  certUady,
  certSpar,
  certAiSafetyConnect,
];
---

<BaseLayout
  title="Programas educativos | AI Safety Mexico"
  description="Cursos abiertos a la comunidad y programas a la medida para instituciones en seguridad y gobernanza de inteligencia artificial."
  pathname={pathname}
>
  <Header slot="header" currentPath={pathname} />

  <PageHero
    title="Programas educativos"
    description="Hemos diseñado e impartido cursos abiertos y a la medida —para comunidades, universidades y centros de investigación— que adaptan los marcos contemporáneos de AI safety al contexto mexicano. Las próximas convocatorias se anunciarán en nuestros canales."
    breadcrumb={breadcrumb}
  />

  <!-- ─────────────────────────────────────────────────────────────────
       Cursos abiertos a la comunidad
       ───────────────────────────────────────────────────────────────── -->
  <section class="programs-section programs-section--open">
    <div class="container">
      <SectionHeading
        eyebrow="Cohortes pasadas"
        title="Cursos para la comunidad"
        description="Cohortes de formación que hemos impartido para la comunidad, sin requisitos institucionales. Las próximas convocatorias se anunciarán en nuestros canales."
      />

      <!-- Each ProgramCard renders its own article and is a direct grid
           item, so the row stretches both cards to the same height. -->
      <div class="programs-section__grid">
        <ProgramCard
          title="Curso de Fundamentos de Seguridad y Gobernanza en IA"
          description="Curso introductorio que cubrió los marcos conceptuales contemporáneos en alineación, riesgos sistémicos y gobernanza, con enfoque en el contexto mexicano. Impartido en cohortes pasadas."
          facilitators={['Janeth Valdivia', 'Angel Tenorio']}
          materials={['BlueDot Impact', 'AI Safety Atlas']}
        />

        <ProgramCard
          title="Curso Técnico de Seguridad en IA (ARENA)"
          description="Programa técnico orientado a investigación en alineación e ingeniería: red-teaming, evaluaciones de modelos y prácticas de research engineering, basado en el currículo de ARENA (Alignment Research Engineer Accelerator). Impartido en cohortes pasadas."
          facilitators={['Max Pinelo', 'Angel Tenorio']}
          materials={['ARENA']}
        />
      </div>
    </div>
  </section>

  <!-- ─────────────────────────────────────────────────────────────────
       Programas para instituciones
       ───────────────────────────────────────────────────────────────── -->
  <section class="programs-section programs-section--institutional">
    <div class="container">
      <SectionHeading
        eyebrow="Instituciones"
        title="Programas para instituciones"
        description="Cursos a la medida que hemos diseñado e impartido para universidades, centros de investigación y organismos públicos. Casos recientes:"
      />

      <div class="programs-section__grid">
        <ProgramCard
          institution="Centro GEO"
          title="Seguridad en IA · Centro GEO"
          description="Curso especializado impartido a investigadoras e investigadores del Centro de Investigación en Ciencias de Información Geoespacial, con énfasis en marcos contemporáneos de alineación, riesgos sistémicos y gobernanza técnica."
          facilitators={['Angel Tenorio']}
          certificateImage={certCentroGeo}
        />

        <ProgramCard
          institution="UADY · Facultad de Matemáticas"
          title="Seguridad en IA · UADY"
          description="Programa abierto al público universitario que se impartió en la Universidad Autónoma de Yucatán, en colaboración con la Facultad de Matemáticas."
          facilitators={['Angel Tenorio']}
          certificateImage={certUady}
        />
      </div>

      <!-- PROG-1: her outline pill (her markup put it in a .program-actions
           row inside the institutions card). -->
      <div class="program-actions programs-section__action">
        <a class="btn btn-outline" href="/get-involved#training">Pedir un curso in-house</a>
      </div>
    </div>
  </section>

  <!-- ─────────────────────────────────────────────────────────────────
       Galería de certificados (lightbox)
       ───────────────────────────────────────────────────────────────── -->
  <section class="programs-section programs-section--gallery">
    <div class="container">
      <SectionHeading
        eyebrow="Acreditaciones"
        title="Galería de certificados"
        description="Acreditaciones obtenidas y emitidas por el equipo en programas internacionales y colaboraciones institucionales."
      />

      <ul class="cert-grid" role="list">
        {certificates.map((cert) => (
          <li class="cert-grid__item">
            <button
              type="button"
              class="cert-grid__trigger"
              data-lightbox
              data-lightbox-group="certificates"
              data-lightbox-src={cert.src}
              data-lightbox-alt={cert.alt}
              data-lightbox-caption={cert.alt}
              aria-label={`Ampliar imagen: ${cert.alt}`}
            >
              <img
                class="cert-grid__img"
                src={cert.src}
                alt={cert.alt}
                loading="lazy"
                decoding="async"
              />
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ─────────────────────────────────────────────────────────────────
       Trayectoria de formación (mini)
       ───────────────────────────────────────────────────────────────── -->
  <section class="programs-section programs-section--trayectoria">
    <div class="container">
      <SectionHeading
        eyebrow="Trayectoria"
        title="Formación recibida por el equipo"
        description="Programas internacionales en los que miembros del equipo han participado como egresadas y egresados."
      />

      <!-- The kind of training rides in the card's in-card label (`badge`),
           above the title, as in her card anatomy. -->
      <div class="trayectoria-grid">
        <Card
          padding="md"
          bordered={true}
          interactive={false}
          elevated={false}
          badge="Formación avanzada"
          title="ML4Good"
          description="Campamento internacional de formación en machine learning aplicado a seguridad de IA. Egresados del equipo: Angel, Max, Isabel, Janeth."
        />

        <Card
          padding="md"
          bordered={true}
          interactive={false}
          elevated={false}
          badge="Conferencia · Taller"
          title="EAGxCDMX"
          description="Conferencia regional de Effective Altruism. El equipo participó con el taller «Not so speedy AI Safety» (Silvia Fernández, Angel Tenorio, Max Pinelo)."
        />
      </div>

      <p class="trayectoria-note">
        Más detalles y calendario completo en
        <a class="inline-link" href="/activities">Actividades</a>.
      </p>
    </div>
  </section>

  <CtaSection
    title="¿Quieres llevar un curso a tu institución?"
    description="Diseñamos programas a la medida para universidades, centros de investigación y organismos públicos. Escríbenos para explorar formatos, alcance y calendario."
    ctaLabel="Solicita un programa institucional"
    ctaHref="/get-involved#training"
  />

  <!-- Single global lightbox overlay; auto-wires to data-lightbox triggers. -->
  <Lightbox />

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* Section shell: her 72px rhythm (48px on phones, via --section-pad).
     The hairline between sections comes from base.css (`main > section`).
     Bands alternate white / bg-2 / white / bg-2, then the white CtaSection
     sits above the bg-2 footer, so no two tinted bands touch. Cards on a
     tinted band stay white. */
  .programs-section {
    padding-block: var(--section-pad);
    background: var(--color-bg-section-base);
  }

  .programs-section--institutional,
  .programs-section--trayectoria {
    background: var(--color-bg-section-warm);
  }

  /* ── Program cards grid ─────────────────────────────────────────── */
  /* Her 2-up card grid: 18px gap, one column up to 768px. */
  .programs-section__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-grid);
  }

  @media (min-width: 769px) {
    .programs-section__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* «Pedir un curso in-house» under the institutional cards: her outline
     pill (.btn .btn-outline) in the global .program-actions row. 26px under
     the grid, her actions-under-grid rhythm (this scoped rule outranks the
     global 18px); at ≤480 the global rule stretches the pill full width. */
  .programs-section__action {
    margin-top: 26px;
  }

  /* ── Certificate gallery ────────────────────────────────────────── */
  /* Full rows only: 2 + 2 + 2 on phones, 3 + 3 from 481px up to 1024px,
     all six in one row from 1025px. */
  .cert-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap-grid);
  }

  @media (min-width: 481px) {
    .cert-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1025px) {
    .cert-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  .cert-grid__item {
    margin: 0;
  }

  /* Thumbnail trigger — her .certificate-img: white, 1px hairline, 8px
     radius, zoom-in cursor. Hover and keyboard focus only warm the hairline
     to clay (a non-text mark); nothing lifts or casts a shadow. The focus
     ring itself comes from base.css. */
  .cert-grid__trigger {
    display: block;
    width: 100%;
    padding: 0;
    margin: 0;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    cursor: zoom-in;
    overflow: hidden;
    transition: border-color var(--transition);
  }

  .cert-grid__trigger:hover,
  .cert-grid__trigger:focus-visible {
    border-color: var(--color-accent-decor);
  }

  /* Each thumbnail shows the whole document (her .certificate-img never
     crops): contained in a 4:3 frame on an 8px bg-2 mat, so portrait and
     landscape certificates keep their headers, logos and signatures. */
  .cert-grid__img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    padding: 8px;
    background: var(--color-bg-warm);
  }

  /* ── Trayectoria mini cards ─────────────────────────────────────── */
  .trayectoria-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-grid);
  }

  @media (min-width: 769px) {
    .trayectoria-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Quiet meta line under the cards, left-aligned like the rest of the
     section; its link is the global .inline-link. */
  .trayectoria-note {
    margin-top: var(--space-6);
    font-size: var(--fs-small);
    line-height: var(--lh-relaxed);
    color: var(--color-text-muted);
  }
</style>
