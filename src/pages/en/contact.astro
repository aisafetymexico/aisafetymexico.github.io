---
/**
 * /en/contact — English mirror of /contact.
 *
 * Spec: docs/I18N-ARCHITECTURE.md §2 (Strategy B) + §7 row 11.
 * Sibling: src/pages/contact.astro (same structure, channels and design
 * notes).
 *
 * As with the Spanish source, this is a deliberately minimal page —
 * lowest-friction contact, no form, with a CTA that routes visitors with a
 * collaboration proposal to /en/get-involved#participa.
 *
 * Translation notes:
 *  - The fragment `#participa` in the outbound CTA is intentionally kept in
 *    Spanish: the anchor id on the destination page is `id="participa"` in
 *    both locales (slugs are identical across locales — see I18N §1).
 *  - `contact@aismx.org` and the `@AISafetyMéxico` handle preserved verbatim.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import CtaSection from '../../components/CtaSection.astro';
import { t } from '../../lib/i18n';

const pathname = '/en/contact';

const breadcrumb = {
  items: [
    { label: t('en', 'breadcrumb.home'), href: '/en' },
    { label: 'Contact' },
  ],
};
---

<BaseLayout
  title="Contact — AI Safety Mexico"
  description="Write to contact@aismx.org or follow us on LinkedIn, Instagram, YouTube, and our Luma calendar. We respond to most messages within five business days."
  pathname={pathname}
  lang="en"
>
  <Header slot="header" currentPath={pathname} lang="en" />

  <PageHero
    title="Get in touch"
    description="For in-house courses, residencies, research, or to collaborate with us, reach us through any of these channels."
    breadcrumb={breadcrumb}
    lang="en"
  />

  <section class="page-section" aria-labelledby="channels-heading">
    <div class="container">
      <h2 id="channels-heading" class="contact__heading">Channels</h2>

      <ul class="contact__list" role="list">
        <li class="contact__item contact__item--primary">
          <span class="contact__label role-label">Email</span>
          <a class="contact__value" href="mailto:contact@aismx.org">
            contact@aismx.org
          </a>
          <p class="contact__hint">Primary channel — we prefer email for formal proposals.</p>
        </li>

        <li class="contact__item">
          <span class="contact__label role-label">LinkedIn</span>
          <a
            class="contact__value"
            href="https://www.linkedin.com/company/ai-safety-mexico/"
            target="_blank"
            rel="noopener noreferrer"
          >
            linkedin.com/company/ai-safety-mexico
          </a>
          <p class="contact__hint">For professional connections and updates.</p>
        </li>

        <li class="contact__item">
          <span class="contact__label role-label">Instagram</span>
          <a
            class="contact__value"
            href="https://www.instagram.com/aisafetymx/"
            target="_blank"
            rel="noopener noreferrer"
          >
            @aisafetymx
          </a>
          <p class="contact__hint">For activities, events, and a glimpse of the community.</p>
        </li>

        <li class="contact__item">
          <span class="contact__label role-label">Calendar</span>
          <a
            class="contact__value"
            href="https://luma.com/calendar/cal-WjnM2llUGXz17t5"
            target="_blank"
            rel="noopener noreferrer"
          >
            Events on Luma
          </a>
          <p class="contact__hint">Our event and working-session agenda, with registration.</p>
        </li>

        <li class="contact__item">
          <span class="contact__label role-label">YouTube</span>
          <a
            class="contact__value"
            href="https://www.youtube.com/@AISafetyMéxico"
            target="_blank"
            rel="noopener noreferrer"
          >
            @AISafetyMéxico
          </a>
          <p class="contact__hint">Pre-talks and talks from our events.</p>
        </li>
      </ul>

      <div class="contact__meta">
        <p class="contact__meta-item">
          <strong>Response time.</strong> We respond to most messages within
          five business days.
        </p>
        <p class="contact__meta-item">
          <strong>Location.</strong> We operate from Mexico and also collaborate
          with international organizations.
        </p>
      </div>
    </div>
  </section>

  <CtaSection
    title="Want to collaborate with us?"
    description="If your message is a collaboration proposal — in-house courses, residencies, joint research, or events — our Get involved page lays out the ways to work with us."
    ctaLabel="How to get involved"
    ctaHref="/en/get-involved#participa"
  />

  <Footer slot="footer" lang="en" />
</BaseLayout>

<style>
  /* Channels section: her section rhythm (72px; 48px on phones) on white.
     The hairline under it comes from base.css (`main > section`); the
     global .container gives the shared 1080px column, so the heading and
     cards line up with every other inner page. */
  .page-section {
    padding-block: var(--section-pad);
    background: var(--color-bg-section-base);
  }

  /* Her .section-heading (Inter 550, 1.32rem; 1.18rem on ≤768px). No
     description follows, so 14px to the cards (VF-8). */
  .contact__heading {
    font-size: var(--fs-h2);
    font-weight: var(--fw-heading);
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-heading);
    color: var(--color-text-heading);
    margin: 0 0 14px;
  }

  /* Channel cards: one column; two from 769px with the canonical channel
     (email) spanning the row. 18px gaps, as in her card grids. */
  .contact__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-grid);
    margin: 0 0 var(--space-9);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 769px) {
    .contact__list {
      grid-template-columns: repeat(2, 1fr);
    }

    .contact__item--primary {
      grid-column: 1 / -1;
    }
  }

  /* White card, 1px hairline, 8px radius; no shadow and no hover (only the
     link inside is interactive). Padding as her .event-note. The label is
     the global in-card label (.role-label, 8px below it). */
  .contact__item {
    min-width: 0;
    padding: 22px 24px;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  /* Her .contact-email link: clay-dark, 500, 1.05rem, hairline underline
     that turns clay on hover. Long handles and URLs wrap on phones. */
  .contact__value {
    font-size: 1.05rem;
    font-weight: var(--fw-medium);
    color: var(--color-link-inline);
    border-bottom: 1px solid var(--color-link-underline);
    padding-bottom: 1px;
    overflow-wrap: anywhere;
    transition: color var(--transition), border-color var(--transition);
  }

  .contact__value:hover {
    color: var(--color-link-inline);
    border-bottom-color: var(--color-link-underline-hover);
  }

  /* One- or two-line hints: `balance` splits a two-line hint evenly instead
     of leaving a single word on the second line. */
  .contact__hint {
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 8px 0 0;
    text-wrap: balance;
  }

  /* Response time / location: two short notes under a full-width hairline,
     ink-2 with ink lead-ins (as her .metric-list). The notes keep her
     reading measure (680px), and `pretty` keeps a lone word off their last
     line. */
  .contact__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .contact__meta-item {
    max-width: var(--measure-desc);
    line-height: var(--lh-relaxed);
    color: var(--color-text-secondary);
    margin: 0;
    text-wrap: pretty;
  }

  .contact__meta-item strong {
    color: var(--color-text-primary);
    font-weight: var(--fw-heading);
  }
</style>
