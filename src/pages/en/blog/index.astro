---
/**
 * /en/blog — English mirror of the blog index.
 *
 * Strategy B (docs/I18N-ARCHITECTURE.md): every Spanish page is hand-authored
 * in both locales. The first entry is a Spanish-language working paper, so the
 * card is labelled as such and links to the Spanish post rather than to a
 * machine translation that nobody reviewed.
 */

import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PageHero from '../../../components/PageHero.astro';

const pathname = '/en/blog';

const breadcrumb = {
  items: [
    { label: 'Home', href: '/en' },
    { label: 'Blog' },
  ],
};

const posts = [
  {
    title: 'VIGIA: un pipeline para acelerar la Gobernanza de la IA en México',
    href: '/blog/vigia-gobernanza-ia-mexico',
    authors: 'Pilar Moncada and Max Pinelo',
    kind: 'Working paper',
    language: 'In Spanish',
    summary:
      'We argue that the main obstacle to accelerating AI governance in countries like Mexico is the near-absence of an AI safety vocabulary. We propose a pipeline to make AI risks visible and present its first implementation over Mexico’s official gazette.',
    topics: ['Governance', 'Mexico', 'VIGIA'],
  },
];
---

<BaseLayout
  title="Blog · AI Safety Mexico"
  description="Working papers, essays and research notes from AI Safety Mexico on the safety and governance of artificial intelligence."
  pathname={pathname}
  lang="en"
>
  <Header slot="header" currentPath={pathname} lang="en" />

  <PageHero
    title="Blog"
    description="Working papers, essays and research notes. Peer-reviewed publications live under Research."
    breadcrumb={breadcrumb}
    lang="en"
  />

  <section class="blog-section">
    <div class="blog-section__inner">
      <ul class="post-list" role="list">
        {posts.map((post) => (
          <li class="post-card">
            <p class="post-card__kind">
              {post.kind}
              <span class="post-card__lang">{post.language}</span>
            </p>
            <h2 class="post-card__title">
              <a class="post-card__link" href={post.href}>{post.title}</a>
            </h2>
            <p class="post-card__meta">{post.authors}</p>
            <p class="post-card__summary">{post.summary}</p>
            <ul class="post-card__topics" role="list">
              {post.topics.map((topic) => (
                <li class="post-card__topic">{topic}</li>
              ))}
            </ul>
            <a class="post-card__cta" href={post.href}>Read the post (Spanish)</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Footer slot="footer" lang="en" />
</BaseLayout>

<style>
  .blog-section { padding-block: var(--space-12) var(--space-16); }

  .blog-section__inner {
    max-width: var(--container-narrow);
    margin-inline: auto;
    padding-inline: var(--container-padding-md, 20px);
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .post-card {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-7) var(--space-7) var(--space-6);
  }

  .post-card__kind {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-body);
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--ls-uppercase);
    text-transform: uppercase;
    color: var(--color-accent-secondary);
    margin: 0 0 var(--space-3);
  }

  .post-card__lang {
    letter-spacing: var(--ls-normal);
    text-transform: none;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 1px var(--space-3);
  }

  .post-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: var(--fw-bold);
    line-height: var(--lh-heading);
    color: var(--color-text-heading);
    text-wrap: balance;
    margin: 0 0 var(--space-2);
  }

  .post-card__link { color: inherit; text-decoration: none; }
  .post-card__link:hover { color: var(--color-link-hover); }
  .post-card__link:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 3px;
  }

  .post-card__meta {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-4);
  }

  .post-card__summary {
    font-size: var(--fs-body);
    line-height: var(--lh-relaxed);
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-5);
  }

  .post-card__topics {
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .post-card__topic {
    font-size: var(--fs-caption);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 2px var(--space-3);
  }

  .post-card__cta {
    display: inline-flex;
    align-items: center;
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    color: var(--color-link);
    text-decoration: none;
  }
  .post-card__cta::after { content: ' \2192'; margin-left: var(--space-2); }
  .post-card__cta:hover { color: var(--color-link-hover); text-decoration: underline; }
  .post-card__cta:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 3px;
  }
</style>
