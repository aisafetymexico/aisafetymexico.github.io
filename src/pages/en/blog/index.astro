---
/**
 * /en/blog — English mirror of the blog index.
 *
 * Strategy B (docs/I18N-ARCHITECTURE.md): every Spanish page is hand-authored
 * in both locales. Each entry links to its English counterpart under /en/blog/.
 */

import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PageHero from '../../../components/PageHero.astro';

const pathname = '/en/blog';

const breadcrumb = {
  items: [
    { label: 'Home', href: '/en' },
    { label: 'Blog' },
  ],
};

const posts = [
  {
    title: 'VIGIA: A Pipeline to Accelerate AI Governance in Mexico',
    href: '/en/blog/vigia-gobernanza-ia-mexico',
    authors: 'Pilar Moncada and Max Pinelo',
    kind: 'Working paper',
    summary:
      'We argue that the main obstacle to accelerating AI governance in countries like Mexico is the near-absence of an AI safety vocabulary. We propose a pipeline to make AI risks visible and present its first implementation over Mexico’s official gazette.',
    topics: ['Governance', 'Mexico', 'VIGIA'],
  },
];
---

<BaseLayout
  title="Blog · AI Safety Mexico"
  description="Working papers, essays and research notes from AI Safety Mexico on the safety and governance of artificial intelligence."
  pathname={pathname}
  lang="en"
>
  <Header slot="header" currentPath={pathname} lang="en" />

  <PageHero
    title="Blog"
    description="Working papers, essays and research notes. Peer-reviewed publications live under Research."
    breadcrumb={breadcrumb}
    lang="en"
  />

  <section class="blog-section">
    <div class="blog-section__inner">
      <ul class="post-list" role="list">
        {posts.map((post) => (
          <li class="post-card">
            <p class="post-card__kind role-label">
              {post.kind}
            </p>
            <h2 class="post-card__title">
              <a class="post-card__link" href={post.href}>{post.title}</a>
            </h2>
            <p class="post-card__meta">{post.authors}</p>
            <p class="post-card__summary">{post.summary}</p>
            <ul class="post-card__topics" role="list">
              {post.topics.map((topic) => (
                <li class="post-card__topic tag">{topic}</li>
              ))}
            </ul>
            <a class="post-card__cta section-link" href={post.href}>Read the post</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Footer slot="footer" lang="en" />
</BaseLayout>

<style>
  /* One column of her `.program-card` within the 800px measure. The category
     label, the topic pills and the quiet "read" link
     are the global `.role-label`, `.tag` and `.section-link`. */
  .blog-section {
    padding-block: var(--section-pad);
  }

  .blog-section__inner {
    width: 100%;
    max-width: var(--container-narrow);
    margin-inline: auto;
    padding-inline: var(--container-padding);
  }

  @media (min-width: 481px) {
    .blog-section__inner {
      padding-inline: var(--container-padding-md);
    }
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap-grid);
  }

  /* White card with a hairline. The card itself is not a link, so it has
     no hover state; the title link and the "read" link carry it. */
  .post-card {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--pad-card);
  }

  /* Category label: `.role-label` in clay-dark (her `.resource-type`). */
  .post-card__kind {
    color: var(--color-accent);
  }

  .post-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: var(--fw-heading);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-heading);
    color: var(--color-text-heading);
    text-wrap: balance;
    margin: 0 0 var(--space-2);
  }

  .post-card__link { color: inherit; text-decoration: none; }
  .post-card__link:hover { color: var(--color-link-hover); }

  .post-card__meta {
    font-size: var(--fs-small);
    line-height: var(--lh-normal);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-4);
  }

  .post-card__summary {
    font-size: var(--fs-body);
    line-height: var(--lh-loose);
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-5);
    text-wrap: pretty;
  }

  .post-card__topics {
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* Decorative arrow. The second declaration gives it empty alt text where
     supported; the first is the fallback. */
  .post-card__cta::after {
    content: '\2192';
    content: '\2192' / '';
    margin-left: 6px;
  }
</style>
