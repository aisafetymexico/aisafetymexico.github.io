---
/**
 * /en/team — English mirror of /team.
 *
 * Spec: docs/I18N-ARCHITECTURE.md §2, §7. Sibling-page strategy: same
 * components, same composition, English prose. Spanish sibling source of
 * truth: src/pages/team.astro (structure and design notes; the style block
 * below is a copy of the Spanish one). The closing CTA points at
 * /en/get-involved#participa.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import TeamCard from '../../components/TeamCard.astro';
import CtaSection from '../../components/CtaSection.astro';
import { t } from '../../lib/i18n';

import type { ImgRef } from '../../lib/types';

// ---------- Data ----------

interface Member {
  name: string;
  role: string;
  photo: ImgRef;
  linkedin?: string;
}

const coreTeam: Member[] = [
  {
    name: 'Janeth Valdivia',
    role: 'Head of Operations',
    photo: { src: '/images/Equipo/Janeth.jpeg', alt: 'Janeth Valdivia' },
    linkedin: 'https://www.linkedin.com/in/janeth-valdivia-b90087111/',
  },
  {
    name: 'Angel Tenorio',
    role: 'Education & Divulgation',
    photo: { src: '/images/Equipo/Angel.jpeg', alt: 'Angel Tenorio' },
    linkedin: 'https://www.linkedin.com/in/angel-tenorio-vazquez/',
  },
  {
    name: 'Max Pinelo',
    role: 'Generalist & Head of Strategy',
    photo: { src: '/images/Equipo/Jason.jpeg', alt: 'Max Pinelo' },
    linkedin: 'https://www.linkedin.com/in/jason-pinelo-14a6a81a5/',
  },
  {
    name: 'Isabel Montalvo',
    role: 'Marketing',
    photo: { src: '/images/Equipo/Isabel.jpeg', alt: 'Isabel Montalvo' },
    linkedin: 'https://www.linkedin.com/in/isabel-montalvo/',
  },
  {
    name: 'Dexter Gómez',
    role: 'Adversarial Strategy',
    photo: { src: '/images/Equipo/Dexter.png', alt: 'Dexter Gómez' },
    linkedin: 'https://www.linkedin.com/in/dextergmez/',
  },
  {
    name: 'Karime Pacheco',
    role: 'Head of AIS UPY',
    photo: { src: '/images/Equipo/Karime.jpeg', alt: 'Karime Pacheco' },
    linkedin: 'https://www.linkedin.com/in/karime-pacheco-217368230/',
  },
  {
    name: 'Marco Guzmán',
    role: 'Head of AISMX Guadalajara',
    photo: { src: '/images/Equipo/Marco.png', alt: 'Marco Guzmán' },
  },
];

interface AdvisorEntry {
  name: string;
  role: string;
  affiliation: string;
}

const advisors: AdvisorEntry[] = [
  {
    name: 'Dr. Silvia Fernández',
    role: 'Advisor',
    affiliation: 'Researcher · Centro Geo',
  },
];

interface Collaborator {
  name: string;
  role: string;
}

interface CollaboratorGroup {
  heading: string;
  description: string;
  people: Collaborator[];
}

const collaboratorGroups: CollaboratorGroup[] = [
  {
    heading: 'Research and projects in Mexico',
    description:
      'People who have contributed to publications and projects led from AI Safety Mexico.',
    people: [
      {
        name: 'Pilar Carolina Moncada',
        role: 'VIGÍA · Platform co-creator',
      },
      {
        name: 'Axel Pinelo',
        role: 'VIGÍA · Development and data',
      },
      {
        name: 'Valeria Ramírez',
        role: 'Co-author · AI Safety in Mexico: A Pilot Survey in Yucatan',
      },
    ],
  },
  {
    // The no-break space keeps «/» with SPAR, so the balanced h3 never
    // starts a line with a slash.
    heading: 'International team · SPAR\u00A0/ AI Safety Connect',
    description:
      'Researchers we collaborate with through the SPAR program to produce AI Safety Connect.',
    people: [
      { name: 'Julius A. Odai', role: 'Co-author · AI Safety Connect' },
      { name: 'Ihor Kendiukhov', role: 'Co-author · AI Safety Connect' },
      { name: 'Tim Sankara', role: 'Co-author · AI Safety Connect' },
      { name: 'Jakub K. Nowak', role: 'Co-author · AI Safety Connect' },
      { name: 'Kailer Laino', role: 'Co-author · AI Safety Connect' },
    ],
  },
];

const breadcrumb = {
  items: [
    { label: t('en', 'breadcrumb.home'), href: '/en' },
    { label: 'Team' },
  ],
};

const pageTitle = 'Team · AI Safety Mexico';
const pageDescription =
  'Meet the people behind AI Safety Mexico: core team, advisors, and collaborators sustaining AI research, training, and governance in Mexico.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  lang="en"
  pathname="/en/team"
>
  <Header slot="header" currentPath="/en/team" lang="en" />

  <PageHero
    title="The people behind AI Safety Mexico"
    description="A multidisciplinary collective — engineers, researchers, educators, and governance professionals — working to make AI safety a rigorous, public, national conversation."
    breadcrumb={breadcrumb}
    lang="en"
  />

  <section class="team-section" aria-labelledby="core-team-heading">
    <div class="container">
      <SectionHeading
        id="core-team-heading"
        eyebrow="Our team"
        title="Core team"
        description="People who sustain the operations, research and training of AI Safety Mexico on an ongoing basis."
      />
      <div class="team-grid">
        {coreTeam.map(member => (
          <TeamCard
            name={member.name}
            role={member.role}
            photo={member.photo}
            linkedin={member.linkedin}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="team-section team-section--alt" aria-labelledby="advisors-heading">
    <div class="container">
      <SectionHeading
        id="advisors-heading"
        eyebrow="Board"
        title="Advisors"
        description="Researchers who guide our lines of work and open doors to academic collaborations."
      />
      <ul class="advisors-list" role="list">
        {advisors.map(advisor => (
          <li class="advisors-list__item">
            <span class="advisors-list__role role-label">{advisor.role}</span>
            <h3 class="advisors-list__name">{advisor.name}</h3>
            <span class="advisors-list__affiliation">{advisor.affiliation}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="team-section" aria-labelledby="collaborators-heading">
    <div class="container">
      <SectionHeading
        id="collaborators-heading"
        eyebrow="Allies"
        title="Featured collaborators"
        description="We recognize the work of people who have contributed to specific projects, publications and initiatives, in Mexico and beyond."
      />

      <div class="collab-groups">
        {collaboratorGroups.map(group => (
          <article class="collab-group">
            <h3 class="collab-group__heading">{group.heading}</h3>
            <p class="collab-group__description">{group.description}</p>
            <ul class="collab-list" role="list">
              {group.people.map(p => (
                <li class="collab-item">
                  <span class="collab-item__name">{p.name}</span>
                  <span class="collab-item__role">{p.role}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaSection
    title="Want to join the team?"
    description="We welcome targeted collaborations, research residencies, and institutional partners. If your work aligns with our agenda, write to us and tell us which thread you'd like to pursue."
    ctaLabel="Collaborate with us"
    ctaHref="/en/get-involved#participa"
  />

  <Footer slot="footer" lang="en" />
</BaseLayout>

<style>
  /* Section shells: her 72px rhythm (48px on phones) through --section-pad;
     the line-soft hairline under each section comes from base.css
     (`main > section`). Like her home (team white, advisors bg-2,
     collaborations white), only the advisors band is tinted, so no two
     tinted bands touch (the CtaSection is white, the footer bg-2). */
  .team-section {
    padding-block: var(--section-pad);
    background: var(--color-bg-section-base);
  }

  .team-section--alt {
    background: var(--color-bg-section-warm);
  }

  /* ---- Team grid: her .team-grid, 3 / 2 / 1 columns at
     ≥1025 / 769–1024 / ≤768px with an 18px gap. The card is TeamCard.
     From two columns up every row is as tall as the tallest, so a card
     without a LinkedIn link left alone in the last row (Marco) matches the
     others. ---- */
  .team-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-grid);
  }

  @media (min-width: 769px) {
    .team-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 1fr;
    }
  }

  @media (min-width: 1025px) {
    .team-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Advisors — her .advisor-card: a content-width hairline card on the
     bg-2 band, text only while official photos are pending (GAP-22).
     Role as the in-card label (global .role-label), then the name and the
     affiliation in her .team-name / .team-role type. */
  .advisors-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-grid);
  }

  .advisors-list__item {
    padding: 22px 26px;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .advisors-list__name {
    margin-bottom: 3px;
    font-size: 0.98rem;
    font-weight: var(--fw-heading);
    line-height: var(--lh-heading);
    letter-spacing: -0.015em;
    color: var(--color-text-heading);
  }

  .advisors-list__affiliation {
    display: block;
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  /* ---- Collaborators: one hairline card per group (her .program-card),
     2 columns from 769px; people as rows split by line-soft rules. ---- */
  .collab-groups {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-grid);
  }

  @media (min-width: 769px) {
    .collab-groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .collab-group {
    padding: var(--pad-card);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .collab-group__heading {
    margin-bottom: 10px;
    font-size: var(--fs-h5);
    font-weight: var(--fw-heading);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-heading);
    color: var(--color-text-heading);
  }

  .collab-group__description {
    margin-bottom: 14px;
    font-size: var(--fs-small);
    line-height: var(--lh-loose);
    color: var(--color-text-secondary);
  }

  .collab-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-block: 10px;
    border-top: 1px solid var(--color-border-soft);
  }

  .collab-item:last-child {
    padding-bottom: 0;
  }

  .collab-item__name {
    font-size: 0.98rem;
    font-weight: var(--fw-heading);
    line-height: var(--lh-heading);
    letter-spacing: -0.015em;
    color: var(--color-text-heading);
  }

  .collab-item__role {
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--color-text-muted);
  }
</style>
