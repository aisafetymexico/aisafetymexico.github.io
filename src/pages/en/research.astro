---
/**
 * /en/research — Publications and ongoing research index (English mirror).
 *
 * Sibling page of /research (Strategy B). Pulls from the same `publications`
 * collection; titles and authors come straight from the entry data, while
 * abstracts (authored in Spanish) read from `enAbstracts`, keyed by entry
 * slug, and fall back to the entry's own abstract. Same design as the
 * Spanish page: publications get the one bg-2 band, a lone card spans the
 * row, and partner chips are her .partner pills (linked ones with ↗).
 * The publications band keeps the Spanish anchor (#publicaciones), since
 * anchor ids are shared across locales (as #participa and #gsh-2026 are).
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaSection from '../../components/CtaSection.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const pathname = '/en/research';

// --- Publications collection ---------------------------------------------
// Pulls all non-draft entries; sorts featured first, then by year desc.
const allPublications = await getCollection('publications', ({ data }) => !data.draft);
const publications = allPublications.sort(
  (a: CollectionEntry<'publications'>, b: CollectionEntry<'publications'>) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return b.data.year - a.data.year;
  },
);

// English abstracts for the collection's Spanish entries, keyed by entry slug
// (the file name), so the cards read natively in EN. Entries without a key
// fall back to their own abstract.
const enAbstracts: Record<string, string> = {
  'ai-safety-mexico-pilot-survey-yucatan':
    'A study designed to capture local concerns about AI safety in Mérida, Yucatán. The pilot survey explores local perceptions, risks, and priorities as input for the AI safety agenda in Mexico.',
};

// --- Research areas (taxonomy) -------------------------------------------
const researchAreas = [
  {
    title: 'Technical AI safety',
    description:
      'Alignment, mechanistic interpretability, and red-teaming applied to the study of deployed models.',
  },
  {
    title: 'Governance',
    description:
      'Technical analysis and policy instruments for the responsible development and deployment of AI.',
  },
  {
    title: 'Public policy',
    description:
      'Mexico-based studies on perceptions, risks, and priorities of the Global South.',
  },
  {
    title: 'Open research and education',
    description:
      'Materials, curricula, and open publications that connect research with training in Mexico.',
  },
];

// --- Ongoing research ----------------------------------------------------
// AI Safety Connect cross-link to /en/projects/ai-safety-connect.
const ongoingProjects = [
  {
    title: 'AI Safety Connect',
    badge: 'SPAR COLLABORATION',
    description:
      'A platform and paper that map the international AI safety community through taxonomy and semantic search. Output of the SPAR program with an international team.',
    href: '/en/projects/ai-safety-connect',
    ctaLabel: 'See the project',
  },
];

// --- Collaborations (chips) ----------------------------------------------
const researchPartners = [
  { name: 'SPAR Research', href: 'https://supervisedprogramforalignment.org/' },
  { name: 'ENAIS', href: undefined },
  { name: 'AI Safety Collab', href: undefined },
  { name: 'Centro Geo', href: undefined },
  { name: 'Apart Research', href: 'https://apartresearch.com/' },
];

// --- Breadcrumb -----------------------------------------------------------
const breadcrumb = {
  items: [
    { label: 'Home', href: '/en' },
    { label: 'Research' },
  ],
};
---

<BaseLayout
  title="Research · AI Safety Mexico"
  description="Publications, ongoing projects, and the research agenda of AI Safety Mexico in AI safety, governance, and public policy."
  pathname={pathname}
  lang="en"
>
  <Header slot="header" currentPath={pathname} lang="en" />

  <PageHero
    title="Rigorous research, grounded in Mexico"
    description="We produce open research on technical AI safety, governance, and policy questions specific to Mexico, in collaboration with national and international institutions."
    breadcrumb={breadcrumb}
    lang="en"
  />

  <!-- 1 · Research areas -->
  <section class="research-section research-section--areas">
    <div class="container">
      <SectionHeading
        eyebrow="Lines of work"
        title="Research areas"
        description="Four fronts where we focus our questions, methods, and publications."
      />
      <FeatureGrid items={researchAreas} />
    </div>
  </section>

  <!-- 2 · Publications -->
  <section id="publicaciones" class="research-section research-section--publications">
    <div class="container">
      <SectionHeading
        eyebrow="Publications"
        title="Papers and published work"
        description="Results that the team and its collaborators release in open venues."
      />

      {publications.length > 0 ? (
        <div class="publication-grid">
          {publications.map((pub: CollectionEntry<'publications'>) => (
            <PublicationCard
              title={pub.data.title}
              authors={pub.data.authors}
              year={pub.data.year}
              journal={pub.data.venue}
              paperUrl={pub.data.paperUrl}
              podcastUrl={pub.data.podcastUrl}
              abstract={enAbstracts[pub.slug] ?? pub.data.abstract}
              lang="en"
            />
          ))}
        </div>
      ) : (
        <p class="research-empty">
          More publications are on the way. In the meantime, write to us if
          you're interested in collaborating on research.
        </p>
      )}
    </div>
  </section>

  <!-- 3 · Ongoing research -->
  <section class="research-section research-section--ongoing">
    <div class="container">
      <SectionHeading
        eyebrow="Ongoing"
        title="Research in progress"
        description="Active team projects and international collaborations."
      />
      <div class="ongoing-grid">
        {ongoingProjects.map((p) => (
          <ProjectCard
            title={p.title}
            badge={p.badge}
            description={p.description}
            href={p.href}
            ctaLabel={p.ctaLabel}
            lang="en"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- 4 · Collaborations (chips) -->
  <section class="research-section research-section--collabs">
    <div class="container">
      <SectionHeading
        eyebrow="Collaborations"
        title="We work with"
        description="Partner organizations that sustain and enrich our research agenda."
      />
      <ul class="partner-chips" role="list">
        {researchPartners.map((partner) => (
          <li class="partner-chips__item">
            {partner.href ? (
              <a
                class="partner-chips__chip partner-chips__chip--link"
                href={partner.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {partner.name}
                <span aria-hidden="true">↗</span>
              </a>
            ) : (
              <span class="partner-chips__chip">{partner.name}</span>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5 · Final CTA -->
  <CtaSection
    title="Let's work together on research"
    description="Have a research question, a dataset, or a collaboration in mind? Let's connect to explore how we could work together."
    ctaLabel="Propose a collaboration"
    ctaHref="/en/get-involved#research"
  />

  <Footer slot="footer" lang="en" />
</BaseLayout>

<style>
  /* Section shell: her 72px rhythm (48px on phones, via --section-pad);
     the hairline between sections comes from base.css (`main > section`). */
  .research-section {
    padding-block: var(--section-pad);
    background: var(--color-bg-section-base);
  }

  /* The page's one tinted band, as her research section (bg-2 with white
     cards). The partner row stays on white so its bg-2 pills read. */
  .research-section--publications {
    background: var(--color-bg-section-warm);
  }

  /* Deep-link target (#publicaciones, from the home «Trabajo reciente»
     publication pill) clears the sticky header, like /activities#gsh-2026. */
  .research-section[id] {
    scroll-margin-top: var(--scroll-offset);
  }

  /* Publication grid: her 2-up card grid, 18px gap, one column up to 768px. */
  .publication-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-grid);
  }

  @media (min-width: 769px) {
    .publication-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Ongoing-projects grid: matches the publication grid. */
  .ongoing-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-grid);
  }

  @media (min-width: 769px) {
    .ongoing-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* A lone card spans the whole row instead of leaving an empty half next
     to it; its copy keeps the 680px reading measure. With two or more
     cards, the 2-up grid applies and the measure is a no-op. */
  @media (min-width: 769px) {
    .publication-grid > :global(:only-child),
    .ongoing-grid > :global(:only-child) {
      grid-column: 1 / -1;
    }
  }

  .publication-grid :global(.publication-card__abstract),
  .ongoing-grid :global(.project-card__description) {
    max-width: var(--measure-desc);
  }

  .research-empty {
    font-size: var(--fs-body);
    line-height: var(--lh-loose);
    color: var(--color-text-secondary);
    max-width: var(--measure-desc);
  }

  /* Partner chips — her .partners-row / .partner: left-aligned row of bg-2
     pills with a 1px hairline, .84rem at 450 in ink-2. */
  .partner-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .partner-chips__item {
    display: inline-flex;
  }

  .partner-chips__chip {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    background: var(--color-bg-warm);
    color: var(--color-text-secondary);
    font-size: 0.84rem;
    font-weight: var(--fw-book);
    line-height: var(--lh-relaxed);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition:
      border-color var(--transition),
      color var(--transition);
  }

  /* Linked partners (external sites) carry her name-plus-↗ mark
     («AISafety.com ↗»; the arrow is aria-hidden), so they read as links at
     rest. Hover darkens the hairline and the label, as her .chip:hover
     does. Nothing lifts; the focus ring comes from base.css. */
  .partner-chips__chip--link {
    gap: 6px;
  }

  .partner-chips__chip--link:hover {
    border-color: var(--color-border-strong);
    color: var(--color-text-primary);
  }
</style>
