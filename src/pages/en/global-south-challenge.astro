---
/**
 * /en/global-south-challenge — English mirror of /global-south-challenge.
 *
 * Spec: docs/I18N-ARCHITECTURE.md §2 (Strategy B) + §7 row 12.
 * Sibling: src/pages/global-south-challenge.astro.
 *
 * Translation notes (per Task #8):
 *  - The GSH is an inherently bilingual event aimed at an international
 *    audience. Both locale pages are first-class — this is not a "back-port
 *    of a Spanish original" but a parallel canonical surface.
 *  - The YouTube channel, the EA Forum retrospective, the Apart Research
 *    collaborator form, and the apartresearch.com sprint URL are PRESERVED
 *    verbatim (same constants as the Spanish page).
 *  - "Mérida", "Guadalajara", "Apart Research", "Apart Fellowship" are
 *    proper names — kept untranslated.
 *  - Dates are rendered in en-US style ("June 19–21, 2026").
 *  - Prize amounts: 3,000 USD / 1,000 USD format preserved.
 *  - The event is over: the band under the hero says so and links the talks
 *    ("Talks on YouTube") and the retrospective ("Read the retrospective").
 *
 * Design ("Editorial mínimo", her event page): 72px
 * sections (48px on phones) closed by the global hairline, left-aligned
 * section headings, white hairline cards on the 18px grid. `--alt` sections
 * take the bg-2 tint and never come two in a row. Only the
 * closing CtaSection is centered. Same structure, ids and styles as the
 * Spanish page.
 *
 * Bands (W = white, T = bg-2 tint): talks band W, mission W, why T,
 * speakers W, judges T, roles W, snapshot T, sponsors W, fellowship W,
 * certificates T, closing CTA W (the external form opens in a new tab).
 * The header marks "Activities", like the breadcrumb.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Card from '../../components/Card.astro';
import GshPersonCard from '../../components/GshPersonCard.astro';
import CtaSection from '../../components/CtaSection.astro';
import type { Breadcrumb } from '../../lib/types';
import { t } from '../../lib/i18n';

const pathname = '/en/global-south-challenge';

const breadcrumb: Breadcrumb = {
  items: [
    { label: t('en', 'breadcrumb.home'), href: '/en' },
    { label: 'Activities', href: '/en/activities' },
    { label: 'Global South AIS Hackathon' },
  ],
};

const collabFormUrl = 'https://forms.gle/SzTHokBh1yaVdM7i7';
const apartUrl =
  'https://apartresearch.com/sprints/global-south-ais-hackathon-2026-06-19-to-2026-06-21';

// Talks + retrospective band (the event already happened).
const youtubeUrl = 'https://www.youtube.com/@AISafetyMéxico';
const retrospectiveUrl =
  'https://forum.effectivealtruism.org/posts/ttePFhSrxpRQu8CR5/running-two-ai-safety-hackathon-hubs-in-mexico-results-costs';

const reasons = [
  {
    title: 'Catalyze talent',
    description:
      'Mentor and evaluate the next generation of AI safety researchers, engineers, and policy professionals from underrepresented regions.',
  },
  {
    title: 'Solve real problems',
    description:
      'Support solutions grounded in regional challenges: AI safety, governance, and accountability across the Global South.',
  },
  {
    title: 'Decentralize the conversation',
    description:
      'Help move the global AI safety agenda beyond a handful of institutions, toward a genuinely international ecosystem.',
  },
  {
    title: 'Build visibility',
    description:
      'Connect with researchers, founders, and policymakers across three continents and gain presence in a growing international initiative.',
  },
];

const roles = [
  {
    title: 'Judges',
    description:
      'Evaluate projects and provide expert feedback. Ideal for researchers, engineers, and policy professionals with AI safety experience.',
  },
  {
    title: 'Mentors',
    description:
      'Share knowledge on AI responsibility, safety, and governance in the Global South across the weekend.',
  },
  {
    title: 'Speakers',
    description:
      'Deliver short talks or workshops on AI safety topics. Broaden the conceptual and practical toolkit of participants.',
  },
  {
    title: 'Volunteers',
    description:
      'Support coordination, logistics, and participant experience at the in-person hubs (Mérida and Guadalajara) and in the remote format.',
  },
  {
    title: 'Sponsors',
    description:
      'Fund prizes, venues, or ecosystem development. Gain prominent visibility in an international AI safety initiative.',
  },
];

const speakers = [{"name":"Damiano Fornasiere","affiliation":"LawZero","photo":"/images/gsh/people/damiano.png","initials":"DF","linkedin":null,"talkUrl":"https://www.youtube.com/watch?v=E0r3JYMjHnI","talkTitle":"From mathematics to technical AI safety","talkDesc":"Shares his path into AI safety and describes his current work at LawZero."},{"name":"Luis Cosio","affiliation":"SL5 Task Force","photo":"/images/gsh/people/luis.jpeg","initials":"LC","linkedin":"https://www.linkedin.com/in/luiscosio/","talkUrl":"https://www.youtube.com/watch?v=CrOqU_i_pT4","talkTitle":"How to build AI that doesn't spiral out of control","talkDesc":"An introduction to AI alignment and why Latin America matters to the field."},{"name":"Nikita Lokhmachev","affiliation":"Greyhaven","photo":"/images/gsh/people/nikita.jpeg","initials":"NL","linkedin":"https://www.linkedin.com/in/nikitalokhmachev-ai/","talkTitle":"Your AI Agent Is Not You: AI safety, data sovereignty, and taking back control","talkDesc":"Your AI agent runs with your permissions, credentials, and file access, guided by a model you didn't train. A talk on AI safety and data sovereignty, with a hands-on demo wrapping Claude Code with Greywall."},{"name":"Camilla Balbis","affiliation":"AIGS Canada · SPAR Research Fellow","photo":"/images/gsh/people/camilla.jpeg","initials":"CB","linkedin":"https://www.linkedin.com/in/camilla-b-a70b69150/","talkTitle":"The Governance Copy-Paste Trap","talkDesc":"How the Global South can learn from the North's missteps on AI safety and governance, and why grassroots, self-determined domestic resilience (not imposed frameworks) is a better path forward."},{"name":"Marcos Galván López","affiliation":"Instituto Politécnico Nacional","photo":"/images/gsh/people/marcos.jpeg","initials":"MG","linkedin":"https://www.linkedin.com/in/marcos-galvan-lopez-4aa20514a","talkTitle":"Prior knowledge as a philosophy to design safe intelligent systems","talkDesc":"How incorporating prior knowledge about the problems we aim to solve helps design AI systems that are safer, more reliable, and auditable."},{"name":"Fernando Castillo","affiliation":"Threat Trackers","photo":"/images/gsh/people/fernando.jpeg","initials":"FC","linkedin":null,"talkTitle":"AI as a cognitive weapon: manipulation, propaganda, and national security in the age of the synthetic society","talkDesc":"How AI turns disinformation into an automated, scalable, personalized system (from bots to deepfakes) and why cognitive defense (critical literacy, algorithmic transparency, responsible regulation) is key to democratic resilience."}];
// Judges: the \u00A0 before «·» in Luis Cosio's label keeps the separator with
// «Force», so the balanced label never starts a line with «·» (320px).
const judges = [{"name":"Cibeles García Burt","affiliation":"USAID","photo":"/images/gsh/people/cibeles.jpeg","initials":"CG","linkedin":"http://www.linkedin.com/in/cibeles-garcia-burt","location":"Mérida, Mexico","bio":"U.S. diplomat with 17 years of experience across Latin America, Africa, and Asia. Now focused on AI governance, with several BlueDot courses completed."},{"name":"Camilla Balbis","affiliation":"AIGS Canada · SPAR Research Fellow","photo":"/images/gsh/people/camilla.jpeg","initials":"CB","linkedin":"https://www.linkedin.com/in/camilla-b-a70b69150/","location":"Toronto, Canada","bio":"Multilingual AI governance policy analyst. Researches with AIGS, combining risk analysis, technology ethics, and international collaboration to strengthen the responsible development of AI."},{"name":"Luis Cosio","affiliation":"SL5 Task Force\u00A0· Member of Technical Staff","photo":"/images/gsh/people/luis.jpeg","initials":"LC","linkedin":"https://www.linkedin.com/in/luiscosio/","location":"Guadalajara, Mexico","bio":"Works at the intersection of frontier AI and high-security systems, turning abstract safety requirements into deployable solutions resilient to real adversaries, including nation-state attacks and loss-of-control scenarios. Winner of multiple Apart hackathons."},{"name":"Nikita Lokhmachev","affiliation":"Greyhaven · Technical Product Lead","photo":"/images/gsh/people/nikita.jpeg","initials":"NL","linkedin":"https://www.linkedin.com/in/nikitalokhmachev-ai/","location":"Mexico","bio":"Senior ML engineer and co-founder with a master's in AI. After Apart hackathons, he shifted his career toward AI safety."},{"name":"Vincent Mai","affiliation":"LawZero · Senior Research Scientist","photo":"/images/gsh/people/vincent.jpeg","initials":"VM","linkedin":"https://www.linkedin.com/in/mai-vincent","location":"Montreal, Canada","bio":"PhD in Machine Learning from Mila."},{"name":"Jesús M. Siqueiros","affiliation":"IIMAS, UNAM","photo":"/images/gsh/people/siqueiros.jpeg","initials":"JS","linkedin":"https://www.linkedin.com/in/jes%C3%BAs-m-siqueiros-garcia-2b79bb14/","location":"Mérida, Mexico","bio":"PhD in Philosophy of Science. He researches participatory modeling, sustainability, and AI. In 2024 he received the Google Academic Research Award for Community Weavers of AI and Nature-based Solutions and leads the Lab-DEMOSS project."},{"name":"Fernando Castillo","affiliation":"Threat Trackers","photo":"/images/gsh/people/fernando.jpeg","initials":"FC","linkedin":null,"location":null,"bio":"Socio-technical cybersecurity researcher working at the intersection of digital security, human rights, democracy, and AI safety. Founder of Threat Trackers, a civil-society organization democratizing cybersecurity for underserved communities."},{"name":"Marcos Galván López","affiliation":"Instituto Politécnico Nacional","photo":"/images/gsh/people/marcos.jpeg","initials":"MG","linkedin":"https://www.linkedin.com/in/marcos-galvan-lopez-4aa20514a","location":null,"bio":"Researcher in neurosymbolic AI, explainable machine learning, and formal and probabilistic reasoning. He integrates neural networks with symbolic methods to build models that are more interpretable, auditable, and reliable. He has conducted research at the University of Edinburgh."},{"name":"Amanda Isbosseth Guzmán Aceves","affiliation":"Government of Jalisco","photo":"/images/gsh/people/amanda.jpeg","initials":"AG","linkedin":"https://www.linkedin.com/in/amanda-isbosseth-guzm%C3%A1n-aceves-54009a202/","location":null,"bio":"Nanotechnology engineer from UdeG. Former Vice President of IEEE CU Tonalá and former Chair of Women in Engineering Guadalajara. Fulbright alumna at UT Dallas and former research intern at ExxonMobil Houston. Winner of ANUIES4MX 2025 with a research stay at ATR Kyoto. She coordinates data science initiatives at Jalisco's Secretaría de Administración."},{"name":"Amaia Amézaga","affiliation":"Sattva Labs · Founder & Independent Researcher","photo":"/images/gsh/people/amaia.jpeg","initials":"AA","linkedin":"https://www.linkedin.com/in/amaia-amezaga/","location":null,"bio":"Independent researcher and founder of Sattva Labs, focused on AI safety, model evaluation, and human-AI interaction. She combines interaction design (HCI), multicultural communication, and qualitative analysis to study how people relate to AI systems."}];
const sponsors = [{"name":"IMET","logo":"/images/gsh/sponsors/imet.png","alt":"IMET"},{"name":"Techmaleon","logo":"/images/gsh/sponsors/techmaleon.png","alt":"Techmaleon"},{"name":"Tec de Software","logo":"/images/gsh/sponsors/tec-de-software.png","alt":"Tec de Software","square":true},{"name":"Universidad Politécnica de Yucatán","logo":"/images/gsh/sponsors/upy.png","alt":"Universidad Politécnica de Yucatán"}];
---

<BaseLayout
  title="Global South AIS Hackathon · AI Safety Mexico × Apart Research"
  description="Regional AI safety hackathon convened by Apart Research and AI Safety Mexico. Mérida, Guadalajara, and remote, June 19–21, 2026. Talks, retrospective, and verifiable certificates."
  pathname={pathname}
  lang="en"
>
  <Header slot="header" currentPath={pathname} navActivePath="/en/activities" lang="en" />

  <PageHero
    title="The Global South AIS Hackathon"
    description="An international hackathon convened by Apart Research and AI Safety Mexico. It brings together researchers, builders, and policy professionals from Latin America, Africa, and Asia to produce concrete work in AI safety, anchored in regional context."
    breadcrumb={breadcrumb}
    lang="en"
  />

  <!-- 0 · Talks and retrospective (YouTube + EA Forum) -->
  <section class="gsh-register" aria-labelledby="gsh-register-heading">
    <div class="gsh-register__inner">
      <p id="gsh-register-heading" class="gsh-register__lead">
        <span>The hackathon took place on June 19–21, 2026.</span>
        <span>Pre-talks and talks are on YouTube.</span>
      </p>
      <div class="gsh-register__actions">
        <a
          class="gsh-register__cta btn btn-primary btn-hero"
          href={youtubeUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Talks on YouTube
        </a>
        <a
          class="gsh-register__cta btn btn-outline btn-hero"
          href={retrospectiveUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Read the retrospective
        </a>
      </div>
    </div>
  </section>

  <!-- 1 · Mission -->
  <section class="gsh-section gsh-section--base" aria-labelledby="gsh-mission-heading">
    <div class="gsh-section__inner">
      <SectionHeading
        id="gsh-mission-heading"
        eyebrow="The mission"
        title="What is this hackathon?"
        description="An intensive weekend to develop prototypes, evaluations, and governance proposals in AI safety, connecting the Global South community with international researchers and mentors."
      />

      <div class="gsh-mission">
        <p class="gsh-mission__lead">
          Organized by <strong>Apart Research</strong> and <strong>AI Safety
          Mexico</strong> as the regional partner, this initiative decentralizes
          AI governance and technical research, elevating local expertise onto
          the global stage.
        </p>

        <blockquote class="gsh-mission__quote">
          <p>
            AI safety cannot be solved from a single region. The Global South
            brings irreplaceable context, expertise, and perspectives to this
            conversation.
          </p>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- 2 · Why it matters -->
  <section class="gsh-section gsh-section--alt" aria-labelledby="gsh-why-heading">
    <div class="gsh-section__inner">
      <SectionHeading
        id="gsh-why-heading"
        eyebrow="Why it matters"
        title="Why collaborate?"
        description="Four reasons this hackathon is relevant to those working on AI safety and governance."
      />

      <div class="gsh-grid gsh-grid--2">
        {reasons.map((r) => (
          <Card
            padding="md"
            bordered={true}
            interactive={false}
            elevated={false}
            title={r.title}
            description={r.description}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- 2b · Speakers -->
  <section class="gsh-section gsh-section--base" aria-labelledby="gsh-speakers-heading">
    <div class="gsh-section__inner">
      <SectionHeading
        id="gsh-speakers-heading"
        eyebrow="Talks and workshops"
        title="Speakers"
        description="Voices that joined the hackathon with talks and workshops on AI safety, governance, and data sovereignty."
      />

      <div class="gsh-grid gsh-grid--2">
        {speakers.map((s) => (
          <GshPersonCard
            name={s.name}
            affiliation={s.affiliation}
            photo={s.photo}
            initials={s.initials}
            linkedin={s.linkedin}
            highlight={s.talkTitle}
            body={s.talkDesc}
            talkUrl={s.talkUrl}
            talkLabel="Watch talk"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- 2c · Judges -->
  <section class="gsh-section gsh-section--alt" aria-labelledby="gsh-judges-heading">
    <div class="gsh-section__inner">
      <SectionHeading
        id="gsh-judges-heading"
        eyebrow="Panel"
        title="Judges"
        description="Those who evaluated the projects and gave expert feedback to participating teams."
      />

      <div class="gsh-grid gsh-grid--2">
        {judges.map((j) => (
          <GshPersonCard
            name={j.name}
            affiliation={j.affiliation}
            photo={j.photo}
            initials={j.initials}
            linkedin={j.linkedin}
            location={j.location}
            body={j.bio}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- 3 · Roles -->
  <section class="gsh-section gsh-section--base" aria-labelledby="gsh-roles-heading">
    <div class="gsh-section__inner">
      <SectionHeading
        id="gsh-roles-heading"
        eyebrow="Collaboration roles"
        title="How the community took part"
        description="There were multiple ways to join the event, from one-off mentoring to institutional sponsorship."
      />

      <div class="gsh-grid gsh-grid--3">
        {roles.map((role) => (
          <Card
            padding="md"
            bordered={true}
            interactive={false}
            elevated={false}
            title={role.title}
            description={role.description}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- 4 · The event at a glance -->
  <section class="gsh-section gsh-section--alt" aria-labelledby="gsh-snapshot-heading">
    <div class="gsh-section__inner">
      <SectionHeading
        id="gsh-snapshot-heading"
        eyebrow="Event snapshot"
        title="The event at a glance"
        description="Format, dates, and prizes of the 2026 edition."
      />

      <dl class="gsh-snapshot">
        <div class="gsh-snapshot__item">
          <dt class="gsh-snapshot__label role-label">Format</dt>
          <dd class="gsh-snapshot__value">
            Primarily remote, with in-person hubs in
            <strong>Mérida</strong> and <strong>Guadalajara</strong>, Mexico.
          </dd>
        </div>
        <div class="gsh-snapshot__item">
          <dt class="gsh-snapshot__label role-label">Dates</dt>
          <dd class="gsh-snapshot__value">
            <strong>June 19–21, 2026.</strong> Three intensive days in parallel
            across Latin America, Africa, and Asia.
          </dd>
        </div>
        <div class="gsh-snapshot__item">
          <dt class="gsh-snapshot__label role-label">Prizes</dt>
          <dd class="gsh-snapshot__value">
            <strong>3,000 USD</strong> prize pool: 1,000 USD for each of the three
            winning teams in Latin America.
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- 4b · Sponsors -->
  <section class="gsh-section gsh-section--base" aria-labelledby="gsh-sponsors-heading">
    <div class="gsh-section__inner">
      <SectionHeading
        id="gsh-sponsors-heading"
        eyebrow="Sponsors"
        title="With support from"
        description="Institutions and partners that made the hackathon possible."
      />

      <ul class="gsh-sponsors">
        {sponsors.map((sp) => (
          <li class="gsh-sponsors__item">
            <img
              class:list={['gsh-sponsors__logo', { 'gsh-sponsors__logo--square': sp.square }]}
              src={sp.logo}
              alt={sp.alt}
              loading="lazy"
              decoding="async"
            />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5 · Apart Fellowship -->
  <section class="gsh-section gsh-section--base" aria-labelledby="gsh-fellowship-heading">
    <div class="gsh-section__inner">
      <SectionHeading
        id="gsh-fellowship-heading"
        eyebrow="Apart Fellowship"
        title="Beyond the hackathon"
        description="The Apart Fellowship invites the top teams from every global hub: a pipeline of emerging AI safety talent with continuing mentorship, research opportunities, and professional support."
      />

      <div class="gsh-fellowship-actions">
        <a class="gsh-link inline-link" href={apartUrl} target="_blank" rel="noopener noreferrer">
          Learn about Apart Research
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Certificates -->
  <section class="gsh-section gsh-section--alt" aria-labelledby="gsh-certs-heading">
    <div class="gsh-section__inner">
      <SectionHeading
        id="gsh-certs-heading"
        eyebrow="Recognition"
        title="Verifiable certificates"
        description="If you took part as a speaker, judge, mentor, volunteer, organizer, or participant, your certificate is in the public directory with a verification QR code."
      />

      <div class="gsh-fellowship-actions">
        <a class="gsh-link inline-link" href="/certificados">
          View certificates
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 6 · Final CTA («AI safety» bound by a no-break space, so no line ends
       in «AI» on phones) -->
  <CtaSection
    title={'Support the future of AI\u00A0safety in the Global South'}
    description="Join us in building safer, more contextualized AI systems by supporting the next generation of researchers, builders, and policymakers across three continents."
    ctaLabel="Get in touch to collaborate"
    ctaHref={collabFormUrl}
    ctaExternal
  />

  <Footer slot="footer" lang="en" />
</BaseLayout>

<style>
  /* Her event-page rhythm on the longer Astro page:
     72px sections (48px on phones) closed by the global line-soft hairline
     (base.css `main > section`), left-aligned headings and white hairline
     cards on her 18px grid gap. `--alt` sections take the bg-2 tint; the
     markup never puts two of them in a row. */
  .gsh-section {
    padding-block: var(--section-pad);
  }

  .gsh-section--base {
    background: var(--color-bg-section-base);
  }

  .gsh-section--alt {
    background: var(--color-bg-section-warm);
  }

  .gsh-section__inner {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-padding);
  }

  @media (min-width: 481px) {
    .gsh-section__inner {
      padding-inline: var(--container-padding-md);
    }
  }

  /* ── Talks + retrospective band ──────────────────────────────────── */
  /* Her `.event-hero-footer`: a centered pill row right under the hero,
     here after a short lead that says the event already happened. */
  .gsh-register {
    background: var(--color-bg-base);
    padding-block: var(--section-pad-stats);
  }

  .gsh-register__inner {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-padding);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  @media (min-width: 481px) {
    .gsh-register__inner {
      padding-inline: var(--container-padding-md);
    }
  }

  .gsh-register__lead {
    max-width: var(--measure-sub);
    font-size: var(--fs-lead);
    line-height: var(--lh-loose);
    color: var(--color-text-secondary);
    text-wrap: balance;
  }

  /* One sentence per unit, so the lead breaks between sentences rather
     than inside the date. */
  .gsh-register__lead span {
    display: inline-block;
  }

  .gsh-register__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap-actions);
    margin-top: 22px;
  }

  /* As on her event page, the pills keep their width on phones (220px
     minimum instead of the ≤768px full-width `.btn-hero`), so the pair
     wraps centered. */
  .gsh-register__cta {
    width: auto;
    min-width: 220px;
  }

  /* ── Mission block ───────────────────────────────────────────────── */
  /* On the 680px description measure (about 87 characters per line), so
     the lead and its quote box end on the same edge as the heading's
     description above. */
  .gsh-mission {
    max-width: var(--measure-desc);
  }

  .gsh-mission__lead {
    font-size: var(--fs-lead);
    line-height: var(--lh-loose);
    color: var(--color-text-primary);
    text-wrap: pretty;
  }

  /* The pull statement as her note on a white section: a bg-2 panel with a
     hairline and 8px corners, Inter 500, no side bar and no italic. */
  .gsh-mission__quote {
    margin: var(--space-7) 0 0;
    padding: 22px 24px;
    background: var(--color-bg-warm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .gsh-mission__quote p {
    font-size: 1.05rem;
    font-weight: var(--fw-medium);
    line-height: var(--lh-normal);
    color: var(--color-text-primary);
    text-wrap: pretty;
  }

  /* ── Card grids: 1 column, 2 from 769px, 3 from 1025px ───────────── */
  .gsh-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-grid);
  }

  @media (min-width: 769px) {
    .gsh-grid--2,
    .gsh-grid--3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1025px) {
    .gsh-grid--3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* ── Snapshot: three white hairline cards on the bg-2 band ───────── */
  .gsh-snapshot {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-grid);
  }

  @media (min-width: 769px) {
    .gsh-snapshot {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .gsh-snapshot__item {
    background: var(--color-bg-elevated);
