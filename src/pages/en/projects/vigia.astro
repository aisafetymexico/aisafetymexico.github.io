---
/**
 * /en/projects/vigia — English sibling of src/pages/projects/vigia.astro.
 * Mirrors it 1:1 (sections, design and styles): a summary of the article
 * "VIGIA: A Pipeline to Accelerate AI Governance in Mexico"
 * (/en/blog/vigia-gobernanza-ia-mexico), with the team up front. Every
 * figure comes from the article. The app links use the collection's
 * `externalUrl`, the web app's English edition; team roles are translated
 * through `roleEn`.
 */
import { getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PageHero from '../../../components/PageHero.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import StatBar from '../../../components/StatBar.astro';
import CtaSection from '../../../components/CtaSection.astro';
import { t } from '../../../lib/i18n';

const project = await getEntry('projects', 'vigia');
if (!project) {
  throw new Error('VIGÍA project entry missing in src/content/projects/vigia.md');
}
const data = project.data;

// The VIGÍA web app (the observatory linked from the article) in English.
const platformUrl = data.externalUrl ?? 'https://vigia-3-0-21536470668.us-central1.run.app/en/';
const articleUrl = '/en/blog/vigia-gobernanza-ia-mexico';

// Role translations for the VIGÍA team. Spanish roles in the content collection
// are mapped to their English equivalents.
const roleEn: Record<string, string> = {
  'Cofundadora · Concepción de la plataforma': 'Co-founder · Platform conception',
  'Cofundador · Concepción de la plataforma': 'Co-founder · Platform conception',
  'Diseño': 'Design',
  'Advisory · Curso de Governance': 'Advisory · AI Governance course',
};

// Co-founders take the wider first row of the team grid.
const team = data.team.map((person) => ({
  name: person.name,
  role: roleEn[person.role ?? ''] ?? person.role ?? 'Collaborator',
  lead: (person.role ?? '').startsWith('Cofundador'),
}));

const stats = [
  { number: '153', label: 'DOF issues analyzed' },
  { number: '249', label: 'literal mentions of “artificial intelligence”' },
  { number: '545', label: 'implicit mentions of AI use' },
  { number: '0', label: 'AI risks named as such' },
];

const breadcrumb = {
  items: [
    { label: t('en', 'breadcrumb.home'), href: '/en' },
    { label: 'Projects', href: '/en/projects' },
    { label: 'VIGÍA' },
  ],
};
---

<BaseLayout
  title="VIGÍA · Project · AI Safety Mexico"
  description="VIGÍA is a pipeline to make AI risks visible in Mexico's official discourse. Its first implementation analyzed 153 issues of the Diario Oficial de la Federación, Mexico's official gazette."
  lang="en"
  pathname="/en/projects/vigia"
  ogImage={data.cover?.src as string | undefined}
>
  <Header slot="header" navActivePath="/en/projects" lang="en" />

  <PageHero
    title="VIGÍA"
    description="A pipeline to make AI risks visible in official discourse and accelerate AI Governance in Mexico."
    breadcrumb={breadcrumb}
    lang="en"
  />

  {/* Team */}
  <section class="section section--warm" aria-labelledby="vigia-team-heading">
    <div class="container">
      <SectionHeading
        eyebrow="Team"
        title="The people behind VIGÍA"
        id="vigia-team-heading"
      />
      <ul class="vigia-team" role="list">
        {team.map((person) => (
          <li class:list={['vigia-team__card', { 'vigia-team__card--lead': person.lead }]}>
            <h3 class="vigia-team__name">{person.name}</h3>
            <p class="vigia-team__role">{person.role}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* The problem */}
  <section class="section section--base" aria-labelledby="vigia-problem-heading">
    <div class="container project-column">
      <p class="vigia-source">
        A summary of the article
        <a href={articleUrl}>“VIGIA: A Pipeline to Accelerate AI Governance in Mexico”</a>,
        by Pilar Moncada and Max Pinelo.
      </p>
      <SectionHeading
        eyebrow="The problem"
        title="What is not mentioned does not exist"
        id="vigia-problem-heading"
      />
      <div class="prose">
        <p>
          Mexico uses frontier AI but does not produce it, and an AI safety
          vocabulary barely exists in the country. As a result, AI risks are not
          named in official discourse and remain invisible to those who could
          drive their regulation.
        </p>
        <p>
          The article calls this invisibilization a <strong>higher-order
          risk</strong>: it causes no harm by itself, but it keeps first-order
          harms, such as failures, discrimination or surveillance, from being
          noticed and corrected. It also hides itself: a document with no
          mention of bias or human oversight does not look incomplete, it looks
          normal.
        </p>
        <p>
          It is not the only bottleneck for AI Governance in Mexico, but it is an
          important one, upstream of several of the others.
        </p>
      </div>
    </div>
  </section>

  {/* The proposal */}
  <section class="section section--warm" aria-labelledby="vigia-pipeline-heading">
    <div class="container project-column">
      <SectionHeading
        eyebrow="The proposal"
        title="A six-step pipeline"
        description="To clear that bottleneck, the pipeline analyzes official and public discourse and makes AI risks visible."
        id="vigia-pipeline-heading"
      />
      <ol class="vigia-steps">
        <li>Identify the documents where the State publishes its AI initiatives and uses.</li>
        <li>Find the mentions of AI use in them, explicit and implicit.</li>
        <li>Classify the risk associated with each mention into 15 categories.</li>
        <li>Report each finding: why it is a risk, how urgent it is, and initial recommendations.</li>
        <li>Prepare reports for researchers, legislators and the general public.</li>
        <li>Measure how far the AI risk lexicon is adopted in public discourse, for example in digital newspapers.</li>
      </ol>
    </div>
  </section>

  {/* The implementation */}
  <section class="section section--base" aria-labelledby="vigia-implementation-heading">
    <div class="container project-column">
      <SectionHeading
        eyebrow="The implementation"
        title="VIGÍA analyzes Mexico's official gazette"
        id="vigia-implementation-heading"
      />
      <div class="prose">
        <p>
          <strong>VIGÍA</strong> (<em lang="es">Valoración de Impactos
          Gubernamentales de IA</em>, Assessment of Governmental Impacts of AI)
          is the first implementation of the pipeline, built for Mexico. It uses
          the <span lang="es">Diario Oficial de la Federación</span> (DOF),
          Mexico's official gazette, because that is where the acts of the
          Mexican State acquire legal validity: a use of AI published in the DOF
          is no longer a plan but a fact of government with a date and a
          signature. It is also public and downloadable, so the exercise can be
          reproduced.
        </p>
        <p>
          A language model (Claude Opus 4.8) read 153 complete issues of the
          morning edition, from 3 November 2025 to 12 June 2026. For each
          mention of AI use it records the original fragment, its location, the
          risk categories with their severity and one or more recommendations.
          Steps 5 and 6 are outside the scope of this first iteration.
        </p>
      </div>
      <div class="program-actions">
        <a class="btn btn-primary" href={platformUrl} target="_blank" rel="noopener noreferrer">
          Open the VIGÍA app
          <span aria-hidden="true">↗</span>
        </a>
        <a class="btn btn-outline" href={articleUrl}>Read the full article</a>
      </div>
    </div>
  </section>

  <StatBar stats={stats} label="VIGÍA in numbers" />

  {/* Results */}
  <section class="section section--warm" aria-labelledby="vigia-results-heading">
    <div class="container project-column">
      <SectionHeading
        eyebrow="Results"
        title="The risk lexicon is absent"
        id="vigia-results-heading"
      />
      <div class="prose">
        <p>
          Of 18 terms from the AI risk vocabulary, 16 do not appear even once in
          the 153 issues. The three cases that do appear come from two public
          research centers and a bibliographic citation, none of them a
          regulator.
        </p>
        <p>
          When AI appears, it is almost always as a capability or benefit (72.7%
          of mentions) or as a purchase line item (11.7%). Only 18 mentions treat
          it as a source of harm, and all of them borrow the framing of an
          earlier legal regime, such as copyright or academic integrity.
        </p>
        <p>
          Of the model's 665 findings, 636 (95.6%) flag a regulatory gap. The
          most frequent risks are privacy invasion, discrimination and bias,
          failures and errors, and authoritarian surveillance, and 50 of the 153
          issues were marked as requiring urgent attention.
        </p>
        <p>
          One example: on 29 May 2026 the Technical Committee of the Coatlicue
          supercomputer was created, the most explicitly AI-oriented instrument
          in the corpus. It contains no provision on permitted uses, model
          evaluation or access.
        </p>
      </div>
    </div>
  </section>

  {/* Next steps */}
  <section class="section section--base" aria-labelledby="vigia-next-heading">
    <div class="container project-column">
      <SectionHeading
        eyebrow="What comes next"
        title="Limitations and next steps"
        id="vigia-next-heading"
      />
      <div class="prose">
        <p>
          This is a first version. A single language model did all the analysis,
          with no second model to compare against, and the documents are
          enormous: the median DOF issue is around 389 pages. The risk
          categories also come from frameworks of countries that produce
          frontier AI and may not capture everything that matters in a country
          like Mexico.
        </p>
        <p>
          The next steps are to validate the classification with a second model
          and human reviewers, prepare reports for those who drive AI
          Governance, and measure how far the risk lexicon circulates in public
          discourse. The pipeline can be replicated in other countries that use
          frontier AI without producing it, and in the future it can support a
          defense strategy for Mexico through regulation.
        </p>
      </div>
    </div>
  </section>

  <CtaSection
    title="Explore the observatory"
    description="The results of this first implementation are published in the VIGÍA app."
    ctaLabel="Open the VIGÍA app"
    ctaHref={platformUrl}
    ctaExternal={true}
  />

  <Footer slot="footer" lang="en" />
</BaseLayout>

<style>
  /* Identical to the Spanish sibling's <style>. */
  .project-column > :global(*) {
    max-width: var(--measure-desc);
  }

  .project-column > :global(:last-child) {
    margin-bottom: 0;
  }

  .vigia-team {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gap-grid);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vigia-team__card {
    padding: var(--pad-card);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .vigia-team__name {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-size: var(--fs-h4);
    font-weight: var(--fw-heading);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-heading);
    color: var(--color-text-heading);
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .vigia-team__card--lead .vigia-team__name {
    font-size: var(--fs-h2);
  }

  .vigia-team__role {
    margin: 0;
    font-size: var(--fs-small);
    line-height: var(--lh-normal);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  @media (min-width: 48.0625em) {
    .vigia-team {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .vigia-team__card {
      grid-column: span 2;
    }

    .vigia-team__card--lead {
      grid-column: span 3;
    }
  }

  .vigia-source {
    margin: 0 0 var(--space-8);
    font-size: var(--fs-small);
    line-height: var(--lh-normal);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .prose p {
    font-size: var(--fs-body);
    line-height: var(--lh-loose);
    text-wrap: pretty;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-3);
  }

  .prose p:last-child {
    margin-bottom: 0;
  }

  .prose strong {
    color: var(--color-text-primary);
    font-weight: var(--fw-semibold);
  }

  .vigia-steps {
    margin: 0;
    padding-left: 1.4em;
    color: var(--color-text-secondary);
    font-size: var(--fs-body);
    line-height: var(--lh-loose);
  }

  .vigia-steps li {
    padding-left: 0.3em;
    text-wrap: pretty;
  }

  .vigia-steps li + li {
    margin-top: var(--space-2);
  }

  .vigia-steps li::marker {
    color: var(--color-text-heading);
    font-weight: var(--fw-semibold);
  }

  .project-column .program-actions {
    margin-top: var(--space-6);
  }
</style>
