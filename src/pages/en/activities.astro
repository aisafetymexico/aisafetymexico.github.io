---
/*
 * /en/activities — English mirror of /activities.
 *
 * Spec: docs/I18N-ARCHITECTURE.md §2 (Strategy B sibling page files) + §7 row 9.
 * Sibling: src/pages/activities.astro (Spanish source-of-truth structure).
 *
 * Structural parity with the Spanish page is mandatory — every section,
 * heading hierarchy, anchor id (#proximo-evento, #gsh-2026) and component
 * composition mirrors the original 1:1. Only prose is translated; URLs
 * (/en/*), image assets, and external links are preserved (the GSH poster
 * image, the Luma, YouTube and EA Forum URLs, etc.).
 *
 * Design notes live in the Spanish sibling's docblock; the <style> rules are
 * identical in both files.
 *
 * Translation notes (per Task #8 guidelines):
 *  - The panel's official title "Impulsando la comunidad de AI Safety en
 *    México: Tech Policy Panel" is the event's name on Luma, so it stays in
 *    Spanish (card title and the Luma embed title). The card title is marked
 *    lang="es" (Card `titleLang`); the iframe title is an attribute and
 *    cannot carry a lang, so it stays as is.
 *  - "Workshop · Your AI Agent Is Not You" was authored in English upstream
 *    and is preserved verbatim (label and talk name on two lines, as in
 *    /activities).
 *  - "ML4Good" and "EAGxCDMX" are proper names — kept untranslated.
 *  - Month names rendered in English (per architecture §7.7).
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Card from '../../components/Card.astro';
import ActivityCard from '../../components/ActivityCard.astro';
import CtaSection from '../../components/CtaSection.astro';
import type { Breadcrumb, CtaRef, ImgRef } from '../../lib/types';
import { t } from '../../lib/i18n';

// -------- Breadcrumb --------
const breadcrumb: Breadcrumb = {
  items: [
    { label: t('en', 'breadcrumb.home'), href: '/en' },
    { label: 'Activities' },
  ],
};

// -------- Shared external links --------
const LUMA_CALENDAR = 'https://luma.com/calendar/cal-WjnM2llUGXz17t5';
const YOUTUBE_CHANNEL = 'https://www.youtube.com/@AISafetyMéxico';

/** target/rel for links that leave the site. */
const externalAttrs = (external?: boolean) =>
  external ? { target: '_blank', rel: 'noopener noreferrer' } : {};

// -------- Upcoming event: Mexico Tech Week 2026 (#proximo-evento) --------
// Her "Actividades en curso" panel card (fcacfc4 index.html L144–164). The
// SectionHeading above already names the event and the BlueDot grant, so the
// card starts with the panel title (no in-card label). The first pill links
// straight to the Luma event page, so registering does not depend on the
// third-party embed loading (same label and accent as the home spotlight).
// EXPIRES 2026-10-27: after the panel, move it to a past activity here, on
// /activities and on both home pages (the register pill goes with it).
// Two-word names that must not split across lines («AI Safety», «AI House»,
// «Oscar Mata», «EA Forum», «First Friday») are bound with a no-break space
// (\u00A0) in the strings below; the working-sessions title and the
// #gsh-2026 badge also bind their «·» to the word before it, so no line
// starts with «·». Each bind stays at two words, so it still fits a card
// at 200% text.
type UpcomingEvent = {
  title: string;
  description: string;
  date: { iso: string; label: string };
  venue: string;
  organizers: string;
  actions: CtaRef[];
  embed: { src: string; title: string };
};

const upcomingEvent: UpcomingEvent = {
  title: 'Impulsando la comunidad de AI\u00A0Safety en México: Tech Policy Panel',
  description:
    'Growing the AI safety community in Mexico: a panel on how AI regulation will affect the tech ecosystem in Mexico and Latin America.',
  date: { iso: '2026-10-27', label: 'Tuesday, October 27, 2026' },
  venue: 'MXTW AI\u00A0House, Juárez, Mexico City',
  organizers: 'Organized by Marta Kosmyna, Isabel Montalvo, Janeth Valdivia, and Oscar\u00A0Mata',
  actions: [
    { label: 'Register on Luma', href: 'https://luma.com/event/evt-0jdNWFu6jYVQ148', variant: 'register', external: true },
    { label: 'Events calendar', href: LUMA_CALENDAR, variant: 'outline', external: true },
    { label: 'Talks on YouTube', href: YOUTUBE_CHANNEL, variant: 'outline', external: true },
  ],
  embed: {
    src: 'https://luma.com/embed/event/evt-0jdNWFu6jYVQ148/simple',
    title: 'Registration for the panel Impulsando la comunidad de AI Safety en México',
  },
};

// -------- Mesas de trabajo (recurrente) --------
// Whole-card link to the Luma calendar; `linkLabel` is its visible pill, with
// the label the #proximo-evento pill uses for the same URL.
const recurring = {
  title: 'Working sessions\u00A0· First\u00A0Friday of the month',
  date: 'Recurring',
  description:
    "Dates, venue, and registration for each session — and for the rest of our agenda — are on AI Safety Mexico's Luma calendar.",
  link: LUMA_CALENDAR,
  linkLabel: 'Events calendar',
  external: true,
};

// -------- Past activity: Global South AIS Hackathon (#gsh-2026) --------
// Her "Actividades Pasadas" block (fcacfc4 index.html L220–237), with the
// EA Forum retrospective as the main link.
type PastActivity = {
  image: ImgRef;
  badge: string;
  title: string;
  paragraphs: string[];
  links: CtaRef[];
};

const gshRecap: PastActivity = {
  image: {
    src: '/images/gsh-event-card.png',
    alt: 'Promotional image for the Global South AIS Hackathon.',
  },
  badge: 'Apart Research × AI\u00A0Safety Mexico\u00A0· EA\u00A0Forum',
  title: 'The Global South AI\u00A0Safety Hackathon: Mérida and Guadalajara hubs',
  paragraphs: [
    "We organized the hackathon's Mexican hubs together with Apart Research: two simultaneous hubs in Mérida and Guadalajara plus remote participation, with 65 attendees who formed 19 teams and submitted 19 research projects.",
    "One project placed in the global top 20% and four in the top 50%, even though no participant arrived with publications or prior experience in AI safety. One of them, on AI sovereignty and vulnerability in a middle power, continued into Apart Research's fellowship program.",
  ],
  links: [
    {
      label: 'Read the retrospective',
      href: 'https://forum.effectivealtruism.org/posts/ttePFhSrxpRQu8CR5/running-two-ai-safety-hackathon-hubs-in-mexico-results-costs',
      variant: 'secondary',
      external: true,
    },
    { label: 'Event page', href: '/en/global-south-challenge', variant: 'outline' },
    { label: 'Pre-talks and talks', href: YOUTUBE_CHANNEL, variant: 'outline', external: true },
  ],
};

// -------- Conferences & talks --------
// Each title puts its label and «·» on line 1 and the name on line 2 (the
// "\n", kept by `white-space: pre-line` in the <style> below). The name wraps
// inside the card at any text size: binding it whole with no-break spaces
// would push it past the card's overflow:hidden edge at 200% text (WCAG
// 1.4.4), so only the two-word «AI Safety» stays bound. `linkLabel` is the
// visible pill of a linked card (her `.event-preview-link`).
type ConfTalk = {
  title: string;
  date?: string;
  description: string;
  link?: string;
  linkLabel?: string;
  external?: boolean;
  image?: { src: string; alt: string };
};

const conferencesAndTalks: ConfTalk[] = [
  {
    title: 'Workshop ·\nYour AI Agent Is Not You',
    date: '2026',
    description:
      'Hands-on workshop in collaboration with Greywall on boundaries, identity, and the safety of AI agents. A guided session with Claude Code live, followed by a discussion of responsible deployment patterns.',
    link: 'https://luma.com/l0fumrub',
    linkLabel: 'Event page',
    external: true,
  },
  {
    title: 'EAGxCDMX ·\nNot so speedy AI\u00A0Safety',
    date: '2025',
    description:
      'Workshop delivered by Silvia Fernández, Angel, and Max at EAGxCDMX. A critical introduction to the technical and political decisions that pause, accelerate, or redirect AI safety agendas.',
  },
  {
    title: 'Advanced training ·\nML4Good',
    date: '2025',
    description:
      'Intensive international bootcamp on technical AI safety. Angel, Max, Isabel, and Janeth attended as part of the regional cohort.',
  },
];

---

<BaseLayout
  title="Activities — AI Safety Mexico"
  description="Current and past activities of AI Safety Mexico: hackathons, working sessions, conferences, workshops, and advanced training."
  pathname="/en/activities"
  lang="en"
>
  <Header slot="header" currentPath="/en/activities" lang="en" />

  <PageHero
    title="Current and past activities"
    description="A public record of AI Safety Mexico: active events, recurring working sessions, conferences, workshops, and training programs that have shaped our trajectory."
    breadcrumb={breadcrumb}
    lang="en"
  />

  <!-- Upcoming event: Mexico Tech Week 2026 -->
  <section
    id="proximo-evento"
    class="page-section page-section--alt"
    aria-labelledby="activities-spotlight"
  >
    <div class="container">
      <SectionHeading
        eyebrow="Upcoming event"
        title="Mexico Tech Week 2026"
        description="A tech policy panel funded by a BlueDot Impact grant."
        id="activities-spotlight"
      />
      <div class="card-column">
        <Card
          title={upcomingEvent.title}
          titleLang="es"
          description={upcomingEvent.description}
          bordered
          interactive={false}
          elevated={false}
          padding="md"
        >
          <p class="event-meta">
            <time datetime={upcomingEvent.date.iso}>{upcomingEvent.date.label}</time> · {upcomingEvent.venue}
          </p>
          <p class="event-meta">{upcomingEvent.organizers}</p>
          <div class="program-actions">
            {upcomingEvent.actions.map((cta) => (
              <a
                class={`btn btn-${cta.variant ?? 'outline'}`}
                href={cta.href}
                {...externalAttrs(cta.external)}
              >
                {cta.label}
              </a>
            ))}
          </div>
          <div class="event-embed">
            <iframe
              src={upcomingEvent.embed.src}
              title={upcomingEvent.embed.title}
              allow="fullscreen; payment"
              loading="lazy"
            ></iframe>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- Recurring working sessions -->
  <section class="page-section" aria-labelledby="activities-recurring">
    <div class="container">
      <SectionHeading
        eyebrow="Ongoing"
        title="Recurring working sessions"
        description="A standing forum where the team and invited guests discuss project progress, readings, and open questions."
        id="activities-recurring"
      />
      <div class="card-column">
        <ActivityCard
          title={recurring.title}
          date={recurring.date}
          description={recurring.description}
          link={recurring.link}
          linkLabel={recurring.linkLabel}
          external={recurring.external}
        />
      </div>
    </div>
  </section>

  <!-- Past activity: Global South AIS Hackathon -->
  <section id="gsh-2026" class="page-section" aria-labelledby="activities-gsh">
    <div class="container">
      <SectionHeading
        eyebrow="Past activity"
        title="Global South AIS Hackathon"
        description="June 19–21, 2026 · with Apart Research."
        id="activities-gsh"
      />
      <div class="card-column card-column--poster">
        <Card
          image={gshRecap.image}
          badge={gshRecap.badge}
          title={gshRecap.title}
          bordered
          interactive={false}
          elevated={false}
          padding="md"
        >
          {gshRecap.paragraphs.map((text) => <p>{text}</p>)}
          <Fragment slot="footer">
            {gshRecap.links.map((cta) => (
              <a
                class={`btn btn-${cta.variant ?? 'outline'}`}
                href={cta.href}
                {...externalAttrs(cta.external)}
              >
                {cta.label}
              </a>
            ))}
          </Fragment>
        </Card>
      </div>
    </div>
  </section>

  <!-- Conferences and talks -->
  <section class="page-section page-section--alt" aria-labelledby="activities-conferences">
    <div class="container">
      <SectionHeading
        eyebrow="Track record"
        title="Conferences, workshops, and training"
        description="A representative selection of events the team has delivered, attended, or co-organized."
        id="activities-conferences"
      />
      <div class="conf-grid">
        {conferencesAndTalks.map(item => (
          <ActivityCard
            title={item.title}
            date={item.date}
            description={item.description}
            image={item.image}
            link={item.link}
            linkLabel={item.linkLabel}
            external={item.external}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="page-section" aria-labelledby="activities-gallery">
    <div class="container">
      <SectionHeading
        eyebrow="Gallery"
        title="Images from our activities"
        description="A visual sample of the team's work and the venues we've been part of."
        id="activities-gallery"
      />
      <img
        class="activities-photo"
        src="/images/sesion-trabajo.webp"
        width="2048"
        height="1432"
        loading="lazy"
        decoding="async"
        alt="AI Safety Mexico participants in a working session, seated in a circle"
      />
    </div>
  </section>

  <CtaSection
    title="Would you like to organize an event with us?"
    description="We collaborate with institutions, communities, and international allies to produce workshops, working sessions, and public events on AI safety."
    ctaLabel="Propose an event"
    ctaHref="/en/get-involved#events"
  />

  <Footer slot="footer" lang="en" />
</BaseLayout>

<style>
  /* Section shells — her .section-* : 72px top and bottom (48px on phones),
     white or bg-2, closed by the global line-soft hairline (base.css
     `main > section`). Tinted: #proximo-evento (her .section-current) and
     the conferences grid, so two tints are never adjacent. */
  .page-section {
    padding-block: var(--section-pad);
    background: var(--color-bg-section-base);
  }

  .page-section--alt {
    background: var(--color-bg-section-warm);
  }

  /* Deep-link targets (#proximo-evento, #gsh-2026) clear the sticky header. */
  .page-section[id] {
    scroll-margin-top: var(--scroll-offset);
  }

  /* Single-card sections: the card runs the full container like her
     .program-card / .event-preview (fcacfc4 index), so it shares both edges
     of the SectionHeading above. The copy inside keeps her
     reading measure. */
  .card-column :global(.card__description),
  .card-column :global(.card__body > p) {
    max-width: var(--measure-desc);
  }

  .card-column :global(.activity-card__description) {
    max-width: var(--measure-sub);
  }

  /* #gsh-2026 poster: show the 3:2 promotional image whole; Card's default
     16:9 media box would crop the text printed near its edges. From 769px
     the card is a row, with the framed poster on the left and the text on
     the right, so the poster is not a full-width block (up to 1024px the
     poster takes 42% to leave the text room); below that it stacks. */
  .card-column--poster :global(.card .card__media) {
    aspect-ratio: 3 / 2;
  }

  @media (min-width: 769px) {
    .card-column--poster :global(.card) {
      flex-direction: row;
      align-items: center;
    }

    .card-column--poster :global(.card .card__media) {
      flex: 0 0 46%;
      margin-left: 28px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
    }

    .card-column--poster :global(.card .card__body) {
      flex: 1 1 auto;
      min-width: 0;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .card-column--poster :global(.card .card__media) {
      flex-basis: 42%;
    }
  }

  /* Luma embed: while the third-party frame is blocked or still loading it
     reads as a bg-2 panel, not a white void. The «Register on Luma» pill
     above works without it. */
  #proximo-evento :global(.event-embed iframe) {
    background: var(--color-bg-warm);
  }

  /* Panel meta lines — her .event-meta as it renders inside .program-card
     (.88rem, ink-2, lh 1.7). Card's 10px body gap
     spaces them; the other slotted <p>s, the action row, the Luma embed and
     the footer pills take Card's own card-copy and 18px rhythm. `pretty`
     avoids a short last line, such as a lone surname. */
  .event-meta {
    font-size: var(--fs-small);
    line-height: var(--lh-loose);
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  /* Conferences and talks — 1 / 2 / 3 columns at her tiers, 18px gaps.
     In the 2-up tier an odd last card spans the whole row instead of
     sitting alone in half of it; the blurbs keep her sub measure there.
     Titles honour the "\n" after their «·» (label on line 1, name on
     line 2), and the name still wraps inside the card. The forced break
     turns off the h3's `balance` in Chromium, so `pretty` keeps a wrapped
     name from leaving one word alone («You» at 150–200% text). */
  .conf-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-grid);
  }

  .conf-grid :global(.activity-card__title) {
    white-space: pre-line;
    text-wrap: pretty;
  }

  .conf-grid :global(.activity-card__description) {
    max-width: var(--measure-sub);
  }

  @media (min-width: 769px) {
    .conf-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .conf-grid > :global(:last-child:nth-child(odd)) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1025px) {
    .conf-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Gallery — one photo, framed like the home page's feature photo: full
     container width, large radius, hairline frame. */
  .activities-photo {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
</style>
