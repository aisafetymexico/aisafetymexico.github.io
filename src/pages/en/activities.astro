---
/*
 * /en/activities — English mirror of /activities.
 *
 * Spec: docs/I18N-ARCHITECTURE.md §2 (Strategy B sibling page files) + §7 row 9.
 * Sibling: src/pages/activities.astro (Spanish source-of-truth structure).
 *
 * Structural parity with the Spanish page is mandatory — every section,
 * heading hierarchy, anchor id (#proximo-evento, #gsh-2026) and component
 * composition mirrors the original 1:1. Only prose is translated; URLs
 * (/en/*), image assets, and external links are preserved (the GSH poster
 * image, the Luma, YouTube and EA Forum URLs, etc.).
 *
 * Design notes live in the Spanish sibling's docblock; the <style> rules are
 * identical in both files.
 *
 * Translation notes (per Task #8 guidelines):
 *  - The upcoming event is Apart Research's "AI x Epistemics Research
 *    Sprint" (an English proper name); the card covers AI Safety Mexico's
 *    in-person Mérida site. The Luma registration embed lives on
 *    /en/ai-x-epistemics, not here.
 *  - The Mexico Tech Week panel is now a past activity in the conferences
 *    grid. ActivityCard cannot mark a lang, so the card is titled by the
 *    event and the English part of the official name ("Mexico Tech Week ·
 *    Tech Policy Panel") and glosses the Spanish title in English ("Growing
 *    the AI safety community in Mexico"), as the old upcoming-event card did.
 *  - "Workshop · Your AI Agent Is Not You" was authored in English upstream
 *    and is preserved verbatim (label and talk name on two lines, as in
 *    /activities).
 *  - "ML4Good" and "EAGxCDMX" are proper names — kept untranslated.
 *  - Month names rendered in English (per architecture §7.7).
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Card from '../../components/Card.astro';
import ActivityCard from '../../components/ActivityCard.astro';
import CtaSection from '../../components/CtaSection.astro';
import type { Breadcrumb, CtaRef, ImgRef } from '../../lib/types';
import { t } from '../../lib/i18n';

// -------- Breadcrumb --------
const breadcrumb: Breadcrumb = {
  items: [
    { label: t('en', 'breadcrumb.home'), href: '/en' },
    { label: 'Activities' },
  ],
};

// -------- Shared external links --------
const LUMA_CALENDAR = 'https://luma.com/calendar/cal-WjnM2llUGXz17t5';
const YOUTUBE_CHANNEL = 'https://www.youtube.com/@AISafetyMéxico';

/** target/rel for links that leave the site. */
const externalAttrs = (external?: boolean) =>
  external ? { target: '_blank', rel: 'noopener noreferrer' } : {};

// -------- Upcoming event: AI x Epistemics Research Sprint (#proximo-evento) --------
// The #gsh-2026 poster card (Card with a framed image beside the copy), with
// the sprint's square cover. The SectionHeading names the sprint; the card is
// about AI Safety Mexico's in-person Mérida site: the two `.event-meta` lines
// (dates · place; organizers), the two-step note and two pills. The first
// opens the two-step application on /en/ai-x-epistemics (#registro: Apart's
// sign-up and the Cursor Hackathon's Luma form), with the home spotlight's
// label and accent; no pill leads to a form elsewhere, so there is one way
// to apply. The date line is two <time>s, one per end of the range, joined
// by an en dash and a word joiner (&#8288;, U+2060), so it never breaks as
// «13– / 15». The cover sits right under the PageHero, above the fold on
// desktop (the page's LCP image), so the Card loads it eagerly.
// EXPIRES 2026-11-12: AISMx's internal deadline for in-person requests.
// From the 13th, drop the "Apply in two steps" pill (let "Sprint details"
// lead as the `register` pill) and rewrite the note (in-person requests
// have closed), here and on /activities.
// EXPIRES 2026-11-15: after the sprint, move it to a past activity here (like
// #gsh-2026), on /activities and on both home pages, and put the next event
// in this slot (or drop the section until there is one).
// Two-word names that must not split across lines («AI Safety», «AI House»,
// «Oscar Mata», «EA Forum», «First Friday») are bound with a no-break space
// (\u00A0) in the strings below; the working-sessions title and the
// #gsh-2026 badge also bind their «·» to the word before it, so no line
// starts with «·». Each bind stays at two words, so it still fits a card
// at 200% text. «in-person» takes a non-breaking hyphen (\u2011, as /contact
// does for «in-house»), so it never breaks as «in- / person».
type EventDate = { iso: string; label: string };

type UpcomingEvent = {
  image: ImgRef;
  badge: string;
  title: string;
  description: string;
  paragraphs: string[];
  /** The two ends of the range, each with its machine-readable date. */
  dates: { start: EventDate; end: EventDate };
  place: string;
  organizers: string;
  actions: CtaRef[];
};

const upcomingEvent: UpcomingEvent = {
  image: {
    src: '/images/ai-x-epistemics/sprint-cover.webp',
    width: 800,
    height: 800,
    alt: 'Sprint cover: the title AI x Epistemics Research Sprint over a halftone photo of El Caracol, the Maya observatory at Chichén Itzá, and the credit Apart Research x AI Safety México.',
  },
  badge: 'Apart Research × AI\u00A0Safety Mexico',
  title: 'In\u2011person site in Mérida',
  description:
    'Three days to build benchmarks, verification signals, and products that help us decide better what to believe. The Mérida site is free, and no prior experience is needed.',
  paragraphs: [
    'Spots are limited: apply in two steps by November\u00A012.',
  ],
  dates: {
    start: { iso: '2026-11-13', label: 'November 13' },
    end: { iso: '2026-11-15', label: '15, 2026' },
  },
  place: 'Mérida and online',
  organizers: 'Organized by Apart Research and AI\u00A0Safety Mexico (Mérida site)',
  actions: [
    { label: 'Apply in two steps', href: '/en/ai-x-epistemics#registro', variant: 'register' },
    { label: 'Sprint details', href: '/en/ai-x-epistemics', variant: 'outline' },
  ],
};

// -------- Mesas de trabajo (recurrente) --------
// Whole-card link to the Luma calendar; `linkLabel` is its visible pill.
const recurring = {
  title: 'Working sessions\u00A0· First\u00A0Friday of the month',
  date: 'Recurring',
  description:
    "Dates, venue, and registration for each session — and for the rest of our agenda — are on AI Safety Mexico's Luma calendar.",
  link: LUMA_CALENDAR,
  linkLabel: 'Events calendar',
  external: true,
};

// -------- Past activity: Global South AIS Hackathon (#gsh-2026) --------
// Her "Actividades Pasadas" block (fcacfc4 index.html L220–237), with the
// EA Forum retrospective as the main link.
type PastActivity = {
  image: ImgRef;
  badge: string;
  title: string;
  paragraphs: string[];
  links: CtaRef[];
};

const gshRecap: PastActivity = {
  image: {
    src: '/images/gsh-event-card.png',
    alt: 'Promotional image for the Global South AIS Hackathon.',
  },
  badge: 'Apart Research × AI\u00A0Safety Mexico\u00A0· EA\u00A0Forum',
  title: 'The Global South AI\u00A0Safety Hackathon: Mérida and Guadalajara hubs',
  paragraphs: [
    "We organized the hackathon's Mexican hubs together with Apart Research: two simultaneous hubs in Mérida and Guadalajara plus remote participation, with 65 attendees who formed 19 teams and submitted 19 research projects.",
    "One project placed in the global top 20% and four in the top 50%, even though no participant arrived with publications or prior experience in AI safety. One of them, on AI sovereignty and vulnerability in a middle power, continued into Apart Research's fellowship program.",
  ],
  links: [
    {
      label: 'Read the retrospective',
      href: 'https://forum.effectivealtruism.org/posts/ttePFhSrxpRQu8CR5/running-two-ai-safety-hackathon-hubs-in-mexico-results-costs',
      variant: 'secondary',
      external: true,
    },
    { label: 'Event page', href: '/en/global-south-challenge', variant: 'outline' },
    { label: 'Pre-talks and talks', href: YOUTUBE_CHANNEL, variant: 'outline', external: true },
  ],
};

// -------- Conferences & talks --------
// Each title puts its label and «·» on line 1 and the name on line 2 (the
// "\n", kept by `white-space: pre-line` in the <style> below). The name wraps
// inside the card at any text size: binding it whole with no-break spaces
// would push it past the card's overflow:hidden edge at 200% text (WCAG
// 1.4.4), so only the two-word «AI Safety» stays bound. `linkLabel` is the
// visible pill of a linked card (her `.event-preview-link`). Newest first:
// the Mexico Tech Week panel (October 2026, with a BlueDot Impact grant)
// moved here from #proximo-evento once it took place.
type ConfTalk = {
  title: string;
  date?: string;
  description: string;
  link?: string;
  linkLabel?: string;
  external?: boolean;
  image?: { src: string; alt: string };
};

const conferencesAndTalks: ConfTalk[] = [
  {
    title: 'Mexico Tech Week ·\nTech Policy Panel',
    date: 'October 2026',
    description:
      'Growing the AI safety community in Mexico: a panel on how AI regulation will affect the tech ecosystem in Mexico and Latin America. At MXTW AI\u00A0House (Mexico City), funded by a BlueDot Impact grant; organized by Marta Kosmyna, Isabel Montalvo, Janeth Valdivia, and Oscar\u00A0Mata.',
    link: 'https://luma.com/mxtw-aisafetymx',
    linkLabel: 'Event page',
    external: true,
  },
  {
    title: 'Workshop ·\nYour AI Agent Is Not You',
    date: '2026',
    description:
      'Hands-on workshop in collaboration with Greywall on boundaries, identity, and the safety of AI agents. A guided session with Claude Code live, followed by a discussion of responsible deployment patterns.',
    link: 'https://luma.com/l0fumrub',
    linkLabel: 'Event page',
    external: true,
  },
  {
    title: 'EAGxCDMX ·\nNot so speedy AI\u00A0Safety',
    date: '2025',
    description:
      'Workshop delivered by Silvia Fernández, Angel, and Max at EAGxCDMX. A critical introduction to the technical and political decisions that pause, accelerate, or redirect AI safety agendas.',
  },
  {
    title: 'Advanced training ·\nML4Good',
    date: '2025',
    description:
      'Intensive international bootcamp on technical AI safety. Angel, Max, Isabel, and Janeth attended as part of the regional cohort.',
  },
];

---

<BaseLayout
  title="Activities — AI Safety Mexico"
  description="Current and past activities of AI Safety Mexico: hackathons, working sessions, conferences, workshops, and advanced training."
  pathname="/en/activities"
  lang="en"
>
  <Header slot="header" currentPath="/en/activities" lang="en" />

  <PageHero
    title="Current and past activities"
    description="A public record of AI Safety Mexico: active events, recurring working sessions, conferences, workshops, and training programs that have shaped our trajectory."
    breadcrumb={breadcrumb}
    lang="en"
  />

  <!-- Upcoming event: AI x Epistemics Research Sprint (Mérida site) -->
  <section
    id="proximo-evento"
    class="page-section page-section--alt"
    aria-labelledby="activities-spotlight"
  >
    <div class="container">
      <SectionHeading
        eyebrow="Upcoming event"
        title="AI x Epistemics Research Sprint"
        description={'A research sprint by Apart Research, online and with an in\u2011person site in Mérida.'}
        id="activities-spotlight"
      />
      <div class="card-column card-column--poster card-column--poster-square">
        <Card
          image={upcomingEvent.image}
          loading="eager"
          badge={upcomingEvent.badge}
          title={upcomingEvent.title}
          description={upcomingEvent.description}
          bordered
          interactive={false}
          elevated={false}
          padding="md"
        >
          <p class="event-meta">
            <time datetime={upcomingEvent.dates.start.iso}>{upcomingEvent.dates.start.label}</time>–&#8288;<time datetime={upcomingEvent.dates.end.iso}>{upcomingEvent.dates.end.label}</time> · {upcomingEvent.place}
          </p>
          <p class="event-meta">{upcomingEvent.organizers}</p>
          {upcomingEvent.paragraphs.map((text) => <p>{text}</p>)}
          <Fragment slot="footer">
            {upcomingEvent.actions.map((cta) => (
              <a
                class={`btn btn-${cta.variant ?? 'outline'}`}
                href={cta.href}
                {...externalAttrs(cta.external)}
              >
                {cta.label}
              </a>
            ))}
          </Fragment>
        </Card>
      </div>
    </div>
  </section>

  <!-- Recurring working sessions -->
  <section class="page-section" aria-labelledby="activities-recurring">
    <div class="container">
      <SectionHeading
        eyebrow="Ongoing"
        title="Recurring working sessions"
        description="A standing forum where the team and invited guests discuss project progress, readings, and open questions."
        id="activities-recurring"
      />
      <div class="card-column">
        <ActivityCard
          title={recurring.title}
          date={recurring.date}
          description={recurring.description}
          link={recurring.link}
          linkLabel={recurring.linkLabel}
          external={recurring.external}
        />
      </div>
    </div>
  </section>

  <!-- Past activity: Global South AIS Hackathon -->
  <section id="gsh-2026" class="page-section" aria-labelledby="activities-gsh">
    <div class="container">
      <SectionHeading
        eyebrow="Past activity"
        title="Global South AIS Hackathon"
        description="June 19–21, 2026 · with Apart Research."
        id="activities-gsh"
      />
      <div class="card-column card-column--poster">
        <Card
          image={gshRecap.image}
          badge={gshRecap.badge}
          title={gshRecap.title}
          bordered
          interactive={false}
          elevated={false}
          padding="md"
        >
          {gshRecap.paragraphs.map((text) => <p>{text}</p>)}
          <Fragment slot="footer">
            {gshRecap.links.map((cta) => (
              <a
                class={`btn btn-${cta.variant ?? 'outline'}`}
                href={cta.href}
                {...externalAttrs(cta.external)}
              >
                {cta.label}
              </a>
            ))}
          </Fragment>
        </Card>
      </div>
    </div>
  </section>

  <!-- Conferences and talks -->
  <section class="page-section page-section--alt" aria-labelledby="activities-conferences">
    <div class="container">
      <SectionHeading
        eyebrow="Track record"
        title="Conferences, workshops, and training"
        description="A representative selection of events the team has delivered, attended, or co-organized."
        id="activities-conferences"
      />
      <div class="conf-grid">
        {conferencesAndTalks.map(item => (
          <ActivityCard
            title={item.title}
            date={item.date}
            description={item.description}
            image={item.image}
            link={item.link}
            linkLabel={item.linkLabel}
            external={item.external}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="page-section" aria-labelledby="activities-gallery">
    <div class="container">
      <SectionHeading
        eyebrow="Gallery"
        title="Images from our activities"
        description="A visual sample of the team's work and the venues we've been part of."
        id="activities-gallery"
      />
      <img
        class="activities-photo"
        src="/images/sesion-trabajo.webp"
        width="2048"
        height="1432"
        loading="lazy"
        decoding="async"
        alt="AI Safety Mexico participants in a working session, seated in a circle"
      />
    </div>
  </section>

  <CtaSection
    title="Would you like to organize an event with us?"
    description="We collaborate with institutions, communities, and international allies to produce workshops, working sessions, and public events on AI safety."
    ctaLabel="Propose an event"
    ctaHref="/en/get-involved#events"
  />

  <Footer slot="footer" lang="en" />
</BaseLayout>

<style>
  /* Section shells — her .section-* : 72px top and bottom (48px on phones),
     white or bg-2, closed by the global line-soft hairline (base.css
     `main > section`). Tinted: #proximo-evento (her .section-current) and
     the conferences grid, so two tints are never adjacent. */
  .page-section {
    padding-block: var(--section-pad);
    background: var(--color-bg-section-base);
  }

  .page-section--alt {
    background: var(--color-bg-section-warm);
  }

  /* Deep-link targets (#proximo-evento, #gsh-2026) clear the sticky header. */
  .page-section[id] {
    scroll-margin-top: var(--scroll-offset);
  }

  /* Single-card sections: the card runs the full container like her
     .program-card / .event-preview (fcacfc4 index), so it shares both edges
     of the SectionHeading above. The copy inside keeps her
     reading measure, and `pretty` keeps one word from ending a
     paragraph alone. */
  .card-column :global(.card__description),
  .card-column :global(.card__body > p) {
    max-width: var(--measure-desc);
    text-wrap: pretty;
  }

  .card-column :global(.activity-card__description) {
    max-width: var(--measure-sub);
  }

  /* #gsh-2026 poster: show the 3:2 promotional image whole; Card's default
     16:9 media box would crop the text printed near its edges. From 769px
     the card is a row, with the framed poster on the left and the text on
     the right, so the poster is not a full-width block (up to 1024px the
     poster takes 42% to leave the text room); below that it stacks. */
  .card-column--poster :global(.card .card__media) {
    aspect-ratio: 3 / 2;
  }

  @media (min-width: 769px) {
    .card-column--poster :global(.card) {
      flex-direction: row;
      align-items: center;
    }

    .card-column--poster :global(.card .card__media) {
      flex: 0 0 46%;
      margin-left: 28px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
    }

    .card-column--poster :global(.card .card__body) {
      flex: 1 1 auto;
      min-width: 0;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .card-column--poster :global(.card .card__media) {
      flex-basis: 42%;
    }
  }

  /* #proximo-evento poster: the sprint cover is square (800×800), so its
     box is 1:1 and narrower than the 3:2 GSH poster: 36% of the card from
     1025px (about 410px at the widest container) and 40% from 769px, with
     28px above and below so the framed square keeps clear of the card's
     hairline when the copy beside it is shorter. Below 769px it stacks
     above the copy, capped (see the next rule). Same specificity as the
     poster rules above, so these must come after them. */
  .card-column--poster-square :global(.card .card__media) {
    aspect-ratio: 1 / 1;
  }

  @media (min-width: 769px) {
    .card-column--poster-square :global(.card .card__media) {
      flex-basis: 36%;
      margin-block: 28px;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .card-column--poster-square :global(.card .card__media) {
      flex-basis: 40%;
    }
  }

  /* Stacked, the full-width square would grow to 718px at 768px and push
     the card's title and pills below the fold on tablets. It takes the
     sprint page's 360px cap instead (`.sprint-about__art`), framed like
     the poster from 769px and inset 20px to line up with the card copy
     (Card's 20px side padding up to 768px). */
  @media (max-width: 768px) {
    .card-column--poster-square :global(.card .card__media) {
      width: min(360px, calc(100% - 40px));
      margin: 20px 20px 0;
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
    }
  }

  /* Next-event meta lines — her .event-meta as it renders inside
     .program-card (.88rem, ink-2, lh 1.7). Card's 10px body gap spaces
     them; the slotted <p> and the footer pills take Card's own card-copy
     and 18px rhythm. `pretty` avoids a short last line, such as a lone
     word. */
  .event-meta {
    font-size: var(--fs-small);
    line-height: var(--lh-loose);
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  /* Conferences and talks — 1 column, then 2 from 769px, 18px gaps.
     With the Mexico Tech Week panel there are four cards: a 3-up row at
     1025px would leave the fourth alone in a row of its own (an orphan),
     so the grid stays 2-up (2×2) at every width from 769px. The odd-last
     rule now holds at all of them: if the count turns odd, the last card
     spans the whole row instead of sitting alone in half of it (the blurbs
     keep her sub measure there). With six cards, bring back a 3-up tier
     from 1025px.
     Titles honour the "\n" after their «·» (label on line 1, name on
     line 2), and the name still wraps inside the card. The forced break
     turns off the h3's `balance` in Chromium, so `pretty` keeps a wrapped
     name from leaving one word alone («You» at 150–200% text). */
  .conf-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-grid);
  }

  .conf-grid :global(.activity-card__title) {
    white-space: pre-line;
    text-wrap: pretty;
  }

  .conf-grid :global(.activity-card__description) {
    max-width: var(--measure-sub);
    text-wrap: pretty;
  }

  /* Two linked cards share the first row (the Mexico Tech Week panel and
     the Greywall workshop): their pills sit at the bottom of the card
     (`margin-top: auto`), so the pair ends on one line however long each
     blurb runs. A blurb followed by a pill keeps the pill's 16px gap; the
     cards without a pill keep their own bottom padding. */
  .conf-grid :global(.activity-card__description:not(:last-child)) {
    margin-bottom: 16px;
  }

  .conf-grid :global(.activity-card__cta) {
    margin-top: auto;
  }

  @media (min-width: 769px) {
    .conf-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .conf-grid > :global(:last-child:nth-child(odd)) {
      grid-column: 1 / -1;
    }
  }

  /* Gallery — one photo, framed like the home page's feature photo: full
     container width, large radius, hairline frame. */
  .activities-photo {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
</style>
