---
/*
 * /en/resources — Open AI safety resource directory (EN).
 *
 * Twin of src/pages/resources.astro. The catalogue itself was curated in
 * Spanish; ResourceDirectory surfaces a note about that on this locale.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import CtaSection from '../../components/CtaSection.astro';
import ResourceDirectory from '../../components/ResourceDirectory.astro';
import type { Breadcrumb } from '../../lib/types';

const breadcrumb: Breadcrumb = {
  items: [{ label: 'Home', href: '/en' }, { label: 'Resources' }],
};
---

<BaseLayout
  title="Resources — AI Safety Mexico"
  description="An open directory of AI safety courses, research programmes, fellowships, funding and communities, with hand-verified links and a selection relevant to Latin America."
  pathname="/en/resources"
  lang="en"
>
  <Header slot="header" currentPath="/en/resources" lang="en" />

  <PageHero
    title="Open AI safety resources"
    description="A curated directory of courses, research programmes, fellowships, funding sources and communities. Every link is verified by hand and the full catalogue can be downloaded and reused."
    breadcrumb={breadcrumb}
    lang="en"
  />

  <ResourceDirectory lang="en" />

  <CtaSection
    title="Missing something, or found a broken link?"
    description="This directory is maintained by hand and depends on the community to correct it. Tell us what you would add, especially if it is in Spanish or from Latin America."
    ctaLabel="Suggest a resource"
    ctaHref="/en/get-involved"
  />

  <Footer slot="footer" lang="en" />
</BaseLayout>
