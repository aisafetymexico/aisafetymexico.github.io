---
/**
 * /projects/vigia — VIGÍA project deep-dive (ProjectPage template).
 *
 * Spec:
 *   - docs/ARCHITECTURE.md §2 (`/projects/vigia` purpose, sections, CTA).
 *   - docs/ARCHITECTURE.md §6 (ProjectPage template — hero, meta bar,
 *     content sections, related projects, CTA).
 *   - docs/CONTENT-MAP.md §1.6 — promote spotlight to full subpage.
 *
 * Sections (per ARCHITECTURE):
 *   1. PageHero (with breadcrumb).
 *   2. ProjectMetaBar (chips: badge, focus, status, team size).
 *   3. Overview — what VIGÍA is, problem it solves.
 *   4. Recognition — Special Recognition · AI Safety Collab 2025 callout.
 *   5. Methodology / approach.
 *   6. Team — 5 collaborators with roles.
 *   7. External resources.
 *   8. RelatedProjects — link to AI Safety Connect.
 *   9. CtaSection — visit the platform.
 *
 * Design: the collaborator's light "Editorial mínimo" (fcacfc4
 * css/style.css). Every section shares the full container; prose sections
 * keep a left-aligned 680px reading column (`.project-column`). Recognition,
 * team and related projects are the bg-2 bands (they alternate with white,
 * never two in a row; the Callout turns white on its tinted band), and the
 * platform link is the global ink pill (`.btn .btn-primary`) in her
 * `.program-actions` row. On this Spanish page both platform links open
 * the platform's Spanish edition (`platformUrl`).
 */
import { getEntry, getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Callout from '../../components/Callout.astro';
import FactList from '../../components/FactList.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaSection from '../../components/CtaSection.astro';

const project = await getEntry('projects', 'vigia');
if (!project) {
  throw new Error('VIGÍA project entry missing in src/content/projects/vigia.md');
}
const data = project.data;

// The platform's Spanish edition lives at its root. The collection's
// `externalUrl` is the English edition (index-en.html, used by
// /en/projects/vigia), so here it only gates whether the platform links show.
const platformUrl = 'https://vigia-observatorio.github.io/';

// Meta bar chips (KeyFacts component) — type-only, no leading glyph.
const metaChips = [
  { text: 'Special Recognition · AI Safety Collab 2025' },
  { text: 'Gobernanza · Soberanía digital' },
  { text: 'México' },
  { text: `Equipo de ${data.team.length} colaboradores` },
  { text: 'En desarrollo activo' },
];

// Team as FactList — eyebrow label / value pairs.
const teamItems = data.team.map((person) => ({
  label: person.role ?? 'Colaborador/a',
  value: person.name,
}));

// External resources — same label/value treatment as the team list.
const resourceItems = [
  data.externalUrl
    ? { label: 'Plataforma', value: 'vigia-observatorio.github.io' }
    : null,
  { label: 'Aliado fundacional', value: 'ENAIS — curso AI Governance' },
  { label: 'Reconocimiento', value: 'AI Safety Collab 2025' },
].filter(Boolean) as { label: string; value: string }[];

// Related project — AI Safety Connect. Its entry has no `badge`, so the card
// takes the same in-card label as on /projects (label → title).
const fallbackBadges: Record<string, string> = {
  'ai-safety-connect': 'Colaboración SPAR',
};

const allProjects = await getCollection('projects', ({ data: d }: { data: { draft?: boolean } }) => d.draft !== true);
const related = allProjects
  .filter((p) => (p.data.slug ?? p.slug) !== 'vigia')
  .slice(0, 1)
  .map((p) => {
    const slug = p.data.slug ?? p.slug;
    return {
      title: p.data.title,
      badge: p.data.badge ?? fallbackBadges[slug],
      description: p.data.summary,
      image: p.data.cover,
      href: `/projects/${slug}`,
    };
  });

const breadcrumb = {
  items: [
    { label: 'Inicio', href: '/' },
    { label: 'Proyectos', href: '/projects' },
    { label: 'VIGÍA' },
  ],
};
---

<BaseLayout
  title="VIGÍA · Proyecto · AI Safety Mexico"
  description="VIGÍA es la plataforma de AI Safety Mexico para el análisis de gobernanza de IA y soberanía digital en México. Special Recognition · AI Safety Collab 2025."
  pathname="/projects/vigia"
  ogImage={data.cover?.src as string | undefined}
>
  <Header slot="header" navActivePath="/projects" />

  <PageHero
    title="VIGÍA"
    description="Plataforma para el análisis de gobernanza de IA y soberanía digital en México."
    breadcrumb={breadcrumb}
  />

  {/* Meta bar */}
  <section class="section section--compact section--base" aria-label="Información del proyecto">
    <div class="container">
      <KeyFacts facts={metaChips} />
    </div>
  </section>

  {/* Overview */}
  <section class="section section--base" aria-labelledby="vigia-overview-heading">
    <div class="container project-column">
      <SectionHeading
        eyebrow="Resumen"
        title="¿Qué es VIGÍA?"
        id="vigia-overview-heading"
      />
      <div class="prose">
        <p>
          <strong>VIGÍA</strong> — <em>Valoración de Impactos Gubernamentales de
          Inteligencia Artificial</em> — es una plataforma en desarrollo que mapea,
          analiza y comunica decisiones públicas sobre inteligencia artificial en
          México. Surge como parte de los proyectos del curso de
          AI Governance impartido por <strong>ENAIS</strong> y AI Safety Mexico, y
          se ha consolidado como una iniciativa propia.
        </p>
        <p>
          El observatorio busca cerrar una brecha concreta: no existe una fuente
          pública, sistemática y auditable que documente cómo el gobierno
          mexicano toma decisiones sobre IA — qué adquiere, qué regula, qué
          despliega y bajo qué supervisión. VIGÍA articula esa información
          para investigadores, periodistas, sociedad civil y tomadores de decisión.
        </p>
      </div>
    </div>
  </section>

  {/* Recognition */}
  <section class="section section--warm" aria-labelledby="vigia-recognition-heading">
    <div class="container project-column">
      <SectionHeading
        eyebrow="Reconocimiento"
        title="Special Recognition · AI Safety Collab 2025"
        id="vigia-recognition-heading"
      />
      <Callout tone="highlight">
        <p>
          VIGÍA recibió el <strong>Special Recognition</strong> en
          <strong>AI Safety Collab 2025</strong>, programa global de proyectos de
          investigación en seguridad de IA. El reconocimiento valida el enfoque
          situado del proyecto y abre puertas para futuras colaboraciones
          internacionales.
        </p>
      </Callout>
    </div>
  </section>

  {/* Methodology */}
  <section class="section section--base" aria-labelledby="vigia-methodology-heading">
    <div class="container project-column">
      <SectionHeading
        eyebrow="Metodología"
        title="Cómo trabajamos"
        id="vigia-methodology-heading"
      />
      <div class="prose">
        <p>
          VIGÍA combina rastreo documental, análisis cualitativo y comunicación
          estructurada.
        </p>
        <p>
          La plataforma articula tres capas de trabajo: (1) <strong>rastreo
          documental</strong> de adquisiciones, regulaciones, consultas públicas y
          despliegues gubernamentales que involucran sistemas de IA; (2)
          <strong>análisis cualitativo</strong> de cada caso bajo categorías de
          gobernanza, riesgo y rendición de cuentas; y (3) <strong>comunicación
          estructurada</strong> en formatos accesibles para audiencias técnicas y
          no técnicas — fichas, líneas de tiempo y resúmenes interpretativos.
        </p>
        <p>
          El enfoque privilegia la <strong>verificabilidad</strong>: cada caso
          documentado en VIGÍA enlaza a su fuente primaria (boletines oficiales,
          actas, comunicados) y se acompaña de una nota metodológica sobre cómo se
          obtuvo y clasificó la información.
        </p>
      </div>
    </div>
  </section>

  {/* Team */}
  <section class="section section--warm" aria-labelledby="vigia-team-heading">
    <div class="container project-column">
      <SectionHeading
        eyebrow="Equipo"
        title="Quiénes lo construyen"
        description="VIGÍA es un esfuerzo colaborativo entre sus cofundadores, una colaboración en diseño y la asesoría de docentes del curso de AI Governance del que surgió la idea."
        id="vigia-team-heading"
      />
      <FactList items={teamItems} />
    </div>
  </section>

  {/* Resources */}
  <section class="section section--base" aria-labelledby="vigia-resources-heading">
    <div class="container project-column">
      <SectionHeading
        eyebrow="Recursos"
        title="Enlaces y referencias"
        id="vigia-resources-heading"
      />
      <FactList items={resourceItems} />

      {data.externalUrl && (
        <div class="program-actions">
          <a class="btn btn-primary" href={platformUrl} target="_blank" rel="noopener noreferrer">
            Visitar la plataforma VIGÍA
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      )}
    </div>
  </section>

  {/* Related projects */}
  {related.length > 0 && (
    <section class="section section--warm" aria-labelledby="vigia-related-heading">
      <div class="container">
        <SectionHeading
          eyebrow="Sigue explorando"
          title="Otros proyectos"
          id="vigia-related-heading"
        />
        <div class="vigia-related-grid">
          {related.map((card) => (
            <ProjectCard
              title={card.title}
              badge={card.badge}
              description={card.description}
              image={card.image}
              href={card.href}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaSection
    title="Conoce VIGÍA en vivo"
    description="La plataforma se actualiza con cada nuevo caso documentado. Visítala para explorar el observatorio."
    ctaLabel="Ir a vigia-observatorio.github.io"
    ctaHref={platformUrl}
    ctaExternal={true}
  />

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* Reading column: the body of each prose section keeps her editorial
     measure (680px, the section-description width), left-aligned in the
     full container so every heading shares the header's left edge. As in
     her CSS, the measure sits on the elements, not on the container.
     `:global` reaches the root of child components (SectionHeading,
     Callout, FactList). */
  .project-column > :global(*) {
    max-width: var(--measure-desc);
  }

  /* The column's last block must not add to the section's bottom padding
     (e.g. the Callout's own block margin), so every band stays even. */
  .project-column > :global(:last-child) {
    margin-bottom: 0;
  }

  /* Long-form copy: her .content-card paragraphs (ink-2, lh 1.7), with
     bold lead-ins in ink. `pretty` keeps a lone word off the last line, as
     in SectionHeading descriptions. */
  .prose p {
    font-size: var(--fs-body);
    line-height: var(--lh-loose);
    text-wrap: pretty;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-3);
  }

  .prose p:last-child {
    margin-bottom: 0;
  }

  .prose strong {
    color: var(--color-text-primary);
    font-weight: var(--fw-semibold);
  }

  /* Related projects: her 2-up card grid, 18px gap, one column up to 768px. */
  .vigia-related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-grid);
  }

  @media (min-width: 769px) {
    .vigia-related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
