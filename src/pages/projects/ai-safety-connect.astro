---
/**
 * /projects/ai-safety-connect — AI Safety Connect deep-dive (ProjectPage template).
 *
 * Spec:
 *   - docs/ARCHITECTURE.md §2 (`/projects/ai-safety-connect` purpose, sections, CTA).
 *   - docs/ARCHITECTURE.md §6 (ProjectPage template).
 *   - docs/CONTENT-MAP.md §1.6 — promote spotlight to subpage; preserves the
 *     PDF embed pattern from the existing `ai-safety-connect.html` page so the
 *     final report stays viewable inline.
 *
 * Sections:
 *   1. PageHero (with breadcrumb).
 *   2. ProjectMetaBar (chips: SPAR program, focus, team size, status).
 *   3. Overview & objective.
 *   4. Methodology — taxonomy, semantic search, pipelines.
 *   5. Paper / publication block — embed + download CTA.
 *   6. International team.
 *   7. Acknowledgements.
 *   8. RelatedProjects.
 *   9. CtaSection — read the paper.
 *
 * Design: the collaborator's light "Editorial mínimo" (fcacfc4
 * css/style.css). Every section shares the full container; prose sections
 * keep a left-aligned 680px reading column (`.project-column`), while the
 * paper block uses the full width so the PDF stays readable (her
 * .pdf-viewer: white, hairline, 8px radius; shown from 769px at 800px;
 * phones get the two pills only). Methodology, team and related projects
 * are the bg-2 bands (they alternate with white, never two in a row); the
 * paper links are the global ink and outline pills in her
 * `.program-actions` row.
 */
import { getEntry, getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Callout from '../../components/Callout.astro';
import FactList from '../../components/FactList.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaSection from '../../components/CtaSection.astro';

const project = await getEntry('projects', 'ai-safety-connect');
if (!project) {
  throw new Error('AI Safety Connect entry missing in src/content/projects/ai-safety-connect.md');
}
const data = project.data;

const paperPath = data.paperUrl ?? '/Papers/AI_Safety_Connect_Final_Report.pdf';

// Meta bar chips — type-only, no leading glyph.
const metaChips = [
  { text: 'SPAR · Supervised Program for Alignment Research' },
  { text: 'Equipo internacional' },
  { text: 'Reporte final disponible' },
  { text: `${data.team.length} coinvestigadores` },
];

// Methodology fact list — eyebrow label / value pairs.
const methodologyItems = [
  {
    label: 'Objetivo',
    value:
      'Minimizar la brecha estructural de coordinación entre la investigación académica y las comunidades de seguridad en IA.',
  },
  {
    label: 'Metodología',
    value:
      'Plataforma integrada que mapea autores, publicaciones y áreas temáticas mediante taxonomía estructurada, búsqueda semántica y pipelines de datos escalables.',
  },
  {
    label: 'Equipo internacional',
    value: data.team.map((p) => p.name).join(', '),
  },
];

// Team list
const teamItems = data.team.map((person) => ({
  label: person.role ?? 'Coinvestigador/a',
  value: person.name,
}));

// Related projects
const allProjects = await getCollection('projects', ({ data: d }: { data: { draft?: boolean } }) => d.draft !== true);
const related = allProjects
  .filter((p) => (p.data.slug ?? p.slug) !== 'ai-safety-connect')
  .slice(0, 1)
  .map((p) => {
    const slug = p.data.slug ?? p.slug;
    return {
      title: p.data.title,
      badge: p.data.badge,
      description: p.data.summary,
      image: p.data.cover,
      href: `/projects/${slug}`,
    };
  });

const breadcrumb = {
  items: [
    { label: 'Inicio', href: '/' },
    { label: 'Proyectos', href: '/projects' },
    { label: 'AI Safety Connect' },
  ],
};
---

<BaseLayout
  title="AI Safety Connect · Proyecto · AI Safety Mexico"
  description="AI Safety Connect: plataforma desarrollada en el marco de SPAR para mapear sistemáticamente la investigación en seguridad de IA y reducir la brecha entre academia y comunidad."
  pathname="/projects/ai-safety-connect"
  ogImage={data.poster?.src as string | undefined}
>
  <Header slot="header" navActivePath="/projects" />

  <PageHero
    title="AI Safety Connect"
    description="Plataforma para mapear sistemáticamente la investigación en seguridad de IA y reducir la brecha entre academia y comunidad."
    breadcrumb={breadcrumb}
  />

  {/* Meta bar */}
  <section class="section section--compact section--base" aria-label="Información del proyecto">
    <div class="container">
      <KeyFacts facts={metaChips} />
    </div>
  </section>

  {/* Overview */}
  <section class="section section--base" aria-labelledby="aisc-overview-heading">
    <div class="container project-column">
      <SectionHeading
        eyebrow="Resumen"
        title="¿Qué es AI Safety Connect?"
        id="aisc-overview-heading"
      />
      <Callout tone="highlight">
        <p>
          <strong>AI Safety Connect</strong> es una plataforma para mapear
          sistemáticamente la investigación en seguridad de IA y reducir la brecha
          entre la academia y las comunidades de práctica.
        </p>
      </Callout>
      <div class="prose">
        <p>
          El proyecto fue desarrollado en el marco del <strong>Supervised
          Program for Alignment Research (SPAR)</strong>, programa internacional
          que conecta talento emergente con investigadores establecidos en
          alineamiento. AI Safety Mexico participó como sede mexicana de la
          colaboración que produjo este reporte final.
        </p>
        <p>
          La hipótesis central del proyecto es que existe una <strong>brecha
          estructural de coordinación</strong> entre quienes producen investigación
          en seguridad de IA y quienes la consumen para diseñar políticas, productos
          o programas formativos. Una plataforma con taxonomía consistente y
          búsqueda semántica reduce el costo de descubrimiento y abre la
          posibilidad de articular agendas compartidas.
        </p>
      </div>
    </div>
  </section>

  {/* Methodology */}
  <section class="section section--warm" aria-labelledby="aisc-methodology-heading">
    <div class="container project-column">
      <SectionHeading
        eyebrow="Metodología"
        title="Cómo está construido"
        description="La plataforma se apoya en tres componentes complementarios: taxonomía estructurada, búsqueda semántica y pipelines de datos escalables."
        id="aisc-methodology-heading"
      />
      <FactList items={methodologyItems} />
    </div>
  </section>

  {/* Paper / Publication */}
  <section class="section section--base" aria-labelledby="aisc-paper-heading">
    <div class="container">
      <SectionHeading
        eyebrow="Publicación"
        title="Reporte final"
        description="El documento sintetiza los hallazgos, decisiones de diseño y trabajo a futuro de la colaboración SPAR."
        id="aisc-paper-heading"
      />

      <div class="program-actions aisc-paper-actions">
        <a
          class="btn btn-primary"
          href={paperPath}
          target="_blank"
          rel="noopener noreferrer"
        >
          Abrir PDF en pestaña nueva
          <span aria-hidden="true">↗</span>
        </a>
        <a
          class="btn btn-outline"
          href={paperPath}
          download
        >
          Descargar reporte
          <span aria-hidden="true">↓</span>
        </a>
      </div>

      <div class="aisc-pdf-viewer" role="group" aria-label="Visor del reporte final de AI Safety Connect">
        <object
          data={paperPath}
          type="application/pdf"
          width="100%"
          height="800"
        >
          <p class="aisc-pdf-fallback">
            Tu navegador no puede mostrar el PDF embebido.
            <a class="inline-link" href={paperPath} target="_blank" rel="noopener noreferrer">Abre el reporte en una pestaña nueva</a>.
          </p>
        </object>
      </div>
    </div>
  </section>

  {/* Team */}
  <section class="section section--warm" aria-labelledby="aisc-team-heading">
    <div class="container project-column">
      <SectionHeading
        eyebrow="Equipo internacional"
        title="Coinvestigadores"
        description="La colaboración SPAR articuló a un equipo distribuido geográficamente con experiencia en alineamiento, evaluaciones e infraestructura de datos."
        id="aisc-team-heading"
      />
      <FactList items={teamItems} />
    </div>
  </section>

  {/* Acknowledgements */}
  <section class="section section--base" aria-labelledby="aisc-ack-heading">
    <div class="container project-column">
      <SectionHeading
        eyebrow="Agradecimientos"
        title="Programas y aliados"
        id="aisc-ack-heading"
      />
      <div class="prose">
        <p>
          AI Safety Connect existe gracias al programa <strong>SPAR — Supervised
          Program for Alignment Research</strong>, que articuló al equipo
          internacional y proveyó la mentoría académica. Agradecemos a las
          mentoras y mentores que acompañaron el diseño metodológico y la
          revisión de resultados, así como a las comunidades de práctica que
          aportaron retroalimentación durante el desarrollo.
        </p>
        <p>
          AI Safety Mexico participó como sede en México, conectando al equipo con
          aliados locales y aportando perspectiva mexicana al diseño del
          mapeo.
        </p>
      </div>
    </div>
  </section>

  {/* Related projects */}
  {related.length > 0 && (
    <section class="section section--warm" aria-labelledby="aisc-related-heading">
      <div class="container">
        <SectionHeading
          eyebrow="Sigue explorando"
          title="Otros proyectos"
          id="aisc-related-heading"
        />
        <div class="aisc-related-grid">
          {related.map((card) => (
            <ProjectCard
              title={card.title}
              badge={card.badge}
              description={card.description}
              image={card.image}
              href={card.href}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaSection
    title="Lee el reporte completo"
    description="El reporte final documenta hallazgos, decisiones de diseño y trabajo a futuro."
    ctaLabel="Abrir el PDF"
    ctaHref={paperPath}
    ctaExternal={true}
  />

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* Reading column: the body of each prose section keeps her editorial
     measure (680px, the section-description width), left-aligned in the
     full container so every heading shares the header's left edge. As in
     her CSS, the measure sits on the elements, not on the container.
     `:global` reaches the root of child components (SectionHeading,
     Callout, FactList). */
  .project-column > :global(*) {
    max-width: var(--measure-desc);
  }

  /* The column's last block must not add to the section's bottom padding
     (e.g. the Callout's own block margin), so every band stays even. */
  .project-column > :global(:last-child) {
    margin-bottom: 0;
  }

  /* Long-form copy: her .content-card paragraphs (ink-2, lh 1.7), with
     bold lead-ins in ink. `pretty` keeps a lone word off the last line, as
     in SectionHeading descriptions. */
  .prose p {
    font-size: var(--fs-body);
    line-height: var(--lh-loose);
    text-wrap: pretty;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-3);
  }

  .prose p:last-child {
    margin-bottom: 0;
  }

  .prose strong {
    color: var(--color-text-primary);
    font-weight: var(--fw-semibold);
  }

  /* Paper actions: her pill pair (ink primary + outline). The global
     .program-actions supplies the row and the full-width stack on phones;
     sitting right under the heading, it needs no top margin. */
  .aisc-paper-actions {
    margin-top: 0;
  }

  /* PDF viewer — her .pdf-viewer: white, 1px hairline, 8px radius, no
     shadow, 16px under the actions. It shows only from 769px, where desktop
     browsers embed the PDF. Phone browsers (Android Chrome, Samsung
     Internet, the WhatsApp/Instagram/Facebook in-app browsers) cannot: they
     would show an empty frame whose fallback line repeats the pills. So on
     phones the two pills above end the block; they open and download the
     report. The object's 800px height is set here, not as a min-height; its
     `height="800"` attribute is only the no-CSS fallback. */
  .aisc-pdf-viewer {
    display: none;
    width: 100%;
    margin-top: var(--space-4);
    background: var(--color-bg-base);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  @media (min-width: 769px) {
    .aisc-pdf-viewer {
      display: block;
    }

    .aisc-pdf-viewer object {
      display: block;
      width: 100%;
      height: 800px;
    }
  }

  /* Inside the viewer (769px and up), shown only when the browser cannot
     embed the PDF; its link is the global .inline-link. */
  .aisc-pdf-fallback {
    padding: var(--space-6);
    margin: 0;
    color: var(--color-text-secondary);
  }

  /* Related projects: her 2-up card grid, 18px gap, one column up to 768px. */
  .aisc-related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-grid);
  }

  @media (min-width: 769px) {
    .aisc-related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
