---
/**
 * /get-involved — Colabora con nosotros.
 *
 * Spec: docs/ARCHITECTURE.md §2 (`/get-involved`) + Task #19.
 *
 * Page composition (ContentPage template):
 *   1. SiteHeader (sticky)
 *   2. PageHero — h1 + lede + breadcrumb (centered)
 *   3. Intro — SectionHeading only (quiénes colaboran con nosotros)
 *   4. #participa — «Cuatro caminos»: one card per audience with an
 *      anchorable id (#training, #vigia, #students, #agenda). Like her path
 *      card, it reads audience label → title → paragraphs → actions, with
 *      no numeral.
 *   5. «Otras formas de colaborar» — sibling section with the two base
 *      offerings, #research and #events. /research and /activities deep-link
 *      to these ids: keep them.
 *   6. #colaboraciones — named collaborations (cards) + allies (KeyFacts).
 *   7. #contacto — direct channels (email, LinkedIn, Instagram, Luma,
 *      YouTube). Cuando integremos Formspree o backend real, reintroducir el
 *      formulario de contacto aquí (componente reusable en src/components/).
 *   8. CtaSection — cierre con email canónico contact@aismx.org.
 *   9. SiteFooter
 *
 * Note on the path cards:
 *   FeatureGrid does not expose per-item ids on its <li>. Since other pages
 *   deep-link to single cards (`/get-involved#training`, `#research`,
 *   `#events`, etc.), the cards are rendered with page markup in her
 *   `.program-card` look (white, 1px hairline, 8px radius,
 *   no shadow) plus an `id` per <li>. The card a link points at gets the
 *   clay featured border through `:target`. See `.collab-vias__*` below.
 *
 * Design: her "Editorial mínimo". Sections
 * alternate white and bg-2, never two tinted bands in a row (the CtaSection
 * is white, the footer bg-2); actions are the global `.btn` pills inside
 * `.program-actions`; labels use the global `.role-label`.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import KeyFacts from '../components/KeyFacts.astro';
import CtaSection from '../components/CtaSection.astro';

const pathname = '/get-involved';

const breadcrumb = {
  items: [
    { label: 'Inicio', href: '/' },
    { label: 'Colabora' },
  ],
};

interface ViaCta {
  label: string;
  href: string;
  /** Pill variant; defaults to the ink primary pill. */
  variant?: 'primary' | 'outline';
  external?: boolean;
}

interface Via {
  /** Deep-link anchor, identical in ES and EN. */
  id: string;
  label?: string;
  title: string;
  paragraphs: string[];
  ctas: ViaCta[];
}

// Cuatro caminos (#participa).
// EXPIRES 2026-10-27: after the Mexico Tech Week panel, rewrite the first
// sentence of #agenda (the panel becomes a past activity), here and in EN.
const vias: Via[] = [
  {
    id: 'training',
    label: 'Instituciones',
    title: 'Pedir un curso in-house',
    paragraphs: [
      'Llevamos a facultades y centros de investigación los cursos de fundamentos, gobernanza y el curso técnico de seguridad en IA. Ya lo hicimos en Centro Geo y en la Facultad de Matemáticas de la UADY.',
      'Si tu institución quiere una edición a la medida, cuéntanos el público, las fechas tentativas y si necesitan la versión introductoria o la técnica.',
    ],
    ctas: [
      {
        label: 'Solicitar un curso',
        href: 'mailto:contact@aismx.org?subject=Curso%20in-house%20de%20seguridad%20en%20IA',
      },
    ],
  },
  {
    id: 'vigia',
    label: 'Investigadores',
    title: 'VIGÍA',
    paragraphs: [
      'VIGÍA es el recurso abierto para quien investiga gobernanza de IA y soberanía digital en México: un observatorio del Diario Oficial de la Federación que identifica menciones de IA, huecos regulatorios y riesgos.',
      'Sirve como base de datos, metodología y punto de partida para papers, notas de política o periodismo de investigación.',
    ],
    ctas: [{ label: 'Abrir VIGÍA', href: '/projects/vigia' }],
  },
  {
    id: 'students',
    label: 'Estudiantes',
    title: 'Estancias AISMx × UPY',
    paragraphs: [
      'Programa de estancias de AI Safety Mexico en colaboración con la Universidad Politécnica de Yucatán. Está pensado para estudiantes que quieran pasar de los cursos a trabajar con el equipo en un proyecto concreto.',
      'Si estudias en UPY o en otra universidad y quieres postular, escríbenos con tu formación y qué te interesa trabajar.',
    ],
    ctas: [
      {
        label: 'Preguntar por estancias',
        href: 'mailto:contact@aismx.org?subject=Estancias%20AISMx%20%C3%97%20UPY',
      },
    ],
  },
  {
    id: 'agenda',
    label: 'Agenda y archivo',
    title: 'Eventos y talks',
    paragraphs: [
      'El próximo evento es el panel de Mexico Tech Week. El resto de la agenda —mesas de trabajo el primer viernes de cada mes, talleres y pre-talks— vive en Luma. Las pre-talks y talks del Global South AIS Hackathon están en nuestro canal de YouTube.',
    ],
    ctas: [
      {
        label: 'Calendario en Luma',
        href: 'https://luma.com/calendar/cal-WjnM2llUGXz17t5',
        external: true,
      },
      {
        label: 'YouTube',
        href: 'https://www.youtube.com/@AISafetyMéxico',
        variant: 'outline',
        external: true,
      },
    ],
  },
];

// Otras formas de colaborar: the two base offerings (852dfbb), restored with
// their original ids so the /research (#research) and /activities (#events)
// CTAs land on the matching card.
const otrasVias: Via[] = [
  {
    id: 'research',
    title: 'Investigación conjunta',
    paragraphs: [
      'Sumamos esfuerzos con grupos académicos y laboratorios para codesarrollar proyectos de investigación en seguridad y alineación de IA, con énfasis en preguntas relevantes para México.',
    ],
    ctas: [
      {
        label: 'Propón una colaboración',
        href: 'mailto:contact@aismx.org?subject=Investigaci%C3%B3n%20conjunta',
      },
    ],
  },
  {
    id: 'events',
    title: 'Eventos y advisory',
    paragraphs: [
      'Participamos como ponentes, panelistas y asesores en eventos, mesas de trabajo y conversaciones sobre gobernanza de IA en México.',
    ],
    ctas: [
      {
        label: 'Propón un evento',
        href: 'mailto:contact@aismx.org?subject=Eventos%20y%20advisory',
      },
    ],
  },
];

const colaboraciones = [
  {
    eyebrow: 'Formación',
    title: 'ENAIS',
    description:
      'Con ENAIS impartimos dos cursos: uno de gobernanza de IA y otro técnico de seguridad en IA. De esa colaboración salió también VIGÍA, que recibió un Special Recognition en la AI Safety Collab 2025.',
  },
  {
    eyebrow: 'Hackatón regional',
    title: 'Apart Research',
    description:
      'Partner en México del Global South AIS Hackathon: hubs en Mérida y Guadalajara, participación remota y un pipeline hacia el fellowship de Apart. 65 asistentes, 19 proyectos, uno de ellos continuó en el fellowship.',
  },
  {
    eyebrow: 'Herramientas y talleres',
    title: 'Cursor',
    description:
      'Dos colaboraciones en Mérida: el Cursor Mérida Challenge —AI Safety Edition— durante el Global South, y el workshop de AI Strategy (AGI Strategy Build Day) con la Universidad Politécnica de Yucatán.',
  },
  {
    eyebrow: 'Subvención',
    title: 'BlueDot Impact',
    description:
      'Obtuvimos una subvención de BlueDot Impact para llevar a cabo el panel «Impulsando la comunidad de AI Safety en México: Tech Policy Panel» en el marco de Mexico Tech Week.',
  },
];

const aliados = [
  { text: 'AI Safety Collab' },
  { text: 'Centro Geo' },
  { text: 'UADY' },
  { text: 'Universidad Politécnica de Yucatán' },
  { text: 'SPAR Research' },
];

const externalAttrs = { target: '_blank', rel: 'noopener noreferrer' };
---

<BaseLayout
  title="Colabora con nosotros — AI Safety Mexico"
  description="Investigación conjunta, programas educativos para instituciones y advisory. Escríbenos a contact@aismx.org para explorar formas de trabajar juntos en seguridad de IA."
  pathname={pathname}
>
  <Header slot="header" currentPath={pathname} />

  <PageHero
    title="Colabora con nosotros"
    description="Buscamos aliados estratégicos para impulsar la investigación, educación y gobernanza en seguridad de IA en México. Si tu organización comparte estos objetivos, nos encantará explorar formas de trabajar juntos."
    breadcrumb={breadcrumb}
  />

  <section class="page-section page-section--intro" aria-labelledby="intro-heading">
    <div class="container">
      <SectionHeading
        eyebrow="Quiénes colaboran con nosotros"
        title="Trabajamos con organizaciones académicas, laboratorios, gobierno y comunidades"
        description="Nuestras colaboraciones suelen materializarse en proyectos de investigación conjuntos, cursos a la medida, mesas de trabajo y producción de documentos técnicos. Si tienes una propuesta concreta, escríbenos."
        id="intro-heading"
      />
    </div>
  </section>

  <section
    id="participa"
    class="page-section page-section--vias"
    aria-labelledby="vias-heading"
  >
    <div class="container">
      <SectionHeading
        eyebrow="Formas de colaborar"
        title="Cuatro caminos, según desde dónde llegas"
        description="Si no encajas en ninguno, escríbenos igual a contact@aismx.org."
        id="vias-heading"
      />

      <ul class="collab-vias" role="list">
        {vias.map((via) => (
          <li id={via.id} class="collab-vias__item">
            <article class="collab-vias__card">
              {via.label && <span class="collab-vias__label role-label">{via.label}</span>}
              <h3 class="collab-vias__title">{via.title}</h3>
              {via.paragraphs.map((text) => (
                <p class="collab-vias__text">{text}</p>
              ))}
              <div class="program-actions">
                {via.ctas.map((cta) => (
                  <a
                    class:list={['btn', cta.variant === 'outline' ? 'btn-outline' : 'btn-primary']}
                    href={cta.href}
                    {...(cta.external ? externalAttrs : {})}
                  >
                    {cta.label}
                  </a>
                ))}
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="page-section page-section--more" aria-labelledby="more-vias-heading">
    <div class="container">
      <SectionHeading title="Otras formas de colaborar" id="more-vias-heading" />

      <ul class="collab-vias collab-vias--more" role="list">
        {otrasVias.map((via) => (
          <li id={via.id} class="collab-vias__item">
            <article class="collab-vias__card">
              <h3 class="collab-vias__title">{via.title}</h3>
              {via.paragraphs.map((text) => (
                <p class="collab-vias__text">{text}</p>
              ))}
              <div class="program-actions">
                {via.ctas.map((cta) => (
                  <a
                    class:list={['btn', cta.variant === 'outline' ? 'btn-outline' : 'btn-primary']}
                    href={cta.href}
                    {...(cta.external ? externalAttrs : {})}
                  >
                    {cta.label}
                  </a>
                ))}
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section
    id="colaboraciones"
    class="page-section page-section--allies"
    aria-labelledby="allies-heading"
  >
    <div class="container">
      <SectionHeading
        eyebrow="Colaboraciones"
        title="Con quiénes hemos construido"
        description="Cursos, eventos e investigación que no habríamos podido hacer solos. Estas son las alianzas con las que hemos construido en el último año."
        id="allies-heading"
      />
      <ul class="collab-named" role="list">
        {colaboraciones.map((item) => (
          <li class="collab-named__item">
            <article class="collab-named__card">
              <span class="collab-named__eyebrow role-label">{item.eyebrow}</span>
              <h3 class="collab-named__title">{item.title}</h3>
              <p class="collab-named__description">{item.description}</p>
            </article>
          </li>
        ))}
      </ul>
      <KeyFacts facts={aliados} />
    </div>
  </section>

  <section
    id="contacto"
    class="page-section page-section--direct"
    aria-labelledby="contacto-heading"
  >
    <div class="container">
      <SectionHeading
        eyebrow="Escríbenos"
        title="Cuéntanos sobre tu organización y tu propuesta"
        description="Escríbenos directamente por cualquiera de estos canales con una breve descripción de tu organización y la línea de trabajo que te interesa explorar. Te responderemos lo antes posible."
        id="contacto-heading"
      />

      <ul class="direct__list" role="list">
        <li class="direct__item">
          <span class="direct__label role-label">Correo electrónico</span>
          <a class="direct__value inline-link" href="mailto:contact@aismx.org">
            contact@aismx.org
          </a>
        </li>
        <li class="direct__item">
          <span class="direct__label role-label">LinkedIn</span>
          <a
            class="direct__value inline-link"
            href="https://www.linkedin.com/company/ai-safety-mexico/"
            target="_blank"
            rel="noopener noreferrer"
          >
            linkedin.com/company/ai-safety-mexico
          </a>
        </li>
        <li class="direct__item">
          <span class="direct__label role-label">Instagram</span>
          <a
            class="direct__value inline-link"
            href="https://www.instagram.com/aisafetymx/"
            target="_blank"
            rel="noopener noreferrer"
          >
            @aisafetymx
          </a>
        </li>
        <li class="direct__item">
          <span class="direct__label role-label">Calendario</span>
          <a
            class="direct__value inline-link"
            href="https://luma.com/calendar/cal-WjnM2llUGXz17t5"
            target="_blank"
            rel="noopener noreferrer"
          >
            Eventos en Luma
          </a>
        </li>
        <li class="direct__item">
          <span class="direct__label role-label">YouTube</span>
          <a
            class="direct__value inline-link"
            href="https://www.youtube.com/@AISafetyMéxico"
            target="_blank"
            rel="noopener noreferrer"
          >
            @AISafetyMéxico
          </a>
        </li>
      </ul>
    </div>
  </section>

  <CtaSection
    title="¿Tienes una propuesta concreta?"
    description="Escríbenos a contact@aismx.org con una breve descripción de tu organización y la línea de trabajo que te interesa explorar."
    ctaLabel="Escríbenos a contact@aismx.org"
    ctaHref="mailto:contact@aismx.org"
  />

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* Section shells ---------------------------------------------------------
     Her 72px rhythm (48px on phones) through --section-pad; the line-soft
     hairline under each section comes from base.css (`main > section`).
     White and bg-2 alternate: intro, #participa and #colaboraciones are
     white; «Otras formas» and #contacto are bg-2, so no two tinted bands
     touch (the CtaSection below is white, the footer bg-2). Containers are
     the global `.container`, so every left-aligned heading shares one edge. */
  .page-section {
    padding-block: var(--section-pad);
    background: var(--color-bg-section-base);
    /* Deep-link targets (#participa, #colaboraciones, #contacto) clear the
       sticky header. */
    scroll-margin-top: var(--scroll-offset);
  }

  .page-section--more,
  .page-section--direct {
    background: var(--color-bg-section-warm);
  }

  /* The intro is a heading-only band: drop the heading's 34px bottom margin
     so the band keeps an even top and bottom. */
  .page-section--intro :global(.section-heading) {
    margin-bottom: 0;
  }

  /* Path cards — her .program-card (C.9) ----------------------------------
     White, 1px hairline, 8px radius, no shadow, block flow: label → title
     → paragraphs → .program-actions. The cards hold actions but are not
     links themselves, so they have no hover border. Grid: 1 column up to
     768px, 2 from 769px (her .path-grid), 18px gap. */
  .collab-vias {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-grid);
  }

  /* Cards are deep-link targets (/programs → #training, /research →
     #research, /activities → #events; EN: /en/…). The extra 56px over the
     header offset lands a card with the card above, or its section
     description, still in view instead of sliced by the sticky header. */
  .collab-vias__item {
    display: flex;
    scroll-margin-top: calc(var(--scroll-offset) + 56px);
  }

  /* The first row of #participa (#training, and #vigia at two columns)
     sits right under the section heading: land it with the whole heading
     block (eyebrow, title, description) in view instead of slicing the
     title under the sticky header. In rem, so the room grows with the
     text size. */
  @media (max-width: 768px) {
    #participa .collab-vias__item:first-child {
      scroll-margin-top: calc(var(--scroll-offset) + 11rem);
    }
  }
  @media (min-width: 769px) {
    #participa .collab-vias__item:nth-child(-n + 2) {
      scroll-margin-top: calc(var(--scroll-offset) + 8rem);
    }
  }

  .collab-vias__card {
    width: 100%;
    padding: var(--pad-card);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    transition: border-color var(--transition);
  }

  /* The card a deep link points at (/get-involved#research, …) gets her
     featured border: clay, a non-text mark. Nothing moves. */
  .collab-vias__item:target .collab-vias__card {
    border-color: var(--color-accent-decor);
  }

  /* Card titles — her .program-card-title. */
  .collab-vias__title,
  .collab-named__title {
    margin-bottom: 10px;
    font-size: var(--fs-h5);
    font-weight: var(--fw-heading);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-heading);
    color: var(--color-text-heading);
  }

  /* Card copy — her .program-card p (ink-2, 1.7, 11px between paragraphs). */
  .collab-vias__text,
  .collab-named__description {
    margin-bottom: 11px;
    font-size: var(--fs-body);
    line-height: var(--lh-loose);
    color: var(--color-text-secondary);
  }

  .collab-vias__text:last-of-type,
  .collab-named__description:last-of-type {
    margin-bottom: 0;
  }

  /* Named collaborations — same card; the chips (KeyFacts) follow 28px
     below, like her .partners-row. */
  .collab-named {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-grid);
    margin-bottom: var(--space-7);
  }

  .collab-named__card {
    height: 100%;
    padding: var(--pad-card);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  /* Allies chips at her .partner size (40px pills, like the /research
     partner chips) instead of the smaller KeyFacts .tag; KeyFacts itself
     keeps the tag size for /about. */
  .page-section--allies :global(.key-facts__chip) {
    padding: 8px 16px;
    font-size: 0.84rem;
  }

  @media (min-width: 769px) {
    .collab-vias,
    .collab-named {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Direct-contact list — the same channel cards as /contact, on the bg-2
     band. One column; two from 769px with the email (the first, canonical
     channel) spanning the row, so the five channels leave no empty cell.
     Label: the global in-card .role-label. Value: the global .inline-link
     (clay-dark, hairline underline) at her .contact-email size; long
     handles may wrap anywhere. */
  .direct__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-grid);
  }

  .direct__item {
    padding: 22px 24px;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .direct__value {
    font-size: 1.05rem;
    overflow-wrap: anywhere;
  }

  @media (min-width: 769px) {
    .direct__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .direct__item:first-child {
      grid-column: 1 / -1;
    }
  }
</style>
