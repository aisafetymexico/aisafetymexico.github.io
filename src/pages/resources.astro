---
/*
 * /resources — Directorio abierto de recursos de seguridad en IA (ES).
 *
 * El contenido vive en ResourceDirectory.astro; esta página solo aporta el
 * chrome y los metadatos. Gemela: src/pages/en/resources.astro.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import CtaSection from '../components/CtaSection.astro';
import ResourceDirectory from '../components/ResourceDirectory.astro';
import type { Breadcrumb } from '../lib/types';

const breadcrumb: Breadcrumb = {
  items: [{ label: 'Inicio', href: '/' }, { label: 'Recursos' }],
};
---

<BaseLayout
  title="Recursos — AI Safety Mexico"
  description="Directorio abierto de cursos, programas de investigación, fellowships, financiamiento y comunidades de seguridad en IA, con enlaces verificados y una selección relevante para América Latina."
  pathname="/resources"
>
  <Header slot="header" currentPath="/resources" />

  <PageHero
    title="Recursos abiertos de seguridad en IA"
    description="Un directorio curado de cursos, programas de investigación, fellowships, fuentes de financiamiento y comunidades. Cada enlace se verifica a mano y el catálogo completo puede descargarse para reutilizarse."
    breadcrumb={breadcrumb}
  />

  <ResourceDirectory lang="es" />

  <CtaSection
    title="¿Falta algo o encontraste un enlace roto?"
    description="El directorio se mantiene a mano y depende de que la comunidad lo corrija. Cuéntanos qué recurso agregarías, sobre todo si es en español o de América Latina."
    ctaLabel="Proponer un recurso"
    ctaHref="/get-involved"
  />

  <Footer slot="footer" />
</BaseLayout>
