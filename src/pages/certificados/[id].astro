---
/**
 * /certificados/[id] — Pagina publica de verificacion de un certificado
 * individual del Global South AIS Hackathon.
 *
 * Esta es la URL canonica de verificacion: cualquiera que la abra puede
 * confirmar que el certificado fue emitido por AI Safety Mexico.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import type { Breadcrumb } from '../../lib/types';
import { certificates, getCertificate } from '../../lib/certificates';
import { ORG_NAME, EVENT_NAME } from '../../lib/linkedin';

export function getStaticPaths() {
  return certificates.map((c) => ({ params: { id: c.id } }));
}

const { id } = Astro.params;
const cert = getCertificate(id!);

if (!cert) {
  return new Response(null, { status: 404 });
}

const pathname = `/certificados/${cert.id}`;

const breadcrumb: Breadcrumb = {
  items: [
    { label: 'Inicio', href: '/' },
    { label: 'Actividades', href: '/activities' },
    { label: 'Global South AIS Hackathon', href: '/global-south-challenge' },
    { label: 'Certificados', href: '/certificados' },
    { label: cert.name },
  ],
};
---

<BaseLayout
  title={`Certificado verificado · ${cert.name} | ${ORG_NAME}`}
  description={`Certificado de ${cert.role.toLowerCase()} de ${cert.name} en ${EVENT_NAME}, verificado por ${ORG_NAME}.`}
  pathname={pathname}
>
  <Header slot="header" currentPath={pathname} navActivePath="/activities" />

  <PageHero title={cert.name} breadcrumb={breadcrumb} />

  <section class="verify-page">
    <div class="verify-page__inner">
      <div class="badge-row">
        <span class="badge">&#10003; Credencial verificada</span>
        {cert.needsReview && <span class="badge badge-warn">Revisar datos</span>}
      </div>

      <p class="subtitle">
        {cert.role} &middot; {EVENT_NAME}
        {cert.paper && <> &middot; Paper: {cert.paper}</>}
      </p>

      <div class="cert-card">
        <img class="cert-image" src={cert.image} alt={`Certificado de ${cert.name}`} />
      </div>

      <dl class="meta">
        <div>
          <dt>Issued on</dt>
          <dd>{cert.issuedOnDisplay ?? 'Por confirmar'}</dd>
        </div>
        <div>
          <dt>Emitido por</dt>
          <dd>{ORG_NAME}</dd>
        </div>
        <div>
          <dt>ID de certificado</dt>
          <dd><code>{cert.id}</code></dd>
        </div>
      </dl>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .verify-page {
    background: var(--color-bg-base);
    padding-block: var(--space-2) var(--space-5);
  }

  .verify-page__inner {
    width: 100%;
    max-width: var(--container-narrow);
    margin-inline: auto;
    padding-inline: var(--container-padding);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  @media (min-width: 480px) {
    .verify-page__inner {
      padding-inline: var(--container-padding-md);
    }
  }

  .badge-row {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(61, 242, 132, 0.13);
    color: var(--color-cta-register);
    border: 1px solid rgba(61, 242, 132, 0.35);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
  }

  .badge-warn {
    background: rgba(220, 129, 73, 0.15);
    color: var(--code-orange);
    border-color: rgba(220, 129, 73, 0.4);
  }

  .subtitle {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--fs-body);
    color: var(--color-text-secondary);
  }

  .cert-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-bg-elevated);
  }

  .cert-image {
    display: block;
    width: 100%;
    height: auto;
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
  }

  .meta dt {
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    text-transform: uppercase;
    letter-spacing: var(--ls-uppercase);
  }

  .meta dd {
    margin: 2px 0 0;
    font-family: var(--font-body);
    font-size: var(--fs-body);
    color: var(--color-text-primary);
  }

  @media (max-width: 700px) {
    .meta {
      grid-template-columns: 1fr;
    }
  }
</style>
