---
/**
 * /certificados/[id] — Pagina publica de verificacion de un certificado
 * individual del Global South AIS Hackathon.
 *
 * Esta es la URL canonica codificada en el QR de la imagen del certificado
 * y en el boton "Add to LinkedIn": cualquiera que la abra puede confirmar
 * que el certificado fue emitido por AI Safety Mexico.
 */
import QRCode from 'qrcode';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import type { Breadcrumb } from '../../lib/types';
import { certificates, getCertificate } from '../../lib/certificates';
import { buildLinkedInAddUrl, ORG_NAME, EVENT_NAME } from '../../lib/linkedin';

export function getStaticPaths() {
  return certificates.map((c) => ({ params: { id: c.id } }));
}

const { id } = Astro.params;
const cert = getCertificate(id!);

if (!cert) {
  return new Response(null, { status: 404 });
}

const pathname = `/certificados/${cert.id}`;
const verifyUrl = new URL(pathname, Astro.site).toString();

const qrDataUrl = await QRCode.toDataURL(verifyUrl, {
  margin: 1,
  width: 480,
  color: { dark: '#1E1E1C', light: '#F7F3E8' },
});

const linkedInUrl = buildLinkedInAddUrl(cert, verifyUrl);

const breadcrumb: Breadcrumb = {
  items: [
    { label: 'Inicio', href: '/' },
    { label: 'Actividades', href: '/activities' },
    { label: 'Global South AIS Hackathon', href: '/global-south-challenge' },
    { label: 'Certificados', href: '/certificados' },
    { label: cert.name },
  ],
};
---

<BaseLayout
  title={`Certificado verificado · ${cert.name} | ${ORG_NAME}`}
  description={`Certificado de ${cert.role.toLowerCase()} de ${cert.name} en ${EVENT_NAME}, verificado por ${ORG_NAME}.`}
  pathname={pathname}
>
  <Header slot="header" currentPath={pathname} navActivePath="/activities" />

  <PageHero title={cert.name} breadcrumb={breadcrumb} />

  <section
    class="verify-page"
    data-cert-id={cert.id}
    data-verify-url={verifyUrl}
    data-qr={qrDataUrl}
    data-image={cert.image}
    data-name={cert.name}
    data-issued={cert.issuedOnDisplay}
  >
    <div class="verify-page__inner">
      <div class="badge-row">
        <span class="badge">&#10003; Credencial verificada</span>
        {cert.needsReview && <span class="badge badge-warn">Revisar datos</span>}
      </div>

      <p class="subtitle">
        {cert.role} &middot; {EVENT_NAME}
        {cert.paper && <> &middot; Paper: {cert.paper}</>}
      </p>

      <div class="cert-card">
        <img class="cert-image" src={cert.image} alt={`Certificado de ${cert.name}`} />
      </div>

      <dl class="meta">
        <div>
          <dt>Issued on</dt>
          <dd>{cert.issuedOnDisplay ?? 'Por confirmar'}</dd>
        </div>
        <div>
          <dt>Emitido por</dt>
          <dd>{ORG_NAME}</dd>
        </div>
        <div>
          <dt>ID de certificado</dt>
          <dd><code>{cert.id}</code></dd>
        </div>
      </dl>

      <div class="verify-grid">
        <div class="qr-block">
          <img src={qrDataUrl} alt="Codigo QR de verificacion" width="180" height="180" />
          <p class="qr-caption">Verify at {ORG_NAME}</p>
          <p class="qr-url">{verifyUrl}</p>
        </div>

        <div class="actions">
          <a class="btn btn-linkedin" href={linkedInUrl} target="_blank" rel="noopener noreferrer">
            Add to LinkedIn
          </a>
          <button class="btn btn-outline" id="download-pdf" type="button">
            Descargar PDF
          </button>
          <p class="hint">
            Este enlace ({verifyUrl}) es la prueba de verificacion: cualquiera puede
            abrirlo para confirmar que este certificado fue emitido por {ORG_NAME}.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .verify-page {
    background: var(--color-bg-base);
    padding-block: var(--space-2) var(--space-14);
  }

  .verify-page__inner {
    width: 100%;
    max-width: var(--container-narrow);
    margin-inline: auto;
    padding-inline: var(--container-padding);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  @media (min-width: 480px) {
    .verify-page__inner {
      padding-inline: var(--container-padding-md);
    }
  }

  .badge-row {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(61, 242, 132, 0.13);
    color: var(--color-cta-register);
    border: 1px solid rgba(61, 242, 132, 0.35);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
  }

  .badge-warn {
    background: rgba(220, 129, 73, 0.15);
    color: var(--code-orange);
    border-color: rgba(220, 129, 73, 0.4);
  }

  .subtitle {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--fs-body);
    color: var(--color-text-secondary);
  }

  .cert-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-bg-elevated);
  }

  .cert-image {
    display: block;
    width: 100%;
    height: auto;
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
  }

  .meta dt {
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    text-transform: uppercase;
    letter-spacing: var(--ls-uppercase);
  }

  .meta dd {
    margin: 2px 0 0;
    font-family: var(--font-body);
    font-size: var(--fs-body);
    color: var(--color-text-primary);
  }

  .verify-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--space-6);
    align-items: start;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-6);
  }

  .qr-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    text-align: center;
  }

  .qr-block img {
    background: var(--cream-50);
    border-radius: var(--radius-sm);
    padding: 8px;
  }

  .qr-caption {
    margin: 0;
    font-family: var(--font-body);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-small);
    color: var(--color-text-primary);
  }

  .qr-url {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    word-break: break-all;
  }

  .actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-weight: var(--fw-semibold);
    text-decoration: none;
    cursor: pointer;
    border: 1px solid transparent;
    width: fit-content;
    transition: background var(--transition), color var(--transition), border-color var(--transition);
  }

  .btn-linkedin {
    background: #0a66c2;
    color: #fff;
  }

  .btn-linkedin:hover {
    background: #0958a8;
  }

  .btn-outline {
    background: transparent;
    color: var(--color-text-primary);
    border-color: var(--color-border);
  }

  .btn-outline:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .btn:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  .hint {
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--fs-small);
    max-width: 32rem;
  }

  @media (max-width: 700px) {
    .verify-grid {
      grid-template-columns: 1fr;
    }
    .meta {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { jsPDF } from 'jspdf';

  async function loadImage(src: string): Promise<HTMLImageElement> {
    return new Promise((resolve, reject) => {
      const img = new Image();
      img.crossOrigin = 'anonymous';
      img.onload = () => resolve(img);
      img.onerror = reject;
      img.src = src;
    });
  }

  const root = document.querySelector<HTMLElement>('.verify-page');
  const btn = document.getElementById('download-pdf');

  btn?.addEventListener('click', async () => {
    if (!root) return;
    const originalLabel = btn.textContent;
    btn.textContent = 'Generando...';
    (btn as HTMLButtonElement).disabled = true;

    try {
      const imageSrc = root.dataset.image!;
      const qrSrc = root.dataset.qr!;
      const name = root.dataset.name || 'Certificado';
      const issued = root.dataset.issued || '';
      const verifyUrl = root.dataset.verifyUrl || '';

      const [certImg, qrImg] = await Promise.all([loadImage(imageSrc), loadImage(qrSrc)]);

      // El diseno original es ~1754x1240px, misma proporcion que A4 horizontal.
      const pdf = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a4' });
      const pageW = pdf.internal.pageSize.getWidth();
      const pageH = pdf.internal.pageSize.getHeight();

      pdf.addImage(certImg, 'PNG', 0, 0, pageW, pageH);

      // QR + texto de verificacion, superpuestos en la esquina inferior derecha.
      const qrSize = 22;
      const margin = 8;
      const qrX = pageW - qrSize - margin;
      const qrY = pageH - qrSize - margin;

      pdf.setFillColor(243, 234, 217);
      pdf.roundedRect(qrX - 3, qrY - 3, qrSize + 6, qrSize + 10, 2, 2, 'F');
      pdf.addImage(qrImg, 'PNG', qrX, qrY, qrSize, qrSize);
      pdf.setFontSize(6);
      pdf.setTextColor(20, 22, 26);
      pdf.text('Verify at AI Safety Mexico', qrX + qrSize / 2, qrY + qrSize + 4, { align: 'center' });

      pdf.setFontSize(8);
      pdf.setTextColor(243, 234, 217);
      pdf.text(`Issued on: ${issued}`, margin, pageH - margin);
      pdf.setFontSize(6);
      pdf.setTextColor(180, 185, 195);
      pdf.text(verifyUrl, margin, pageH - margin + 3.5);

      const filename = `${name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}-certificado-aismx.pdf`;
      pdf.save(filename || 'certificado-aismx.pdf');
    } finally {
      btn.textContent = originalLabel;
      (btn as HTMLButtonElement).disabled = false;
    }
  });
</script>
