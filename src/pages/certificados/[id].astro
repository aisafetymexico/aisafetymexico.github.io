---
/**
 * /certificados/[id] — Pagina publica de verificacion de un certificado
 * individual del Global South AIS Hackathon.
 *
 * Esta es la URL canonica de verificacion: cualquiera que la abra puede
 * confirmar que el certificado fue emitido por AI Safety Mexico.
 *
 * Certificados de equipo: el título (H1 del PageHero) lista a todos los
 * integrantes, hasta 201 caracteres, así que baja al tamaño de un h2 con la
 * medida de 680px (`.verify-page--team`). Los individuales no cambian.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import type { Breadcrumb } from '../../lib/types';
import { certificates, getCertificate } from '../../lib/certificates';
import { ORG_NAME, EVENT_NAME } from '../../lib/linkedin';

export function getStaticPaths() {
  return certificates.map((c) => ({ params: { id: c.id } }));
}

const { id } = Astro.params;
const cert = getCertificate(id!);

if (!cert) {
  return new Response(null, { status: 404 });
}

const pathname = `/certificados/${cert.id}`;
const isTeam = cert.names.length > 1;

const breadcrumb: Breadcrumb = {
  items: [
    { label: 'Inicio', href: '/' },
    { label: 'Actividades', href: '/activities' },
    { label: 'Global South AIS Hackathon', href: '/global-south-challenge' },
    { label: 'Certificados', href: '/certificados' },
    { label: cert.name },
  ],
};
---

<BaseLayout
  title={`Certificado verificado · ${cert.name} | ${ORG_NAME}`}
  description={`Certificado de ${cert.role.toLowerCase()} de ${cert.name} en ${EVENT_NAME}, verificado por ${ORG_NAME}.`}
  pathname={pathname}
>
  <Header slot="header" currentPath={pathname} navActivePath="/activities" />

  <PageHero title={cert.name} breadcrumb={breadcrumb} />

  <section class:list={['verify-page', { 'verify-page--team': isTeam }]}>
    <div class="verify-page__inner">
      <div class="badge-row">
        <span class="badge"><span aria-hidden="true">&#10003;</span> Credencial verificada</span>
        {cert.needsReview && <span class="badge badge-warn">Revisar datos</span>}
      </div>

      <p class="subtitle">
        {cert.role} &middot; {EVENT_NAME}
        {cert.paper && <> &middot; Paper: {cert.paper}</>}
      </p>

      <div class="cert-card">
        <img class="cert-image" src={cert.image} alt={`Certificado de ${cert.name}`} />
      </div>

      <dl class="meta">
        <div>
          <dt>Fecha de emisión</dt>
          <dd>{cert.issuedOnDisplay ?? 'Por confirmar'}</dd>
        </div>
        <div>
          <dt>Emitido por</dt>
          <dd>{ORG_NAME}</dd>
        </div>
        <div>
          <dt>ID de certificado</dt>
          <dd><code>{cert.id}</code></dd>
        </div>
      </dl>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* Verification page: the centered PageHero names the holder; below it, a
     narrow column with the status badge, the certificate in a hairline card
     and a 3-column definition list. */
  .verify-page {
    background: var(--color-bg-base);
    padding-block: var(--section-pad);
  }

  /* Team certificates: the PageHero H1 holds every member's name (up to 201
     characters), so it drops to the h2 size on the 680px measure instead of
     a 5–7 line display title. PageHero takes no class, hence :has(). */
  :global(main:has(.verify-page--team) .page-hero__title) {
    font-size: var(--fs-h2);
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-heading);
    max-width: var(--measure-desc);
  }

  .verify-page__inner {
    width: 100%;
    max-width: var(--container-narrow);
    margin-inline: auto;
    padding-inline: var(--container-padding);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  @media (min-width: 481px) {
    .verify-page__inner {
      padding-inline: var(--container-padding-md);
    }
  }

  .badge-row {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  /* Status pill in her `.prize-badge` metrics. "Verified" is blue on
     blue-wash (5.94:1, AA), never neon green on white. */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    background: var(--color-verified-bg);
    color: var(--color-verified);
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: var(--fw-semibold);
  }

  /* "Review data": clay-dark on clay-wash with her prize-badge border. */
  .badge-warn {
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border-color: var(--color-prize-badge-border);
  }

  .subtitle {
    font-family: var(--font-body);
    font-size: var(--fs-body);
    line-height: var(--lh-relaxed);
    color: var(--color-text-secondary);
  }

  .cert-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-bg-elevated);
  }

  .cert-image {
    display: block;
    width: 100%;
    height: auto;
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
  }

  /* Eyebrow labels over ink values. */
  .meta dt {
    font-family: var(--font-body);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-label);
    letter-spacing: var(--ls-uppercase);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .meta dd {
    margin: 4px 0 0;
    font-family: var(--font-body);
    font-size: var(--fs-body);
    color: var(--color-text-primary);
  }

  .meta code {
    font-family: ui-monospace, 'SF Mono', SFMono-Regular, Menlo, monospace;
    font-size: 0.92em;
  }

  @media (max-width: 768px) {
    .meta {
      grid-template-columns: 1fr;
    }
  }
</style>
