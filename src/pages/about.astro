---
/*
 * /about — Quiénes somos
 *
 * Spec: Task #13 + docs/ARCHITECTURE.md §2 (`/about`) + docs/CONTENT-MAP.md
 * (sección 1.3 + sugerencias §4 para placeholders editoriales).
 *
 * Template: ContentPage (ARCHITECTURE.md §6).
 *
 * Estructura:
 *   1. PageHero (breadcrumb + h1 + lede, centrado)
 *   2. Misión — párrafo expandido + Callout con la frase central (el
 *      encabezado va sin descripción: 14px a la prosa, como Visión y Origen)
 *   3. Visión — párrafo + PullQuote
 *   4. Teoría del cambio (#teoria-del-cambio) — eyebrow «Estrategia» (no
 *      repite el título), lead, dos Card (North Star / Cómo llegamos) y
 *      «Cómo medimos el crecimiento». Texto de la colaboradora (fcacfc4
 *      index.html L78–110), en el orden de su sitio: Sobre nosotros →
 *      Teoría del cambio.
 *   5. Pilares — grid de 4 PillarCard con descripciones expandidas
 *   6. Historia / Origen — narrativa de fundación 2025
 *   7. KeyFacts — chips identitarios
 *   8. CtaSection — "Conoce al equipo" → /team
 *
 * Diseño ("Editorial mínimo", fcacfc4 css/style.css):
 *   - Todas las secciones usan el contenedor de 1080px, así los encabezados
 *     (alineados a la izquierda) arrancan en el mismo borde; el texto corrido
 *     se limita a 680px, la medida de su .section-description.
 *   - Ritmo: secciones blancas con filete inferior y su padding de 72px
 *     (48px en teléfonos), Datos esenciales incluida: lleva encabezado, así
 *     que no usa el padding compacto de las bandas de cifras. Solo la teoría
 *     del cambio va en bg-2 con tarjetas blancas, como su .section-theory
 *     (L523–562).
 *   - Las métricas usan su lista de filetes (.metric-list, global en
 *     base.css): rótulo en negritas y texto en ink-2, como en su sitio.
 *
 * Editor-in-chief notes (placeholders editoriales que requieren validación):
 *   - [GAP-4] Historia / Origen — narrativa de fundación basada en
 *     CONTENT-MAP §4 ("Para [GAP-4]"). Pendiente de validar nombres de
 *     personas fundadoras y momento exacto de fundación.
 *   - [GAP-5] Misión y visión formales — adaptadas de CONTENT-MAP §4.
 *   - [GAP-6] Descripción ampliada de los 4 pilares — adaptada de
 *     CONTENT-MAP §4.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Callout from '../components/Callout.astro';
import PullQuote from '../components/PullQuote.astro';
import Card from '../components/Card.astro';
import PillarCard from '../components/PillarCard.astro';
import KeyFacts from '../components/KeyFacts.astro';
import CtaSection from '../components/CtaSection.astro';

const breadcrumb = {
  items: [
    { label: 'Inicio', href: '/' },
    { label: 'Sobre nosotros' },
  ],
};

// Teoría del cambio — «Cómo medimos el crecimiento» (fcacfc4 index.html
// L101–107). `label` is her bold lead-in; the period is added in the markup.
const metrics = [
  {
    label: 'Postulaciones contrafactuales',
    value:
      'Mexicanos que le dan a «enviar» en SPAR, Apart, MATS o en vacantes de Estados Unidos y China. La mayoría será rechazada, por diseño; lo que cuenta es que apliquen.',
  },
  {
    label: 'Autopropulsión y retención',
    value: 'Cuántos continúan más allá de las primeras veinte horas acompañadas.',
  },
  {
    label: 'Producción de investigación',
    value: 'Experimentos y artículos publicados, y equipos aceptados en SPAR.',
  },
  {
    label: 'Financiamiento y pista de despegue',
    value: 'Recursos levantados a lo largo de la escalera de fondeo.',
  },
  {
    label: 'Credibilidad y visibilidad',
    value:
      'Academia y tomadores de decisiones en el circuito, y solicitudes de consulta del gobierno.',
  },
];

const pillars = [
  {
    number: '01',
    title: 'Investigación',
    description:
      'Producimos trabajo original y colaborativo en alineación, interpretabilidad mecánica y gobernanza técnica, en colaboración con instituciones nacionales e internacionales.',
  },
  {
    number: '02',
    title: 'Educación',
    description:
      'Diseñamos e impartimos cursos abiertos y a la medida —para comunidades, universidades y centros de investigación— que adaptan los marcos contemporáneos de AI safety al contexto mexicano.',
  },
  {
    number: '03',
    title: 'Gobernanza',
    description:
      'Producimos análisis técnicos, participamos en mesas de trabajo y publicamos documentos especializados que aportan insumos a procesos de consulta y diseño de políticas públicas sobre IA en México.',
  },
  {
    number: '04',
    title: 'Comunidad',
    description:
      'Sostenemos espacios recurrentes de diálogo —mesas de trabajo, talleres, conferencias— que conectan a quienes investigan, desarrollan y regulan IA en México.',
  },
];

const keyFacts = [
  { text: 'Fundada en 2025' },
  { text: 'Sin fines de lucro' },
  { text: 'Equipo multidisciplinario' },
  { text: 'Base México' },
];
---

<BaseLayout
  title="Quiénes somos · AI Safety Mexico"
  description="AI Safety Mexico es una organización sin fines de lucro fundada en 2025 que promueve la investigación, educación y gobernanza responsable de la inteligencia artificial en México."
  pathname="/about"
>
  <Header slot="header" currentPath="/about" />

  <PageHero
    title="Quiénes somos"
    description="Una organización sin fines de lucro que articula investigación, educación y gobernanza de IA desde México."
    breadcrumb={breadcrumb}
  />

  <!-- 2. Misión -->
  <section class="section section--base">
    <div class="container">
      <SectionHeading
        eyebrow="Misión"
        title="Por qué existimos"
      />

      <div class="prose">
        <p>
          AI Safety Mexico es una organización sin fines de lucro fundada en
          2025 que promueve la investigación, la educación y la gobernanza
          responsable de la inteligencia artificial en México. Trabajamos en
          la intersección de tres comunidades
          —investigadoras y investigadores, educadores y responsables de
          política pública— para asegurar que los sistemas de IA se
          desarrollen y desplieguen de forma segura, alineada con valores
          humanos y sensible al contexto mexicano.
        </p>
        <p>
          Nuestra labor combina investigación abierta, formación situada y
          trabajo con instituciones aliadas. Operamos con un equipo
          multidisciplinario y en alianza con organizaciones nacionales e
          internacionales que comparten el compromiso de hacer del sur global
          un actor con voz propia en la conversación sobre seguridad de la IA.
        </p>

        <Callout tone="highlight">
          <p>
            <strong>Misión.</strong> Promover la investigación, la educación y la
            gobernanza responsable de la inteligencia artificial en México,
            asegurando que los sistemas de IA se desarrollen y desplieguen de
            forma segura, alineada con valores humanos y sensible al contexto
            mexicano.
          </p>
        </Callout>
      </div>
    </div>
  </section>

  <!-- 3. Visión -->
  <section class="section section--base">
    <div class="container">
      <SectionHeading
        eyebrow="Visión"
        title="Hacia dónde apuntamos"
      />

      <div class="prose">
        <p>
          Imaginamos un México donde la voz del sur global tenga peso propio
          en la definición técnica y normativa de la seguridad de la IA. Una
          comunidad consolidada de investigadoras, educadoras y responsables
          políticos que produzcan conocimiento situado, formen a nuevas
          generaciones y participen activamente en la construcción de marcos
          regulatorios sensibles a las realidades mexicanas.
        </p>

        <PullQuote
          quote="Un México en el que la voz del sur global tenga peso propio en la definición técnica y normativa de la seguridad de la IA."
          attribution="Visión · AI Safety Mexico"
        />
      </div>
    </div>
  </section>

  <!-- 4. Teoría del cambio -->
  <section
    id="teoria-del-cambio"
    class="section section--warm theory"
    aria-labelledby="teoria-heading"
  >
    <div class="container">
      <SectionHeading
        id="teoria-heading"
        eyebrow="Estrategia"
        title="Nuestra teoría del cambio"
      />

      <p class="theory-lead">
        No estamos construyendo una comunidad para «unirse». Estamos
        construyendo una plataforma de despegue hacia la frontera de la
        seguridad en IA y la voz creíble de investigación de México: un puñado
        de mexicanos de alta agencia persiguiendo la frontera, un cuerpo
        citable de investigación y un puente en español hacia quienes
        decidirán cómo México enfrenta la IA avanzada.
      </p>

      <div class="theory-grid">
        <Card
          bordered
          interactive={false}
          elevated={false}
          padding="md"
          badge="North Star"
          title="Ambición"
        >
          <p>
            Sembrar en México un cuerpo de trabajo que produzca investigación
            propia en áreas clave de seguridad en IA. Nuestra referencia son los
            AI Safety Institutes.
          </p>
          <p>
            De ahí se siguen dos efectos: funcionar como capa de traducción al
            español de la IA de frontera, y como una voz creíble y no partidista
            a la que un tomador de decisiones mexicano pueda llamar.
          </p>
          <p>
            Ese es el norte de largo plazo; todo lo que hacemos hoy construye
            hacia allá.
          </p>
        </Card>

        <Card
          bordered
          interactive={false}
          elevated={false}
          padding="md"
          badge="Cómo llegamos"
          title="Política guía"
        >
          <p>
            Lograr que un número pequeño de personas de alta agencia se
            autopropulsen hacia la frontera, producir un cuerpo de investigación
            citable y traducirlo para tomadores de decisiones mexicanos y para el
            mundo hispanohablante.
          </p>
          <p>
            Todo apoyándonos en infraestructura que ya existe (Apart, SPAR,
            BlueDot, Atlas, instituciones académicas en México) en lugar de
            construir la nuestra desde cero.
          </p>
        </Card>
      </div>

      <h3 class="theory-subheading">Cómo medimos el crecimiento</h3>
      <ul class="metric-list" role="list">
        {metrics.map((metric) => (
          <li><strong>{metric.label}.</strong> {metric.value}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5. Pilares profundizados -->
  <section class="section section--base">
    <div class="container">
      <SectionHeading
        eyebrow="Cuatro ejes"
        title="Nuestros pilares de trabajo"
        description="Las áreas en las que concentramos esfuerzos. No son compartimentos estancos: cada proyecto suele cruzar varias de ellas."
      />

      <div class="pillar-grid">
        {pillars.map((pillar) => (
          <PillarCard
            number={pillar.number}
            title={pillar.title}
            description={pillar.description}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Historia / Origen -->
  <section class="section section--base">
    <div class="container">
      <SectionHeading
        eyebrow="Origen"
        title="Cómo nació AI Safety Mexico"
      />

      <div class="prose">
        <p>
          AI Safety Mexico nace en 2025 como respuesta a una observación
          compartida por un grupo de investigadoras, ingenieros y
          profesionales en México: el debate sobre la seguridad de la
          inteligencia artificial avanza a una velocidad acelerada en el
          norte global, mientras que las preocupaciones, valores y contextos
          del sur global rara vez se incorporan en esa conversación.
        </p>
        <p>
          Decidimos articularnos para acortar esa distancia desde un país
          concreto —México— y desde una práctica concreta: investigación
          rigurosa, formación abierta y producción de insumos técnicos que
          apoyen la toma de decisiones informadas sobre IA. La organización se constituyó
          formalmente en 2025 con un equipo fundador multidisciplinario que
          combina experiencia en machine learning, ciencias sociales,
          políticas públicas y matemáticas aplicadas.
        </p>
        <p>
          Desde entonces hemos impartido cursos abiertos e institucionales,
          publicado en venues nacionales, participado en eventos
          internacionales (EAGxCDMX, ML4Good, SPAR) y acompañado a
          organizaciones aliadas como Centro Geo, UADY, ENAIS y Apart
          Research. Cada actividad responde al mismo principio: producir
          conocimiento situado y útil para quienes investigan, regulan o
          despliegan IA en México.
        </p>
      </div>
    </div>
  </section>

  <!-- 7. KeyFacts -->
  <section class="section section--base">
    <div class="container">
      <SectionHeading
        eyebrow="Identidad"
        title="Datos esenciales"
        description="Lo mínimo que conviene saber sobre nosotros antes de explorar el resto del sitio."
      />

      <KeyFacts facts={keyFacts} />
    </div>
  </section>

  <!-- 8. CTA -->
  <CtaSection
    title="¿Quieres conocer al equipo?"
    description="Detrás de AI Safety Mexico hay un grupo multidisciplinario de investigadoras, ingenieros y educadores comprometidos con la seguridad de la IA en México."
    ctaLabel="Conoce al equipo"
    ctaHref="/team"
  />

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* Narrative blocks (Misión, Visión, Origen). Left-aligned under the
     section heading and capped at her running-text measure (680px, her
     .section-description); the Callout / PullQuote inside share it and
     carry their own outer spacing. Copy is ink-2 at 1.7 with 11px between
     paragraphs, as in her content cards. */
  .prose {
    max-width: var(--measure-desc);
  }

  .prose > p {
    line-height: var(--lh-loose);
    color: var(--color-text-secondary);
    margin: 0;
    text-wrap: pretty;
  }

  .prose > p + p {
    margin-top: 11px;
  }

  /* Teoría del cambio — her .section-theory internals (fcacfc4 L523–562):
     h2 → lead (ink, 1.1rem, max 780px) → two white cards on bg-2 (grid
     margin 44px) → subheading (mb 4px) → hairline .metric-list. The card
     copy is the Card's own default-slot paragraph style (her
     .program-card p: ink-2, 1.7). */
  .theory {
    scroll-margin-top: var(--scroll-offset);
  }

  .theory-lead {
    font-size: 1.02rem;
    line-height: var(--lh-relaxed);
    color: var(--color-text-primary);
    max-width: var(--measure-lead);
    margin: 0 0 32px;
    text-wrap: pretty;
  }

  .theory-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-grid);
    margin-bottom: 44px;
  }

  /* Her .theory-subheading: 1rem / 550 / -.01em; the line-height is the
     body's 1.65 (VF-3). */
  .theory-subheading {
    font-size: var(--fs-h6);
    font-weight: var(--fw-heading);
    line-height: var(--lh-relaxed);
    letter-spacing: -0.01em;
    color: var(--color-text-heading);
    margin: 0 0 4px;
  }

  /* Pillar grid: her 2-up card grid (theory, paths, collaborations): one
     column up to 768px, two from 769px, 18px gaps. Two-up keeps the pillar
     copy at a readable measure (a 4-up row left ~25 characters a line). */
  .pillar-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-grid);
  }

  @media (min-width: 769px) {
    .theory-lead {
      font-size: 1.1rem;
    }

    .theory-grid,
    .pillar-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
