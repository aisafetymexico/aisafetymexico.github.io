---
/**
 * /blog — Índice del blog.
 *
 * Entradas de formato largo: documentos de trabajo, ensayos y notas de
 * investigación que no son publicaciones arbitradas (esas viven en
 * /research, colección `publications`).
 *
 * El listado es una constante local por ahora. Cuando haya media docena de
 * entradas conviene migrarlo a una colección `posts` en src/content/.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';

const pathname = '/blog';

const breadcrumb = {
  items: [
    { label: 'Inicio', href: '/' },
    { label: 'Blog' },
  ],
};

const posts = [
  {
    title: 'VIGIA: un pipeline para acelerar la Gobernanza de la IA en México',
    href: '/blog/vigia-gobernanza-ia-mexico',
    authors: 'Pilar Moncada y Max Pinelo',
    kind: 'Documento de trabajo',
    summary:
      'Sostenemos que el principal problema para acelerar la Gobernanza de la IA en naciones como México es el vocabulario de seguridad de la IA casi inexistente en el país. Proponemos un pipeline para visibilizar los riesgos y presentamos su primera implementación sobre el Diario Oficial de la Federación.',
    topics: ['Gobernanza', 'México', 'VIGIA'],
  },
];
---

<BaseLayout
  title="Blog · AI Safety Mexico"
  description="Documentos de trabajo, ensayos y notas de investigación de AI Safety Mexico sobre seguridad y gobernanza de la inteligencia artificial."
  pathname={pathname}
>
  <Header slot="header" currentPath={pathname} />

  <PageHero
    title="Blog"
    description="Documentos de trabajo, ensayos y notas de investigación. Las publicaciones arbitradas viven en Investigación."
    breadcrumb={breadcrumb}
  />

  <section class="blog-section">
    <div class="blog-section__inner">
      <ul class="post-list" role="list">
        {posts.map((post) => (
          <li class="post-card">
            <p class="post-card__kind role-label">{post.kind}</p>
            <h2 class="post-card__title">
              <a class="post-card__link" href={post.href}>{post.title}</a>
            </h2>
            <p class="post-card__meta">{post.authors}</p>
            <p class="post-card__summary">{post.summary}</p>
            <ul class="post-card__topics" role="list">
              {post.topics.map((topic) => (
                <li class="post-card__topic tag">{topic}</li>
              ))}
            </ul>
            <a class="post-card__cta section-link" href={post.href}>Leer la entrada</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* One column of her `.program-card` within the 800px measure. The category
     label, the topic pills and the quiet "read" link
     are the global `.role-label`, `.tag` and `.section-link`. */
  .blog-section {
    padding-block: var(--section-pad);
  }

  .blog-section__inner {
    width: 100%;
    max-width: var(--container-narrow);
    margin-inline: auto;
    padding-inline: var(--container-padding);
  }

  @media (min-width: 481px) {
    .blog-section__inner {
      padding-inline: var(--container-padding-md);
    }
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap-grid);
  }

  /* White card with a hairline. The card itself is not a link, so it has
     no hover state; the title link and the "read" link carry it. */
  .post-card {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--pad-card);
  }

  /* Category label: `.role-label` in clay-dark (her `.resource-type`). */
  .post-card__kind {
    color: var(--color-accent);
  }

  .post-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: var(--fw-heading);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-heading);
    color: var(--color-text-heading);
    text-wrap: balance;
    margin: 0 0 var(--space-2);
  }

  .post-card__link { color: inherit; text-decoration: none; }
  .post-card__link:hover { color: var(--color-link-hover); }

  .post-card__meta {
    font-size: var(--fs-small);
    line-height: var(--lh-normal);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-4);
  }

  .post-card__summary {
    font-size: var(--fs-body);
    line-height: var(--lh-loose);
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-5);
    text-wrap: pretty;
  }

  .post-card__topics {
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* Decorative arrow. The second declaration gives it empty alt text where
     supported; the first is the fallback. */
  .post-card__cta::after {
    content: '\2192';
    content: '\2192' / '';
    margin-left: 6px;
  }
</style>
