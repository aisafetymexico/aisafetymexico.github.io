---
/**
 * `/` — Home (Gateway curado).
 *
 * Spec: docs/ARCHITECTURE.md §2 (Home), Task #12.
 * Design: her "Editorial mínimo" home (fcacfc4 index.html + css/style.css):
 *         white page, 1px hairlines between sections, left-aligned section
 *         headings, and a bg-2 tint every few sections — never two tinted
 *         bands in a row (the footer below the CTA band is bg-2).
 *
 * Deliberate restraint: this page is a curated gateway — NOT a long-scroll
 * synthesis of every section. Each block sends visitors to a deeper page.
 *
 * Sections:
 *   1. Hero — centered h1 with a muted trailing phrase, subtitle, 3 pill
 *      CTAs, scroll hint, then the full-bleed El Caracol halftone band.
 *   2. Próximo evento — upcoming-event spotlight (AI x Epistemics Research
 *      Sprint, AI Safety Mexico's in-person Mérida site): one full-width
 *      Card that is not a link, with two pill actions (request a spot on
 *      Luma; sprint details on /ai-x-epistemics), on bg-2 (her
 *      `.section-current`). EXPIRES 2026-11-12 and 2026-11-15 (see
 *      `upcomingSpotlight`).
 *   3. Featured pillars — FeatureGrid (4 entries: Investigación, Programas,
 *      Proyectos, Equipo).
 *   4. StatBar — 4 impact stats between hairlines.
 *   4b. Feature photo — a working session (her `.section-photo`).
 *   4c. Equipo — the core team at a glance (photo, name, role; shared list
 *       in src/lib/team.ts) and a pill to /team.
 *   5. Trabajo reciente — 3 curated whole-card links (proyecto insignia,
 *      publicación, GSH) on bg-2. Each ends in a visible action pill (Card
 *      `linkLabel`, her `.event-preview-link`), so touch screens get a cue
 *      at rest, not only the hover border.
 *   5b. Recursos abiertos — ResourcesTeaser (directory figures + 2 CTAs).
 *   6. CtaSection — white closing band, single CTA → /get-involved.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import StatBar from '../components/StatBar.astro';
import Card from '../components/Card.astro';
import ResourcesTeaser from '../components/ResourcesTeaser.astro';
import CtaSection from '../components/CtaSection.astro';
import { coreTeam } from '../lib/team';

// «AI\u00A0safety» is bound with a no-break space so the balanced tile copy
// never ends a line on «AI» (FeatureGrid balances its descriptions).
const pillars = [
  {
    title: 'Investigación',
    description:
      'Trabajo original y colaborativo en alineación, interpretabilidad y gobernanza técnica.',
    href: '/research',
  },
  {
    title: 'Programas',
    description:
      'Cursos abiertos y a la medida que adaptan los marcos contemporáneos de AI\u00A0safety al contexto mexicano.',
    href: '/programs',
  },
  {
    title: 'Proyectos',
    description:
      'Iniciativas aplicadas como VIGÍA y AI\u00A0Safety Connect: abiertas, auditables y orientadas a producir conocimiento utilizable.',
    href: '/projects',
  },
  {
    title: 'Equipo',
    description:
      'Investigadoras, ingenieros y profesionales multidisciplinarios articulados desde México.',
    href: '/team',
  },
];

const stats = [
  { number: '6+', label: 'Cursos impartidos' },
  { number: '30+', label: 'Participantes formados' },
  { number: '1', label: 'Publicación revisada por pares' },
  { number: '8', label: 'Personas en el equipo' },
];

// -------- Próximo evento (sección 2) --------
// Teaser of the dedicated page /ai-x-epistemics (tracks, prizes, agenda and
// the two-step application: Apart's sign-up and the Cursor Hackathon's Luma
// form). Like the Mexico Tech Week card before it, it is not a link: two
// visible pills open the application (#registro) or the sprint page; no
// pill leads to a form elsewhere, so there is one way to apply. The
// SectionHeading names the sprint; the card is about
// AI Safety Mexico's in-person Mérida site, with the dates as its in-card
// label. «AI\u00A0Safety» is bound with a no-break space, as elsewhere, and
// the dates take a word joiner (\u2060) after the en dash, so the range never
// breaks as «13– / 15».
// EXPIRES 2026-11-12: AISMx's internal deadline for in-person requests.
// From the 13th, drop the «Aplica en dos pasos» pill (let «Detalles del
// sprint» lead as `btn-register`, so the card keeps one filled action) and
// rewrite the last sentence (in-person requests have closed), here and on
// /en.
// EXPIRES 2026-11-15: after the sprint, swap this spotlight for the next
// event (or remove the section if there is none yet) and move the sprint to
// past activities on /activities (here and on /en).
const upcomingSpotlight = {
  title: 'Sede presencial en Mérida',
  date: '13–\u206015 de noviembre de 2026',
  description:
    'AI\u00A0Safety Mexico organiza la sede de Mérida, del viernes 13 al domingo 15. Es gratuita y no necesitas experiencia previa ni equipo. Cupo limitado: aplica hasta el 12 de noviembre.',
  link: '/ai-x-epistemics#registro',
};
---

<BaseLayout
  title="AI Safety Mexico — Investigación, educación y gobernanza de IA"
  description="Organización mexicana sin fines de lucro dedicada a la investigación, educación y gobernanza responsable de la IA en México."
  pathname="/"
  ogImage="/images/observatorio.png"
>
  <Header slot="header" currentPath="/" />

  <Hero
    title="Seguridad y gobernanza de la IA, desde México."
    titleAccent="desde México"
    subtitle="Investigamos, formamos y construimos comunidad alrededor de la seguridad de la inteligencia artificial. Construimos las bases técnicas y de gobernanza necesarias para que México tome decisiones informadas sobre IA."
    ctas={[
      { label: 'Cómo participar', href: '/get-involved#participa' },
      { label: 'Ver recursos', href: '/resources', variant: 'outline' },
      { label: 'Nuestros programas', href: '/programs', variant: 'outline' },
    ]}
    scrollHint="Desplázate para explorar ↓"
  />

  <!-- 2 · Próximo evento (spotlight; bg-2 like her .section-current) -->
  <section class="section section--warm" aria-labelledby="home-spotlight">
    <div class="container">
      <SectionHeading
        eyebrow="Próximo evento"
        title="AI x Epistemics Research Sprint"
        description="Un sprint de investigación de Apart Research sobre cómo la IA cambia la forma en que decidimos qué creer, en línea o en una sede presencial."
        id="home-spotlight"
      />
      <div class="home-spotlight">
        <Card
          badge={upcomingSpotlight.date}
          title={upcomingSpotlight.title}
          description={upcomingSpotlight.description}
          padding="md"
        >
          <div class="program-actions">
            <a class="btn btn-register" href={upcomingSpotlight.link}>
              Aplica en dos pasos
            </a>
            <a class="btn btn-outline" href="/ai-x-epistemics">
              Detalles del sprint
            </a>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- 3 · Featured pillars (gateway de 4) -->
  <section class="section section--base">
    <div class="container">
      <SectionHeading
        eyebrow="Qué hacemos"
        title="Cuatro frentes, una sola misión"
        description="Cada pilar enlaza a la página dedicada con detalles, materiales y formas de colaborar."
      />
      <FeatureGrid items={pillars} />
    </div>
  </section>

  <!-- 4 · Stat bar -->
  <StatBar stats={stats} />

  <!-- 4b · Foto de una sesión de trabajo (her .section-photo) -->
  <section class="section section--base">
    <div class="container">
      <img
        class="home-photo"
        src="/images/sesion-trabajo.webp"
        width="2048"
        height="1432"
        loading="lazy"
        decoding="async"
        alt="Participantes de AI Safety Mexico en una sesión de trabajo en círculo"
      />
    </div>
  </section>

  <!-- 4c · Equipo: el equipo principal, con foto, nombre y rol -->
  <section class="section section--base" aria-labelledby="home-team-heading">
    <div class="container">
      <SectionHeading
        eyebrow="Equipo"
        title="Las personas detrás de AI Safety Mexico"
        id="home-team-heading"
      />
      <ul class="home-team" role="list">
        {coreTeam.map((member) => (
          <li class="home-team__person">
            <img
              class="home-team__photo"
              src={typeof member.photo.src === 'string' ? member.photo.src : member.photo.src.src}
              alt=""
              width="88"
              height="88"
              loading="lazy"
              decoding="async"
            />
            <span class="home-team__name">{member.name}</span>
            <span class="home-team__role">{member.role}</span>
          </li>
        ))}
      </ul>
      <div class="program-actions home-team__actions">
        <a class="btn btn-outline" href="/team">Conoce al equipo</a>
      </div>
    </div>
  </section>

  <!-- 5 · Trabajo reciente: proyecto, publicación y evento (bg-2) -->
  <section class="section section--warm">
    <div class="container">
      <SectionHeading
        eyebrow="Destacados"
        title="Trabajo reciente"
        description="Un proyecto, una publicación y un evento para asomarse al pulso de la organización."
      />

      {/* The paper keeps its official English title, marked lang="en" through
          Card's `titleLang`. The \u00A0 no-break spaces keep each « · » unit
          and the title's «A Pilot» on one line. Each card links straight to
          its item; the paper's goes to the papers section of /research
          (#publicaciones). */}
      <div class="home-highlights">
        <Card
          href="/projects/vigia"
          badge="Proyecto insignia"
          title="VIGÍA"
          description="Un pipeline para hacer visibles los riesgos de la IA en el discurso oficial de México, a partir del Diario Oficial de la Federación."
          linkLabel="Ver el proyecto"
          padding="md"
          bordered
        />
        <Card
          href="/research#publicaciones"
          badge="Publicación"
          title={'AI Safety in Mexico: A\u00A0Pilot Survey in Yucatan'}
          titleLang="en"
          description={'Estudio piloto sobre percepciones, riesgos y prácticas locales en torno a la IA, publicado en RCS\u00A0·\u00A0IPN.'}
          linkLabel="Ver la publicación"
          padding="md"
          bordered
        />
        <Card
          href="/activities#gsh-2026"
          badge="Hackatón · Junio 2026"
          title="Global South AIS Hackathon"
          description="Sedes de Mérida y Guadalajara con Apart Research: 65 asistentes, 19 proyectos y uno que continuó en el fellowship de Apart."
          linkLabel="Ver el hackatón"
          padding="md"
          bordered
        />
      </div>
    </div>
  </section>

  <!-- 5b · Recursos abiertos (teaser del directorio) -->
  <ResourcesTeaser />

  <!-- 6 · CTA closing band -->
  <CtaSection
    title="¿Buscas colaborar?"
    description="Investigadores, instituciones y aliados: hay múltiples vías para sumarse al trabajo de AI Safety Mexico."
    ctaLabel="Conoce las vías de colaboración"
    ctaHref="/get-involved"
  />

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* Upcoming-event spotlight: one Card at full container width, like her
     `.section-current` card under a left-aligned heading. Card already puts
     the pill row 18px under the copy, and base.css stacks the pills full
     width at ≤480px. The copy keeps her 680px description measure instead
     of running the full card width, and `pretty` keeps a lone word off its
     last line on phones. */
  .home-spotlight :global(.card__description) {
    max-width: var(--measure-desc);
    text-wrap: pretty;
  }

  /* «Trabajo reciente» copy: `pretty`, with the no-break spaces in the
     strings, keeps a lone word («IPN.», «2025.», «Apart.») off the last
     line, right above each card's action pill. */
  .home-highlights :global(.card__description) {
    text-wrap: pretty;
    /* Last resort: if a bound unit is still wider than its column, break it
       there instead of letting the card's overflow:hidden clip it (WCAG
       1.4.4). */
    overflow-wrap: break-word;
  }

  /* Feature photo — her .feature-photo: full container width, large radius,
     hairline frame. */
  .home-photo {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  /* Team — the core team at a glance, left-aligned like her team cards:
     an 88px round photo (hairline, bg-3 while loading), the name, the role
     in muted type. Two per row on phones, four from 481px and all seven in
     one row from 64.0625em (1025px at the default size). The photo is
     decorative: the name sits right under it. */
  .home-team {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px var(--gap-grid);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-team__person {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .home-team__photo {
    display: block;
    width: 88px;
    height: 88px;
    margin-bottom: 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-bg-muted);
    object-fit: cover;
  }

  .home-team__name {
    font-family: var(--font-display);
    font-size: var(--fs-h6);
    font-weight: var(--fw-heading);
    line-height: var(--lh-heading);
    color: var(--color-text-heading);
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .home-team__role {
    margin-top: 4px;
    font-size: var(--fs-small);
    line-height: var(--lh-normal);
    color: var(--color-text-muted);
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .home-team__actions {
    margin-top: var(--space-9);
  }

  @media (min-width: 481px) {
    .home-team {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 64.0625em) {
    .home-team {
      grid-template-columns: repeat(7, minmax(0, 1fr));
    }
  }

  /* Highlights grid — 3 curated cards (project, publication, GSH): one
     column up to 768px, three from 48.0625em (769px at the default 16px,
     her tier), 18px gaps. Grid stretch keeps the three cards the same
     height, so the action pills Card pins to the bottom share one
     baseline. */
  .home-highlights {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gap-grid);
  }

  /* em, not px: like FeatureGrid, the 3-up row waits for room when the
     reader enlarges the default font, so the bound « · » units never break
     mid-word; 769px at the default 16px. */
  @media (min-width: 48.0625em) {
    .home-highlights {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
